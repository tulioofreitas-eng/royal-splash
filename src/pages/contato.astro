---
import SiteHeader from "../components/site/SiteHeader.astro"; import SiteLayout from "../layouts/SiteLayout.astro"; import "../styles/complete-experience.css";
const channels=[{n:"01",name:"WhatsApp",note:"Conversa direta com a equipe",href:"https://wa.me/5521982590643",channel:"whatsapp",external:true},{n:"02",name:"Telefone",note:"(21) 98259-0643",href:"tel:+5521982590643",channel:"phone"},{n:"03",name:"E-mail",note:"contato@royalsplash.com.br",href:"mailto:contato@royalsplash.com.br",channel:"email"},{n:"04",name:"Instagram",note:"@royalsplashoficial",href:"https://instagram.com/royalsplashoficial",channel:"instagram",external:true}];
---
<SiteLayout title="Contato — Royal Splash" robots="noindex, nofollow" bodyClass="site-primitive-page experience-page experience-dark" visualMode="brand"><SiteHeader slot="header" visualMode="brand" />
  <section class="experience-entry" aria-labelledby="contact-heading"><p class="experience-kicker">Contato</p><h1 id="contact-heading">Todos os canais diretos da Royal Splash.</h1><p class="experience-lead">Use o WhatsApp para uma conversa imediata ou escolha o canal que funciona melhor para você.</p></section>
  <section class="contact-prepare" aria-labelledby="prepare-contact-heading"><p class="experience-kicker">Antes de conversar?</p><h2 id="prepare-contact-heading">Prepare o contexto do projeto.</h2><p>O formulário organiza tipo, escala, prazo e questão principal antes de abrir o WhatsApp. Ele é opcional.</p><a class="site-primitive-action site-primitive-action--primary" href="/inicie-seu-projeto">Ir para Inicie seu Projeto</a></section>
  <section class="contact-channels" aria-labelledby="channels-heading"><h2 id="channels-heading">Canais diretos</h2>{channels.map(item => <a href={item.href} target={item.external?"_blank":undefined} rel={item.external?"noopener noreferrer":undefined} aria-label={`${item.name}: ${item.note}${item.external?" (abre em nova janela)":""}`} data-analytics-cta data-analytics-component={`contact_${item.channel}`} data-analytics-subject="initial_contact" data-analytics-channel={item.channel}><span>{item.n}</span><strong>{item.name}</strong><small>{item.note}</small><b aria-hidden="true">{item.external?"↗":"→"}</b></a>)}</section>
  <aside class="contact-privacy"><p>Você escolhe o canal e fala diretamente com a Royal Splash.</p><a href="/politica-de-privacidade">Política de Privacidade</a></aside>
</SiteLayout>
<style>.contact-channels,.contact-prepare,.contact-privacy{width:min(100% - 2 * var(--site-layout-gutter),var(--site-layout-content-max));margin:auto}.experience-entry{padding-bottom:clamp(2rem,4vw,3rem)}.experience-entry h1,.contact-channels h2,.contact-prepare h2{color:#fff}.contact-prepare{padding:clamp(2.5rem,5vw,4rem) 0;border-top:1px solid rgba(255,255,255,.2)}.contact-channels{padding:clamp(2.5rem,5vw,4rem) 0 clamp(3rem,6vw,5rem);border-top:1px solid rgba(255,255,255,.2)}.contact-channels h2,.contact-prepare h2{margin:0 0 1.5rem;font:500 clamp(2.3rem,5vw,4rem) var(--site-font-display)}.contact-channels>a{display:grid;grid-template-columns:3rem 1fr auto;gap:.5rem 1rem;align-items:center;padding:1.5rem 0;border-top:1px solid rgba(255,255,255,.2);color:#fff;text-decoration:none}.contact-channels>a:last-child{border-bottom:1px solid rgba(255,255,255,.2)}.contact-channels>a:first-of-type{color:#d9b746}.contact-channels span{grid-row:1/3;color:rgba(255,255,255,.6);font:600 .7rem var(--site-font-ui)}.contact-channels strong{font:500 clamp(1.5rem,3vw,2.2rem) var(--site-font-display)}.contact-channels small{grid-column:2;color:rgba(255,255,255,.72)}.contact-channels b{grid-column:3;grid-row:1/3;font-size:1.4rem}.contact-channels>a:focus-visible{outline:3px solid #d9b746;outline-offset:5px}.contact-prepare p:not(.experience-kicker){max-width:38rem;color:rgba(255,255,255,.72)}.contact-privacy{padding:2rem 0 5rem;border-top:1px solid rgba(255,255,255,.2)}.contact-privacy a{color:#fff}</style>
