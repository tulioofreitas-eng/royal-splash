---
import SiteHeader from "../components/site/SiteHeader.astro";
import {
  royalCases,
  royalEvidence,
} from "../content/royal/cases.ts";
import {
  royalCaseDetails,
} from "../content/royal/case-details.ts";
import {
  selectRoyalPublicCaseDetails,
} from "../content/royal/case-detail.ts";
import SiteLayout from "../layouts/SiteLayout.astro";

const publicCaseDetails =
  selectRoyalPublicCaseDetails({
    cases: royalCases,
    evidence: royalEvidence,
    details: royalCaseDetails,
  });

const publicCases =
  publicCaseDetails.map(
    ({ siteCase }) =>
      siteCase,
  );
---

<SiteLayout
  title="Projetos — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-projects site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="projects-section projects-entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="projects-heading"
    data-projects-stage="entry"
  >
    <p class="projects-eyebrow site-primitive-eyebrow site-primitive-supporting">
      Projetos
    </p>

    <h1
      id="projects-heading"
      class="site-primitive-page-title site-primitive-reading"
    >
      Projetos
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Esta área reúne somente Cases e evidências
      que estejam aptos à publicação dentro do
      fluxo controlado da Royal Splash.
    </p>

    <div class="projects-actions site-primitive-actions">
      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/metodo-royal"
      >
        Conhecer Método Royal
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/sobre"
      >
        Conhecer A Royal
      </a>
    </div>
  </section>

  <section
    class="projects-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="projects-library-heading"
    data-projects-stage="library"
    data-projects-count={publicCases.length}
  >
    <h2
      id="projects-library-heading"
      class="site-primitive-section-title"
    >
      Projetos disponíveis
    </h2>

    {
      publicCases.length === 0 ? (
        <div
          class="projects-empty site-primitive-surface--muted site-primitive-datum-top"
          data-projects-state="empty"
        >
          <h3 class="site-primitive-subtitle">
            Nenhum projeto verificado disponível
            nesta superfície
          </h3>

          <p class="site-primitive-body site-primitive-reading">
            Materiais sem verificação ou sem
            autorização explícita de publicação
            não são apresentados como Cases.
          </p>
        </div>
      ) : (
        <div
          class="projects-list"
          data-projects-state="available"
        >
          {publicCases.map((siteCase) => (
            <article
              class="projects-case site-primitive-datum-top"
              data-case-id={siteCase.id}
            >
              <h3 class="site-primitive-subtitle">
                <a
                  class="projects-case-link"
                  href={`/projetos/${siteCase.slug}`}
                >
                  {siteCase.title}
                </a>
              </h3>

              <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
                {siteCase.summary}
              </p>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section
    class="projects-section projects-conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="projects-action-heading"
    data-projects-stage="qualified-action"
  >
    <h2
      id="projects-action-heading"
      class="site-primitive-section-title"
    >
      Avance com o contexto do seu projeto
    </h2>

    <p class="site-primitive-body site-primitive-reading">
      Use o fluxo estruturado quando houver
      contexto suficiente para iniciar a conversa.
    </p>

    <div class="projects-actions site-primitive-actions">
      <a
        class="projects-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="royal_projects"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/contato"
      >
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .projects-eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .projects-entry .site-primitive-page-title,
  .projects-section .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .projects-section > p,
  .projects-empty p,
  .projects-case p {
    margin-block: 0;
  }

  .projects-empty {
    margin-block-start: var(--site-space-6);
    padding: var(--site-space-6);
  }

  .projects-empty .site-primitive-subtitle,
  .projects-case .site-primitive-subtitle {
    margin-block: 0 var(--site-space-3);
  }

  .projects-list {
    display: grid;
    gap: var(--site-space-6);
    margin-block-start: var(--site-space-6);
  }

  .projects-case {
    padding-block-start: var(--site-space-5);
  }

  .projects-case-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }

  .projects-case-link:hover {
    text-decoration-thickness: 0.14em;
  }

  .projects-case-link:focus-visible {
    outline: 3px solid var(--site-color-required-boundary);
    outline-offset: 3px;
  }

  .projects-conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
  }

  @media (max-width: 30rem) {
    .projects-empty,
    .projects-conversion {
      padding-inline: var(--site-space-5);
    }

    .projects-conversion {
      margin-block-end: var(--site-space-6);
    }
  }
</style>
