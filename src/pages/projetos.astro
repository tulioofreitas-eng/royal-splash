---
import { Picture } from "astro:assets";
import ExperienceMotion from "../components/motion/ExperienceMotion.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/complete-experience.css";
import "../styles/experience-motion.css";
import corpHotel from "../assets/corp-hotel.jpg";
import fibraDepois from "../assets/fibra-depois.jpg";
import lazerDeck from "../assets/lazer-deck.jpg";
import lazerGeral from "../assets/lazer-geral.jpg";
import lazerGourmet from "../assets/lazer-gourmet.jpg";
import lazerNoturno from "../assets/lazer-noturno.jpg";
import obra1 from "../assets/obra-1.jpg";
import obra2 from "../assets/obra-2.jpg";
import obra3 from "../assets/obra-3.jpg";
import obra4 from "../assets/obra-4.jpg";
import obra5 from "../assets/obra-5.jpg";
import obra6 from "../assets/obra-6.jpg";
import obra7 from "../assets/obra-7.jpg";
import obra8 from "../assets/obra-8.jpg";

const images = [
  { image: obra1, layout: "feature" },
  { image: lazerGeral, layout: "standard" },
  { image: obra4, layout: "standard" },
  { image: corpHotel, layout: "standard" },
  { image: obra6, layout: "standard" },
  { image: lazerDeck, layout: "standard" },
  { image: obra8, layout: "feature" },
  { image: lazerGourmet, layout: "standard" },
  { image: obra3, layout: "standard" },
  { image: lazerNoturno, layout: "standard" },
  { image: obra5, layout: "feature" },
  { image: obra7, layout: "standard" },
  { image: fibraDepois, layout: "half" },
  { image: obra2, layout: "half" },
] as const;
---

<SiteLayout
  title="Acervo Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-primitive-page experience-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <div data-experience-motion>
    <section class="experience-entry" aria-labelledby="projects-heading" data-motion-section>
      <p class="experience-kicker" data-motion-reveal>Acervo Royal Splash</p>
      <h1 id="projects-heading" data-motion-reveal>Fotografias de projetos realizados.</h1>
      <p class="experience-lead" data-motion-reveal>
        Ambientes concluídos em que água, arquitetura, paisagismo e materiais compõem o resultado final.
      </p>
    </section>

    <section
      class="project-gallery"
      aria-label="Acervo fotográfico Royal Splash"
      data-project-gallery
      data-projects-count="14"
    >
      {images.map(({ image, layout }, index) => (
        <figure class={`project-gallery__item project-gallery__item--${layout}`} data-motion-section>
          <div class="project-gallery__media">
            <Picture
              src={image}
              alt={`Resultado final Royal Splash, imagem ${index + 1}`}
              loading={index < 3 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              widths={[400, 800, 1200]}
              sizes={`(max-width: 35rem) 100vw, (max-width: 63.99rem) ${layout === 'feature' ? '100vw' : '50vw'}, ${layout === 'feature' ? '66vw' : layout === 'half' ? '50vw' : '33vw'}`}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              data-motion-image
            />
          </div>
          <figcaption aria-hidden="true">
            <span>{String(index + 1).padStart(2, "0")}</span>
          </figcaption>
        </figure>
      ))}
    </section>

    <section class="experience-conversion" aria-labelledby="projects-conversion" data-motion-final>
      <p class="experience-kicker" data-motion-reveal>Próximo passo</p>
      <h2 id="projects-conversion" data-motion-reveal>Seu projeto pode começar com uma conversa.</h2>
      <div class="experience-links" data-motion-reveal>
        <a
          class="site-primitive-action site-primitive-action--primary"
          href="https://wa.me/5521982590643"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp sobre um projeto (abre em nova janela)"
          data-analytics-cta
          data-analytics-component="projects_whatsapp"
          data-analytics-subject="project_start"
          data-analytics-channel="whatsapp"
        >Conversar no WhatsApp</a>
        <a class="site-primitive-action site-primitive-action--tertiary" href="/metodo-royal">
          Conhecer Método Royal
        </a>
      </div>
    </section>
  </div>

  <ExperienceMotion slot="body-end" />
</SiteLayout>

<style>
  .project-gallery {
    width: min(100% - 2 * var(--site-layout-gutter), var(--site-layout-content-max));
    margin: 0 auto clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(.8rem, 1.8vw, 1.6rem);
  }

  .project-gallery__item {
    grid-column: span 4;
    min-width: 0;
    margin: 0;
    background: #12171c;
    color: #fff;
  }

  .project-gallery__item--feature {
    grid-column: span 8;
  }

  .project-gallery__item--half {
    grid-column: span 6;
  }

  .project-gallery__media {
    overflow: hidden;
  }

  .project-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .project-gallery__item--feature img {
    aspect-ratio: 16 / 7;
  }

  .project-gallery__item--half img {
    aspect-ratio: 3 / 2;
  }

  .project-gallery figcaption {
    padding: .8rem 1rem;
    font: 600 .7rem/1.3 var(--site-font-ui);
    letter-spacing: .08em;
  }

  .project-gallery figcaption span {
    color: #d9b746;
  }

  @media (max-width: 63.99rem) {
    .project-gallery__item,
    .project-gallery__item--half {
      grid-column: span 6;
    }

    .project-gallery__item--feature {
      grid-column: span 12;
    }

    .project-gallery__item--feature img {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 35rem) {
    .project-gallery {
      display: block;
    }

    .project-gallery__item + .project-gallery__item {
      margin-top: 1rem;
    }

    .project-gallery img,
    .project-gallery__item--feature img,
    .project-gallery__item--half img {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery img {
      transform: none !important;
    }
  }
</style>
