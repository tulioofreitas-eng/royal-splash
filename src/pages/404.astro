---
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Página não encontrada — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-not-found site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="not-found site-primitive-section site-primitive-section--entry"
    aria-labelledby="not-found-heading"
    data-not-found-surface
  >
    <p class="not-found__eyebrow site-primitive-eyebrow site-primitive-supporting">
      Erro 404
    </p>

    <h1
      id="not-found-heading"
      class="site-primitive-page-title site-primitive-reading"
    >
      Página não encontrada
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      A página solicitada não está disponível.
    </p>

    <div class="site-primitive-actions">
      <a
        class="site-primitive-action site-primitive-action--primary"
        href="/"
      >
        Voltar ao início
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/projetos"
      >
        Ver Projetos
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found__eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .not-found .site-primitive-page-title {
    margin-block: 0 var(--site-space-5);
  }

  .not-found > p:last-of-type {
    margin-block: 0;
  }
</style>
