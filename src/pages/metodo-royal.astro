---
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Método Royal — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-method site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="method-section method-entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="method-heading"
    data-method-stage="entry"
  >
    <p class="method-eyebrow site-primitive-eyebrow site-primitive-supporting">
      Método Royal
    </p>

    <h1 id="method-heading" class="site-primitive-page-title site-primitive-reading">
      Método Royal
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Acesse os contextos Residencial e Corporativo / Institucional,
      consulte Projetos e escolha o próximo passo para seu projeto.
    </p>

    <div class="method-actions site-primitive-actions">
      <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
        Ver Projetos
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/sobre">
        Conhecer A Royal
      </a>
    </div>
  </section>

  <section
    class="method-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="method-context-heading"
    data-method-stage="context"
  >
    <h2 id="method-context-heading" class="site-primitive-section-title">
      Contexto antes do processo
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Comece escolhendo o contexto que corresponde
      ao seu projeto.
    </p>

    <div class="method-links site-primitive-actions">
      <a class="site-primitive-action site-primitive-action--tertiary" href="/servicos">
        Explorar Residencial
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/corporativo">
        Explorar Corporativo / Institucional
      </a>
    </div>
  </section>

  <section
    class="method-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="method-controlled-heading"
    data-method-stage="controlled-method"
  >
    <h2 id="method-controlled-heading" class="site-primitive-section-title">
      Caminhos para seu projeto
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Escolha entre os contextos Residencial e Corporativo / Institucional
      para encontrar o caminho adequado no site.
    </p>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Você também pode consultar Projetos ou iniciar seu projeto.
    </p>
  </section>

  <section
    class="method-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="method-proof-heading"
    data-method-stage="proof"
  >
    <h2 id="method-proof-heading" class="site-primitive-section-title">
      Projetos
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Consulte a área de Projetos para ver os projetos
      atualmente disponíveis.
    </p>

    <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
      Explorar Projetos
    </a>
  </section>

  <section
    class="method-section method-conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="method-action-heading"
    data-method-stage="qualified-action"
  >
    <h2 id="method-action-heading" class="site-primitive-section-title">
      Avance com o contexto do seu projeto
    </h2>

    <p class="site-primitive-body site-primitive-reading">
      Quando estiver pronto, compartilhe informações sobre
      o projeto e seus dados de contato.
    </p>

    <div class="method-actions site-primitive-actions">
      <a
        class="method-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="royal_method"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/contato">
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .method-eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .method-entry .site-primitive-page-title,
  .method-section .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .method-section > p {
    margin-block: 0;
  }

  .method-section > .site-primitive-action {
    margin-block-start: var(--site-space-6);
  }

  .method-conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
  }

  @media (max-width: 30rem) {
    .method-conversion {
      margin-block-end: var(--site-space-6);
      padding-inline: var(--site-space-5);
    }
  }
</style>
