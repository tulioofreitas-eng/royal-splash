---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import servicoFibra from '../../assets/servico-fibra.jpg';
---

<LandingLayout title="Restauração de Piscina de Fibra — Royal Splash" description="Restauração de piscinas de fibra." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-fibra site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <section class="fibra-hero site-primitive-surface--dark">
    <Image src={servicoFibra} alt="Piscina de fibra de alto padrão" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="fibra-hero__image" />
    <div class="fibra-hero__veil"></div>
    <div class="fibra-hero__content">
      <h1 class="site-primitive-page-title">Sua piscina de fibra perdeu o brilho? Nós restauramos</h1>
      <p class="site-primitive-body">Restauração completa.</p>
    </div>
  </section>

  <section class="site-primitive-section fibra-introduction">
    <div class="site-primitive-reading">
      <h2 class="site-primitive-display">Restauração de Fibra</h2>
      <p class="site-primitive-body site-primitive-supporting">Trabalhamos com reforma e revitalização de piscinas de fibra existentes — trincas, desbotamento e sinais de desgaste.</p>
      <ul class="fibra-capability-list">
        <li><Icon name="check" class="fibra-icon" /> Reparo de trincas e desgaste estrutural</li>
      </ul>
    </div>
  </section>

  <section class="fibra-services site-primitive-surface--muted site-primitive-datum-top site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Nossos Serviços</h2>
      <article class="fibra-service">
        <Icon name="wrench" class="fibra-service__icon" />
        <div>
          <h3 class="site-primitive-subtitle">Reparo de Trincas</h3>
          <p class="site-primitive-body">Correção de rachaduras e desgaste estrutural.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="fibra-cta site-primitive-surface--dark">
    <div class="site-primitive-section">
      <h2 class="site-primitive-display">Dê nova vida à sua piscina de fibra</h2>
      <div class="site-primitive-actions">
        <a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a>
      </div>
    </div>
  </section>

  <section id="orcamento" class="site-primitive-section fibra-form">
    <div class="site-primitive-reading fibra-form__heading">
      <h2 class="site-primitive-section-title">Solicite seu Orçamento</h2>
      <p class="site-primitive-body site-primitive-supporting">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p>
    </div>
    <FormularioGHL />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>
  .fibra-hero { position: relative; display: grid; min-height: clamp(28rem, 68vh, 46rem); isolation: isolate; }
  .fibra-hero__image, .fibra-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fibra-hero__image { object-fit: cover; z-index: -2; }
  .fibra-hero__veil { background: color-mix(in srgb, var(--site-color-surface-dark) 78%, transparent); z-index: -1; }
  .fibra-hero__content { align-self: end; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .fibra-hero h1 { max-width: 14ch; margin: 0; }
  .fibra-hero p { margin: var(--site-space-5) 0 0; color: var(--site-color-text-on-dark); }
  .fibra-introduction .site-primitive-reading { margin-inline: auto; }
  .fibra-introduction h2, .fibra-services h2, .fibra-service h3, .fibra-form h2 { margin-block-start: 0; }
  .fibra-capability-list { margin: var(--site-space-6) 0 0; padding: var(--site-space-5) 0 0; border-block-start: 1px solid var(--site-color-divider); list-style: none; }
  .fibra-capability-list li { display: flex; gap: var(--site-space-3); align-items: center; font-weight: var(--site-font-weight-ui-strong); }
  :global(.fibra-icon), :global(.fibra-service__icon) { width: 1.5rem; height: 1.5rem; flex: none; color: var(--site-color-text-primary); }
  .fibra-services h2 { margin-block-end: var(--site-space-6); }
  .fibra-service { display: grid; grid-template-columns: auto 1fr; gap: var(--site-space-5); max-width: var(--site-layout-reading-max); padding-block-start: var(--site-space-5); border-block-start: 1px solid var(--site-color-required-boundary); }
  .fibra-service p, .fibra-form p { margin-block-end: 0; }
  .fibra-cta { text-align: center; }
  .fibra-cta .site-primitive-section { max-width: var(--site-layout-reading-max); }
  .fibra-cta h2 { margin: 0; }
  .fibra-cta .site-primitive-actions { justify-content: center; }
  .fibra-form__heading { margin: 0 auto var(--site-space-7); text-align: center; }
  @media (max-width: 30rem) {
    .fibra-hero { min-height: calc(100svh - 4.5rem); }
    .fibra-hero__content { align-self: center; padding-block: var(--site-space-7); }
    .fibra-service { gap: var(--site-space-3); }
  }
</style>
