---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import SaunaWhatsAppForm from '../../components/lp/SaunaWhatsAppForm.astro';
import Icon from '../../components/Icon.astro';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import { Image } from 'astro:assets';
import servicoSauna from '../../assets/servico-sauna.jpg';
import saunaInterior from '../../assets/sauna-interior.jpg';
import saunaSpa from '../../assets/sauna-spa.jpg';
import saunaAquecedor from '../../assets/sauna-aquecedor.jpg';
import saunaEspacoIntegrado from '../../assets/sauna-espaco-integrado.jpg';
---

<LandingLayout title="Sauna e Spa de Alto Padrão — Royal Splash" description="Construção e instalação de saunas e spas personalizados. Conforto e bem-estar." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-sauna site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <section class="sauna-hero site-primitive-surface--dark">
    <Image src={servicoSauna} alt="Sauna e spa de alto padrão" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="sauna-hero__image" />
    <div class="sauna-hero__veil"></div>
    <div class="sauna-hero__content">
      <h1 class="site-primitive-page-title">Transforme sua casa em um refúgio de bem-estar</h1>
      <p class="site-primitive-body">Saunas e spas personalizados, com conforto e acabamento premium.</p>
      <div class="site-primitive-actions"><a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Solicitar orçamento exclusivo</a></div>
    </div>
  </section>

  <section class="sauna-introduction site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section site-primitive-section--entry sauna-introduction__layout">
      <div class="sauna-introduction__copy">
        <h2 class="site-primitive-display">Bem-estar em cada detalhe</h2>
        <div class="site-primitive-reading">
          <p class="site-primitive-body site-primitive-supporting">Projetamos saunas secas e a vapor, ofurôs e espaços de spa completos, integrados à arquitetura da sua casa. Materiais nobres, sistemas de aquecimento eficientes e acabamento impecável.</p>
          <p class="site-primitive-body site-primitive-supporting">Do projeto à instalação, cuidamos de cada etapa com a mesma excelência que aplicamos em nossas piscinas.</p>
        </div>
        <ul class="sauna-introduction__qualities">
          <li><Icon name="check" class="sauna-introduction__icon" /> Projetos sob medida</li>
          <li><Icon name="check" class="sauna-introduction__icon" /> Materiais e acabamentos premium</li>
        </ul>
      </div>
      <div class="sauna-gallery">
        <GaleriaZoom imagens={[
          { src: saunaInterior, alt: 'Sauna residencial de alto padrão' },
          { src: saunaSpa, alt: 'Spa e ofurô' },
          { src: saunaEspacoIntegrado, alt: 'Espaço integrado de spa' },
          { src: saunaAquecedor, alt: 'Detalhe do aquecedor de sauna' },
        ]} />
      </div>
    </div>
  </section>

  <section class="sauna-services site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Nossos Serviços</h2>
      <div class="sauna-services__list">
        <article class="sauna-service">
          <Icon name="sun" class="sauna-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Sauna Seca e a Vapor</h3>
            <p class="site-primitive-body site-primitive-supporting">Projetos personalizados com sistemas de aquecimento.</p>
          </div>
        </article>
        <article class="sauna-service">
          <Icon name="droplet" class="sauna-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Spa e Ofurô</h3>
            <p class="site-primitive-body site-primitive-supporting">Espaços completos de relaxamento, integrados à área de lazer.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sauna-trust site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Por que a Royal Splash?</h2>
      <div class="sauna-trust__list">
        <article class="sauna-trust__entry">
          <Icon name="users" class="sauna-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Atendimento Premium</h3>
            <p class="site-primitive-body site-primitive-supporting">Consultoria exclusiva do primeiro contato à entrega.</p>
          </div>
        </article>
        <article class="sauna-trust__entry">
          <Icon name="cpu" class="sauna-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Tecnologia de Ponta</h3>
            <p class="site-primitive-body site-primitive-supporting">Sistemas de aquecimento e automação modernos.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sauna-faq site-primitive-surface--soft site-primitive-datum-bottom">
    <div class="site-primitive-section sauna-faq__layout">
      <h2 class="site-primitive-display">Perguntas frequentes</h2>
      <div class="sauna-faq__list">
        {[
          { pergunta: 'Qual a diferença entre sauna seca e a vapor?', resposta: 'A sauna seca utiliza calor gerado por pedras ou resistências, oferecendo um ambiente de baixa umidade. A sauna a vapor funciona com geradores dedicados, proporcionando alta umidade e calor envolvente.' },
          { pergunta: 'É possível integrar a sauna ou spa a um ambiente existente?', resposta: 'Sim. Avaliamos a estrutura atual da sua área de lazer ou residência para adequar equipamentos e revestimentos de forma harmônica.' },
          { pergunta: 'Quais tipos de acabamentos são utilizados?', resposta: 'Trabalhamos com materiais nobres como madeiras selecionadas para saunas secas e pedras ou pastilhas premium para saunas a vapor e spas.' },
          { pergunta: 'O projeto inclui os sistemas de aquecimento?', resposta: 'Sim. Projetamos a infraestrutura completa, especificando e instalando os geradores de vapor ou aquecedores adequados para o volume do seu ambiente.' },
          { pergunta: 'Como solicitar um orçamento ou avaliação?', resposta: 'Preencha o formulário desta página com o contexto do seu espaço. Nossa equipe iniciará uma conversa estruturada pelo WhatsApp para orientar os próximos passos.' },
        ].map((item) => (
          <details class="sauna-faq__item">
            <summary class="site-primitive-subtitle">
              {item.pergunta}
              <span aria-hidden="true">+</span>
            </summary>
            <p class="site-primitive-body site-primitive-supporting">{item.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sauna-cta site-primitive-surface--dark">
    <div class="site-primitive-section"><h2 class="site-primitive-display">Pronto para criar seu espaço de bem-estar?</h2><div class="site-primitive-actions"><a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a></div></div>
  </section>

  <section id="orcamento" class="site-primitive-section sauna-form">
    <div class="site-primitive-reading sauna-form__heading"><h2 class="site-primitive-section-title">Solicite seu Orçamento</h2><p class="site-primitive-body site-primitive-supporting">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p></div>
    <SaunaWhatsAppForm />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>
.sauna-faq__layout { display: grid; grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr); align-items: center; gap: var(--site-space-8); }
  .sauna-faq h2 { max-width: 12ch; margin-block-end: 0; }
  .sauna-faq__list { border-block-start: 1px solid var(--site-color-divider); }
  .sauna-faq__item { border-block-end: 1px solid var(--site-color-divider); }
  .sauna-faq__item summary { display: flex; justify-content: space-between; gap: var(--site-space-4); padding-block: var(--site-space-5); cursor: pointer; list-style: none; }
  .sauna-faq__item summary::-webkit-details-marker { display: none; }
  .sauna-faq__item summary span { color: var(--site-color-text-primary); transition: transform 160ms ease; }
  .sauna-faq__item[open] summary span { transform: rotate(45deg); }
  .sauna-faq__item p { margin: 0; padding: 0 0 var(--site-space-5); }
  .sauna-hero { position: relative; display: grid; min-height: max(40rem, 85svh); isolation: isolate; overflow: hidden; }
  .sauna-hero__image, .sauna-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sauna-hero__image { z-index: -2; object-fit: cover; object-position: center; }
  .sauna-hero__veil { z-index: -1; background: color-mix(in srgb, var(--site-color-surface-dark) 72%, transparent); }
  .sauna-hero__content { align-self: center; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .sauna-hero h1 { max-width: 17ch; margin: 0; }
  .sauna-hero p { max-width: 35rem; margin: var(--site-space-5) 0 0; color: var(--site-color-text-on-dark); }
  .sauna-hero .site-primitive-actions { margin-block-start: var(--site-space-6); }
  .sauna-introduction__layout { display: grid; grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr); gap: var(--site-space-8); align-items: center; }
  .sauna-introduction h2, .sauna-introduction p { margin-block-start: 0; }
  .sauna-introduction__qualities { display: grid; gap: var(--site-space-3); margin: var(--site-space-6) 0 0; padding: var(--site-space-5) 0 0; border-block-start: 1px solid var(--site-color-divider); list-style: none; }
  .sauna-introduction__qualities li { display: flex; gap: var(--site-space-3); align-items: center; }
  :global(.sauna-introduction__icon) { width: 1.25rem; height: 1.25rem; flex: none; }
  .sauna-gallery { min-width: 0; }
  .sauna-services h2, .sauna-services h3, .sauna-trust h2, .sauna-trust h3, .sauna-faq h2, .sauna-form h2 { margin-block-start: 0; }
  .sauna-services h2, .sauna-trust h2 { margin-block-end: var(--site-space-6); }
  .sauna-services .site-primitive-supporting { color: var(--site-color-text-primary); }
  .sauna-services__list { max-width: var(--site-layout-reading-max); border-block: 1px solid var(--site-color-divider); }
  .sauna-service { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-6); }
  .sauna-service + .sauna-service { border-block-start: 1px solid var(--site-color-divider); }
  .sauna-service p, .sauna-trust p, .sauna-form p { margin-block-end: 0; }
  :global(.sauna-service__icon), :global(.sauna-trust__icon) { width: 1.5rem; height: 1.5rem; flex: none; color: var(--site-color-text-primary); }
  .sauna-trust__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 60rem; }
  .sauna-trust__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-5); border-block-start: 1px solid var(--site-color-divider); }
  .sauna-trust__entry + .sauna-trust__entry { margin-inline-start: var(--site-space-7); }
  .sauna-cta .site-primitive-section { display: block; }
  .sauna-cta h2 { max-width: 18ch; margin: 0; }
  .sauna-cta .site-primitive-actions { margin-block-start: var(--site-space-6); }
  .sauna-form { padding-block-end: calc(var(--site-space-8) + 4.5rem); }
  .sauna-form__heading { margin: 0 auto var(--site-space-7); text-align: center; }
  .sauna-form__heading h2, .sauna-form__heading p { margin-block-start: 0; }
  @media (max-width: 52rem) {
    .sauna-introduction__layout, .sauna-faq__layout { grid-template-columns: 1fr; gap: var(--site-space-7); }
    .sauna-faq__layout { align-items: stretch; gap: var(--site-space-5); }
    .sauna-faq h2 { max-width: none; }
    .sauna-gallery { width: min(100%, 38rem); margin-inline: auto; }
    .sauna-trust__list { grid-template-columns: 1fr; }
    .sauna-trust__entry + .sauna-trust__entry { margin-inline-start: 0; }
  }
  @media (max-width: 42rem) {
    .sauna-hero { min-height: calc(100svh + 2rem); }
    .sauna-faq__layout { grid-template-columns: 1fr; }
    .sauna-form { padding-block-end: calc(var(--site-space-7) + 5rem); }
  }
</style>
