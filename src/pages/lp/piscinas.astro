---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import PiscinasWhatsAppForm from '../../components/lp/PiscinasWhatsAppForm.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import obra2 from '../../assets/obra-2.jpg';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import obra1 from '../../assets/obra-1.jpg';
import obra3 from '../../assets/obra-3.jpg';
import obra4 from '../../assets/obra-4.jpg';

---

<LandingLayout title="Construção de Piscinas de Alto Padrão — Royal Splash" description="Projeto e construção de piscinas personalizadas, borda infinita, iluminação LED e automação completa." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-piscinas site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <!-- Hero -->
  <section class="piscinas-hero site-primitive-surface--dark">
    <Image src={obra2} alt="Piscina iluminada em frente a uma residência contemporânea à noite" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="piscinas-hero__image" />
    <div class="piscinas-hero__veil"></div>
    <div class="piscinas-hero__content">
      <h1 class="site-primitive-page-title">Piscina de alto padrão com projeto</h1>
      <p class="site-primitive-body">Alvenaria sob medida, borda infinita, prainha, aquecimento e automação.</p>
      <div class="site-primitive-actions">
        <a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Solicitar orçamento exclusivo</a>
      </div>
    </div>
  </section>

  
  <!-- Narrative -->
  <section class="piscinas-narrative site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section site-primitive-section--entry piscinas-narrative__layout">
      <div class="piscinas-narrative__copy">
        <h2 class="site-primitive-display">Excelência em cada detalhe</h2>
        <div class="site-primitive-reading">
          <p class="site-primitive-body site-primitive-supporting">Cada projeto de piscina é tratado como uma obra única. Trabalhamos com alvenaria armada, materiais premium e os melhores acabamentos para entregar uma área de lazer que eleva o padrão da sua residência.</p>
        </div>
        <ul class="piscinas-narrative__scope">
          <li><Icon name="check" class="piscinas-narrative__icon" /> Projetos com borda infinita e prainha</li>
          <li><Icon name="check" class="piscinas-narrative__icon" /> Iluminação LED, aquecimento e automação</li>
        </ul>
      </div>
      <div class="piscinas-gallery">
        <GaleriaZoom imagens={[
          { src: obra1, alt: 'Piscina de alto padrão' },
          { src: obra2, alt: 'Piscina com iluminação LED' },
          { src: obra3, alt: 'Detalhe do revestimento' },
          { src: obra4, alt: 'Área de lazer com piscina' },
        ]} />
      </div>
    </div>
  </section>

  <!-- Serviços -->
  <section class="piscinas-services site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Nossos Serviços</h2>
      <div class="piscinas-services__list">
        <article class="piscinas-service">
          <Icon name="box" class="piscinas-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Projeto Personalizado</h3>
            <p class="site-primitive-body site-primitive-supporting">Do conceito à planta executiva, desenhado sob medida pro seu terreno e estilo de vida.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Por que -->
  <section class="piscinas-trust site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Por que a Royal Splash?</h2>
      <div class="piscinas-trust__list">
        <article class="piscinas-trust__entry">
          <Icon name="users" class="piscinas-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Atendimento Premium</h3>
            <p class="site-primitive-body site-primitive-supporting">Consultoria exclusiva do primeiro contato à entrega.</p>
          </div>
        </article>
        <article class="piscinas-trust__entry">
          <Icon name="cpu" class="piscinas-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Tecnologia de Ponta</h3>
            <p class="site-primitive-body site-primitive-supporting">Automação, aquecimento e tratamento de última geração.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="piscinas-faq site-primitive-surface--soft site-primitive-datum-bottom">
    <div class="site-primitive-section piscinas-faq__layout">
      <h2 class="site-primitive-display">Perguntas frequentes</h2>
      <div class="piscinas-faq__list">
        {[
          { pergunta: 'Como funciona o desenvolvimento de um projeto de piscina?', resposta: 'O projeto parte do espaço, das necessidades de uso e dos recursos desejados, do conceito à planta executiva.' },
          { pergunta: 'É possível reformar ou modernizar uma piscina existente?', resposta: 'Sim. A piscina existente pode ser avaliada para integrar recursos como iluminação, aquecimento, automação e tratamento.' },
          { pergunta: 'Quais recursos podem ser integrados ao projeto?', resposta: 'Borda infinita, prainha, iluminação, aquecimento, automação e tratamento podem compor o projeto conforme o contexto.' },
          { pergunta: 'O projeto é desenvolvido de acordo com o espaço disponível?', resposta: 'Sim. O desenho é desenvolvido sob medida para o terreno, o espaço disponível e a forma de uso desejada.' },
          { pergunta: 'Como solicitar uma avaliação e orçamento?', resposta: 'Preencha o formulário desta página para compartilhar seu contexto e receber o contato da equipe Royal Splash.' },
        ].map((item) => (
          <details class="piscinas-faq__item">
            <summary class="site-primitive-subtitle">
              {item.pergunta}
              <span aria-hidden="true">+</span>
            </summary>
            <p class="site-primitive-body site-primitive-supporting">{item.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="piscinas-cta site-primitive-surface--dark">
    <div class="site-primitive-section">
      <h2 class="site-primitive-display">Pronto para transformar seu espaço em um refúgio de exclusividade?</h2>
      <div class="site-primitive-actions">
        <a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="orcamento" class="site-primitive-section piscinas-form">
    <div class="site-primitive-reading piscinas-form__heading">
      <h2 class="site-primitive-section-title">Solicite seu Orçamento</h2>
      <p class="site-primitive-body site-primitive-supporting">Compartilhe o contexto que já souber e abra uma conversa estruturada com a equipe Royal Splash pelo WhatsApp.</p>
    </div>
    <PiscinasWhatsAppForm />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>
  .piscinas-narrative__layout { display: grid; grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr); gap: var(--site-space-8); align-items: center; }
  .piscinas-narrative h2, .piscinas-narrative p { margin-block-start: 0; }
  .piscinas-narrative__scope { display: grid; gap: var(--site-space-3); margin: var(--site-space-6) 0 0; padding: var(--site-space-5) 0 0; border-block-start: 1px solid var(--site-color-divider); list-style: none; }
  .piscinas-narrative__scope li { display: flex; gap: var(--site-space-3); align-items: center; }
  :global(.piscinas-narrative__icon) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--site-color-text-primary); }
  .piscinas-gallery { min-width: 0; }

  
  .piscinas-hero { position: relative; display: grid; min-height: max(40rem, 85svh); isolation: isolate; overflow: hidden; }
  .piscinas-hero__image, .piscinas-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .piscinas-hero__image { z-index: -2; object-fit: cover; object-position: center 58%; }
  .piscinas-hero__veil { z-index: -1; background: color-mix(in srgb, var(--site-color-surface-dark) 74%, transparent); }
  .piscinas-hero__content { align-self: end; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .piscinas-hero h1 { max-width: 15ch; margin: 0; }
  .piscinas-hero p { max-width: 38rem; margin: var(--site-space-5) 0 0; color: var(--site-color-text-on-dark); }
  .piscinas-services h2, .piscinas-services h3, .piscinas-trust h2, .piscinas-trust h3, .piscinas-faq h2, .piscinas-form h2 { margin-block-start: 0; }
  .piscinas-services h2, .piscinas-trust h2 { margin-block-end: var(--site-space-6); }
  .piscinas-services .site-primitive-supporting { color: var(--site-color-text-primary); }
  .piscinas-services__list { max-width: var(--site-layout-reading-max); border-block: 1px solid var(--site-color-divider); }
  .piscinas-service { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-6); }
  :global(.piscinas-service__icon), :global(.piscinas-trust__icon) { width: 1.5rem; height: 1.5rem; flex: none; color: var(--site-color-text-primary); }
  .piscinas-service p, .piscinas-trust p, .piscinas-form p { margin-block-end: 0; }
  .piscinas-trust__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 60rem; }
  .piscinas-trust__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-5); border-block-start: 1px solid var(--site-color-divider); }
  .piscinas-trust__entry + .piscinas-trust__entry { margin-inline-start: var(--site-space-7); }
  .piscinas-faq__layout { display: grid; grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr); align-items: center; gap: var(--site-space-8); }
  .piscinas-faq h2 { max-width: 12ch; margin-block-end: 0; }
  .piscinas-faq__list { border-block-start: 1px solid var(--site-color-divider); }
  .piscinas-faq__item { border-block-end: 1px solid var(--site-color-divider); }
  .piscinas-faq__item summary { display: flex; justify-content: space-between; gap: var(--site-space-4); padding-block: var(--site-space-5); cursor: pointer; list-style: none; }
  .piscinas-faq__item summary::-webkit-details-marker { display: none; }
  .piscinas-faq__item summary span { color: var(--site-color-text-primary); transition: transform 160ms ease; }
  .piscinas-faq__item[open] summary span { transform: rotate(45deg); }
  .piscinas-faq__item p { margin: 0; padding: 0 0 var(--site-space-5); }
  .piscinas-cta .site-primitive-section { display: block; }
  .piscinas-cta h2 { max-width: 28ch; margin: 0; }
  .piscinas-cta .site-primitive-actions { margin-block-start: var(--site-space-6); }
  .piscinas-form { padding-block-end: calc(var(--site-space-8) + 4.5rem); }
  .piscinas-form__heading { margin: 0 auto var(--site-space-7); text-align: center; }
  @media (max-width: 52rem) {
    .piscinas-narrative__layout { grid-template-columns: 1fr; gap: var(--site-space-7); }
    .piscinas-gallery { width: min(100%, 38rem); margin-inline: auto; }
    .piscinas-trust__list, .piscinas-faq__layout { grid-template-columns: 1fr; }
    .piscinas-faq__layout { align-items: stretch; gap: var(--site-space-5); }
    .piscinas-faq h2 { max-width: none; }
    .piscinas-trust__entry + .piscinas-trust__entry { margin-inline-start: 0; }
  }
  @media (max-width: 30rem) {
    
  .piscinas-hero { min-height: calc(100svh + 2rem); }
    .piscinas-hero__content { align-self: center; padding-block: var(--site-space-7); }
    .piscinas-form { padding-block-end: calc(var(--site-space-7) + 5rem); }
  }
</style>
