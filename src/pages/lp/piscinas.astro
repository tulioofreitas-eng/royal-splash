---
import '../../styles/global.css';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';import Icon from '../../components/Icon.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import obra1 from '../../assets/obra-1.jpg';
import obra2 from '../../assets/obra-2.jpg';
import obra3 from '../../assets/obra-3.jpg';
import obra4 from '../../assets/obra-4.jpg';
import obra5 from '../../assets/obra-5.jpg';
import obra6 from '../../assets/obra-6.jpg';
import obra7 from '../../assets/obra-7.jpg';
import obra8 from '../../assets/obra-8.jpg';
import processoEscavacao from '../../assets/processo-escavacao.jpg';
import processoEstrutura from '../../assets/processo-estrutura.jpg';
import processoImpermeabilizacao from '../../assets/processo-impermeabilizacao.jpg';
import processoAcabamento from '../../assets/processo-acabamento.jpg';
import { Image } from 'astro:assets';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';


const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Royal Splash',
  image: 'https://www.royalsplash.com.br/logo.png',
  telephone: '+5521982590643',
  email: 'contato@royalsplash.com.br',
  areaServed: {
    '@type': 'State',
    name: 'Rio de Janeiro',
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'RJ',
    addressCountry: 'BR',
  },
  description: 'Construção e manutenção de piscinas de alto padrão no estado do Rio de Janeiro.',
};
---

<html lang="pt-BR">
  <head>
    <GTMHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Construção de Piscinas de Alto Padrão no Rio de Janeiro — Royal Splash</title>
    <meta name="description" content="Projeto e construção de piscinas personalizadas, borda infinita, iluminação LED e automação completa. Atendimento em todo o Rio de Janeiro." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-marca text-white">
    <GTMBody />

    <LPHeader />

    <!-- Hero -->
    <section class="relative">
  <div class="absolute inset-0">
    <Image src={obra2} alt="..." class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-marca/80"></div>
  </div>
  <div class="relative max-w-3xl mx-auto text-center px-6 py-14 md:py-20">
  <h1 class="text-3xl md:text-5xl font-semibold mb-4 leading-tight">
      Piscina de alto padrão com projeto, prazo e preço fechados em contrato
    </h1>
    <p class="text-base md:text-lg text-slate-300 mb-6 max-w-xl mx-auto">
      Alvenaria sob medida, borda infinita, prainha, aquecimento e automação — com engenharia responsável, do projeto 3D à entrega. Barra, Zona Sul e todo o Rio.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
        Solicitar orçamento exclusivo
      </a>
      <a href="https://wa.me/5521982590643" class="abrir-whatsapp-modal inline-block border border-white/30 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-full transition-colors">
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>

    <!-- Google Reviews (2ª dobra) -->
    <GoogleReviews depoimentos={[
      { texto: 'Acompanhei cada etapa pelo relatório semanal e o prazo do contrato foi cumprido à risca — a piscina ficou exatamente como no projeto 3D.', nome: 'Cliente', local: 'Barra da Tijuca' },
      { texto: 'Escolhemos borda infinita depois de ver o cálculo de engenharia que eles apresentaram. Hoje é o ponto mais bonito da casa.', nome: 'Cliente', local: 'Zona Sul' },
      { texto: 'Pesquisei várias construtoras antes de fechar. O que pesou foi o preço fechado em contrato — sem susto no meio da obra.', nome: 'Cliente', local: 'Rio de Janeiro' },
    ]} />

    <!-- Como construímos -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-12">Como <span class="text-piscina">construímos</span></h2>
        <div class="grid md:grid-cols-2 gap-8">
          {[
            { num: '1', img: processoEscavacao, alt: 'Escavação e fundação de piscina Royal Splash, Rio de Janeiro', titulo: 'Escavação e fundação', texto: 'Preparação do terreno com contenção e drenagem dimensionadas para o seu solo.' },
            { num: '2', img: processoEstrutura, alt: 'Estrutura em concreto armado Royal Splash, Rio de Janeiro', titulo: 'Estrutura em concreto armado', texto: 'Ferragem e concretagem calculadas por engenheiro. É o que separa piscina de 30 anos de piscina com problema em 3.' },
            { num: '3', img: processoImpermeabilizacao, alt: 'Impermeabilização de piscina Royal Splash, RJ', titulo: 'Impermeabilização em todas as etapas', texto: 'A etapa invisível que evita a dor mais cara da categoria: infiltração. Testada antes do acabamento.' },
            { num: '4', img: processoAcabamento, alt: 'Acabamento premium de piscina Royal Splash, Rio de Janeiro', titulo: 'Acabamento premium', texto: 'Revestimento, borda, iluminação LED e automação. A parte que aparece — sobre uma base que não dá problema.' },
          ].map((etapa) => (
            <div class="flex gap-5">
              <div class="w-28 h-28 shrink-0 rounded-xl overflow-hidden">
                <Image src={etapa.img} alt={etapa.alt} class="w-full h-full object-cover" />
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-ouro font-semibold">{etapa.num} ·</span>
                  <h3 class="text-lg font-semibold">{etapa.titulo}</h3>
                </div>
                <p class="text-slate-400 text-sm">{etapa.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Borda infinita, prainha ou piscina em laje? -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-12">Borda infinita, prainha ou <span class="text-piscina">piscina em laje?</span></h2>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { img: obra3, alt: 'Piscina de borda infinita Royal Splash, Rio de Janeiro', titulo: 'Borda infinita', texto: 'O efeito de água encontrando o horizonte — projetado para terrenos com vista e coberturas. Cálculo de calha e recirculação incluído no projeto.' },
            { img: obra5, alt: 'Piscina com prainha Royal Splash, Rio de Janeiro', titulo: 'Prainha e espaço família', texto: "Entrada em declive suave para crianças e cadeiras dentro d'água. Conforto de resort na sua casa." },
            { img: obra7, alt: 'Piscina em laje ou cobertura Royal Splash, Rio de Janeiro', titulo: 'Piscina em laje ou cobertura', texto: 'Sim, é possível — com cálculo estrutural, reforço e impermeabilização assinados por engenheiro. Avaliamos a viabilidade da sua laje antes de qualquer proposta.' },
          ].map((card) => (
            <div class="bg-marca border border-white/10 rounded-2xl overflow-hidden">
              <div class="aspect-video">
                <Image src={card.img} alt={card.alt} class="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold mb-2">{card.titulo}</h3>
                <p class="text-slate-400 text-sm">{card.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Serviços -->
    <section class="py-16 px-6 bg-marca-suave">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-12">Nossos Serviços</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-marca border border-ouro/30 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="box" /></div>
            <h3 class="text-xl font-semibold mb-2">Projeto Personalizado</h3>
            <p class="text-slate-400">Do conceito à planta executiva, desenhado sob medida pro seu terreno e estilo de vida.</p>
          </div>
          <div class="bg-marca border border-white/10 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="wrench" /></div>
            <h3 class="text-xl font-semibold mb-2">Execução Premium</h3>
            <p class="text-slate-400">Alvenaria, borda infinita, prainha, iluminação LED e automação — equipe própria, sem terceirização.</p>
          </div>
          <div class="bg-marca border border-white/10 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="shield" /></div>
            <h3 class="text-xl font-semibold mb-2">Garantia Pós-obra</h3>
            <p class="text-slate-400">Acompanhamento após a entrega, com suporte técnico e garantia estrutural.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Por que -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl font-semibold mb-12">Por que a Royal Splash?</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="users" /></div>
            <h4 class="font-semibold mb-1">Atendimento Premium</h4>
            <p class="text-sm text-slate-400">Consultoria exclusiva do primeiro contato à entrega.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="shield" /></div>
            <h4 class="font-semibold mb-1">Equipe Qualificada</h4>
            <p class="text-sm text-slate-400">Profissionais treinados em alto padrão.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="cpu" /></div>
            <h4 class="font-semibold mb-1">Tecnologia de Ponta</h4>
            <p class="text-sm text-slate-400">Automação, aquecimento e tratamento de última geração.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="clock" /></div>
            <h4 class="font-semibold mb-1">Prazos Cumpridos</h4>
            <p class="text-sm text-slate-400">Compromisso rigoroso com cronograma e qualidade.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Galeria de projetos -->
<section class="py-16 px-6 bg-marca-suave">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-semibold text-center mb-10">Projetos que falam por si</h2>
    <GaleriaZoom
      colunas="grid-cols-2 md:grid-cols-4"
      imagens={[
        { src: obra1, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra2, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra3, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra4, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra5, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra6, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra7, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
        { src: obra8, alt: 'Obra Royal Splash, piscina no Rio de Janeiro' },
      ]}
    />
  </div>
</section>

    <!-- FAQ -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-10">Perguntas frequentes</h2>
        <div class="space-y-4">
          {[
            { pergunta: 'Quanto tempo demora a construção?', resposta: 'Depende do projeto, mas o prazo é definido em contrato antes do início — e cumprido. Na visita técnica você recebe o cronograma completo.' },
            { pergunta: 'O orçamento pode mudar no meio da obra?', resposta: 'Não. Trabalhamos com preço fechado em contrato. Alterações só acontecem se você solicitar mudanças no projeto.' },
            { pergunta: 'Vocês fazem o projeto ou preciso contratar arquiteto?', resposta: 'Fazemos o projeto completo, incluindo visualização 3D antes de fechar. Se você já tem arquiteto, trabalhamos em conjunto com ele.' },
            { pergunta: 'Posso construir piscina em cobertura ou laje?', resposta: 'Na maioria dos casos, sim. Fazemos avaliação estrutural com engenheiro responsável antes de aprovar o projeto.' },
            { pergunta: 'Qual a garantia?', resposta: 'Garantia estrutural e de impermeabilização de [X] anos, por escrito, em contrato.' },
          ].map((item) => (
            <details class="bg-marca-suave border border-white/10 rounded-2xl p-6 group">
              <summary class="font-semibold cursor-pointer list-none flex items-center justify-between gap-4">
                {item.pergunta}
                <span class="text-ouro shrink-0 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-slate-400 mt-3">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA banner -->
    <section class="py-16 px-6 bg-marca-suave text-center border-y border-ouro/20">
      <h2 class="text-3xl md:text-4xl font-semibold mb-6 max-w-2xl mx-auto">
        Pronto para transformar seu espaço em um refúgio de exclusividade?
      </h2>
      <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
        Falar com um especialista
      </a>
    </section>

    <!-- Formulário -->
    <section id="orcamento" class="py-16 px-6">
      <div class="max-w-xl mx-auto text-center mb-10">
        <h2 class="text-3xl font-semibold mb-3">Solicite seu Orçamento</h2>
        <p class="text-slate-400">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p>
      </div>
<FormularioGHL />
</section>

    <LPFooter />
    <BotaoWhatsapp />
  </body>
</html>