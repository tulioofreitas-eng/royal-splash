---
import '../../styles/global.css';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';
import Icon from '../../components/Icon.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import { Image } from 'astro:assets';
import servicoReforma from '../../assets/servico-reforma.jpg';
import obra1 from '../../assets/obra-1.jpg';
import obra2 from '../../assets/obra-2.jpg';
import obra3 from '../../assets/obra-3.jpg';
import obra4 from '../../assets/obra-4.jpg';
import obra5 from '../../assets/obra-5.jpg';
import obra6 from '../../assets/obra-6.jpg';
import obra7 from '../../assets/obra-7.jpg';
import obra8 from '../../assets/obra-8.jpg';
import reformaAntes from '../../assets/reforma-antes.jpg';
import reformaRemocao from '../../assets/reforma-remocao.jpg';
import reformaAplicacao from '../../assets/reforma-aplicacao.jpg';
import reformaDepois from '../../assets/reforma-depois.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Royal Splash',
  image: 'https://www.royalsplash.com.br/logo.png',
  telephone: '+5521982590643',
  email: 'contato@royalsplash.com.br',
  areaServed: { '@type': 'State', name: 'Rio de Janeiro' },
  address: { '@type': 'PostalAddress', addressRegion: 'RJ', addressCountry: 'BR' },
  description: 'Reforma e revitalização de piscinas de alto padrão no estado do Rio de Janeiro.',
};
---

<html lang="pt-BR">
  <head>
    <GTMHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reforma de Piscinas no Rio de Janeiro — Royal Splash</title>
    <meta name="description" content="Sua piscina perdeu o brilho? Revitalizamos com acabamento premium, novos revestimentos e automação. Atendimento em todo o Rio de Janeiro." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-marca text-white">
    <GTMBody />

    <LPHeader />

    <section class="relative">
      <div class="absolute inset-0">
        <Image src={servicoReforma} alt="Reforma de piscina de alto padrão Royal Splash, Rio de Janeiro" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-marca/80"></div>
      </div>
      <div class="relative max-w-3xl mx-auto text-center px-6 py-14 md:py-20">
        <h1 class="text-3xl md:text-5xl font-semibold mb-4 leading-tight">
          Sua piscina perdeu o brilho? Nós devolvemos
        </h1>
        <p class="text-base md:text-lg text-slate-300 mb-6 max-w-xl mx-auto">
          Reforma completa com novos revestimentos, iluminação e automação. Transforme sua piscina antiga em um espaço premium.
        </p>
        <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
          Solicitar orçamento gratuito
        </a>
      </div>
    </section>

    <!-- Antes/depois -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-10">De piscina antiga a <span class="text-piscina">área premium</span> — o mesmo espaço, outra piscina</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { img: reformaAntes, alt: 'Piscina antes da reforma Royal Splash, Rio de Janeiro', legenda: 'Antes' },
            { img: reformaRemocao, alt: 'Remoção de revestimento antigo Royal Splash, RJ', legenda: 'Remoção' },
            { img: reformaAplicacao, alt: 'Aplicação de novo revestimento Royal Splash', legenda: 'Aplicação' },
            { img: reformaDepois, alt: 'Piscina reformada Royal Splash, Rio de Janeiro', legenda: 'Depois' },
          ].map((foto) => (
            <figure class="rounded-xl overflow-hidden border border-white/10">
              <div class="aspect-square">
                <Image src={foto.img} alt={foto.alt} class="w-full h-full object-cover" />
              </div>
              <figcaption class="text-center text-sm text-slate-400 py-2 bg-marca-suave">{foto.legenda}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <GoogleReviews depoimentos={[
      { texto: 'A piscina tinha mais de 10 anos e parece nova depois da reforma — aproveitamos pra colocar aquecimento e hoje uso o ano inteiro.', nome: 'Marcelo Tavares', local: 'Recreio dos Bandeirantes' },
      { texto: 'Não imaginava que dava pra transformar minha piscina comum sem quebrar tudo. Ficou pronta bem mais rápido do que eu esperava.', nome: 'Juliana Ramos', local: 'Barra da Tijuca' },
      { texto: 'Instalamos automação por aplicativo na mesma obra da reforma — hoje controlo filtragem e iluminação pelo celular.', nome: 'Paulo Henrique Costa', local: 'Niterói' },
    ]} />

    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-semibold mb-4">Revitalização em <span class="text-piscina">cada detalhe</span></h2>
        <p class="text-slate-400 mb-4">
          Piscina antiga, revestimento desgastado ou sistema ultrapassado? Fazemos a reforma completa: novo acabamento, iluminação LED, automação e modernização estrutural — sem precisar reconstruir do zero.
        </p>
        <p class="text-slate-400 mb-6">
          Atendimento em todo o estado do Rio de Janeiro, com projeto personalizado pra sua piscina atual.
        </p>
        <ul class="space-y-3 inline-flex flex-col text-left">
          <li class="flex items-center gap-3 text-slate-300"><Icon name="check" class="w-5 h-5 text-ouro shrink-0" /> Novos revestimentos e acabamentos</li>
          <li class="flex items-center gap-3 text-slate-300"><Icon name="check" class="w-5 h-5 text-ouro shrink-0" /> Modernização de iluminação e automação</li>
          <li class="flex items-center gap-3 text-slate-300"><Icon name="check" class="w-5 h-5 text-ouro shrink-0" /> Prazo otimizado, sem obra longa</li>
        </ul>
        <p class="text-slate-400 mt-6">
          Cuidamos de cada detalhe da reforma — e aproveitamos a obra aberta pra elevar sua piscina além do que ela já era.
        </p>
      </div>

      <!-- Modernize, não só reforme -->
      <div class="max-w-5xl mx-auto mt-12">
        <h2 class="text-3xl font-semibold text-center mb-4">Modernize, <span class="text-piscina">não só reforme</span></h2>
        <p class="text-slate-400 text-center max-w-2xl mx-auto mb-12">
          Trocar o revestimento resolve a aparência. Modernizar transforma a experiência. Na mesma obra, sua piscina pode ganhar:
        </p>
        <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
          {[
            { titulo: 'Aquecimento', texto: 'use a piscina o ano inteiro, não só no verão' },
            { titulo: 'Automação por aplicativo', texto: 'filtragem, iluminação e aquecimento no celular' },
            { titulo: 'Tratamento com sal', texto: 'água mais suave e menos manutenção química' },
            { titulo: 'Iluminação LED subaquática', texto: 'a piscina vira o centro da casa à noite' },
            { titulo: 'Conversão para borda infinita', texto: 'em piscinas com estrutura e posição favoráveis, avaliamos a transformação completa' },
          ].map((upgrade) => (
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-5 h-5 text-ouro shrink-0 mt-1" />
              <p class="text-slate-300"><span class="font-semibold">{upgrade.titulo}</span> — {upgrade.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-6 bg-marca-suave">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-12">Nossos Serviços</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-marca border border-ouro/30 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="refresh" /></div>
            <h3 class="text-xl font-semibold mb-2">Revestimento Novo</h3>
            <p class="text-slate-400">Troca completa de acabamento, com materiais de alto padrão.</p>
          </div>
          <div class="bg-marca border border-white/10 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="cpu" /></div>
            <h3 class="text-xl font-semibold mb-2">Automação e Iluminação</h3>
            <p class="text-slate-400">Sistemas modernos de controle, aquecimento e iluminação LED.</p>
          </div>
          <div class="bg-marca border border-white/10 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="shield" /></div>
            <h3 class="text-xl font-semibold mb-2">Garantia Pós-obra</h3>
            <p class="text-slate-400">Acompanhamento após a entrega, com suporte técnico.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl font-semibold mb-12">Por que a Royal Splash?</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="users" /></div>
            <h4 class="font-semibold mb-1">Atendimento Premium</h4>
            <p class="text-sm text-slate-400">Consultoria exclusiva do primeiro contato à entrega.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="shield" /></div>
            <h4 class="font-semibold mb-1">Equipe Qualificada</h4>
            <p class="text-sm text-slate-400">Profissionais treinados em alto padrão.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="cpu" /></div>
            <h4 class="font-semibold mb-1">Tecnologia de Ponta</h4>
            <p class="text-sm text-slate-400">Automação, aquecimento e tratamento de última geração.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="clock" /></div>
            <h4 class="font-semibold mb-1">Prazos Cumpridos</h4>
            <p class="text-sm text-slate-400">Compromisso rigoroso com cronograma e qualidade.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 px-6 bg-marca-suave">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-10">Projetos que falam por si</h2>
        <GaleriaZoom
          colunas="grid-cols-2 md:grid-cols-4"
          imagens={[
            { src: obra1, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra2, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra3, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra4, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra5, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra6, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra7, alt: 'Obra Royal Splash, Rio de Janeiro' },
            { src: obra8, alt: 'Obra Royal Splash, Rio de Janeiro' },
          ]}
        />
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-10">Perguntas frequentes</h2>
        <div class="space-y-4">
          {[
            { pergunta: 'Preciso quebrar tudo para reformar?', resposta: 'Não. Na maioria dos casos a estrutura é aproveitada — trocamos revestimento, hidráulica e equipamentos sem reconstruir.' },
            { pergunta: 'Quanto tempo a piscina fica parada?', resposta: 'O prazo é definido na avaliação técnica e registrado em contrato. Reformas são obras mais curtas que construção.' },
            { pergunta: 'Dá para transformar minha piscina comum em borda infinita?', resposta: 'Depende da estrutura e da posição. Fazemos a avaliação de viabilidade na visita técnica, sem compromisso.' },
            { pergunta: 'Vale a pena instalar aquecimento na reforma?', resposta: 'É o momento ideal — a hidráulica já está aberta, o custo de instalação cai e a piscina passa a ser usada o ano todo.' },
            { pergunta: 'A reforma tem garantia?', resposta: 'Sim. Garantia por escrito sobre os serviços executados, definida em contrato.' },
          ].map((item) => (
            <details class="bg-marca-suave border border-white/10 rounded-2xl p-6 group">
              <summary class="font-semibold cursor-pointer list-none flex items-center justify-between gap-4">
                {item.pergunta}
                <span class="text-ouro shrink-0 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-slate-400 mt-3">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-6 bg-marca-suave text-center border-y border-ouro/20">
      <h2 class="text-3xl md:text-4xl font-semibold mb-6 max-w-2xl mx-auto">
        Dê nova vida à sua piscina antes do verão
      </h2>
      <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
        Falar com um especialista
      </a>
    </section>

    <section id="orcamento" class="py-16 px-6">
      <div class="max-w-xl mx-auto text-center mb-10">
        <h2 class="text-3xl font-semibold mb-3">Solicite seu Orçamento</h2>
        <p class="text-slate-400">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p>
      </div>
      <FormularioGHL />
    </section>

    <LPFooter />
    <BotaoWhatsapp />
  </body>
</html>