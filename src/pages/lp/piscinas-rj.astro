---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import PiscinasRJWhatsAppForm from '../../components/lp/PiscinasRJWhatsAppForm.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import servicoPiscinas from '../../assets/obra-2.jpg';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import obra1 from '../../assets/obra-1.jpg';
import obra3 from '../../assets/obra-3.jpg';
import obra4 from '../../assets/obra-4.jpg';

---

<LandingLayout title="Construção de Piscinas no Rio de Janeiro — Royal Splash" description="Construção de piscinas sob medida em todo o estado do Rio de Janeiro. Projeto personalizado, borda infinita, iluminação, aquecimento e automação completa." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-piscinas-rj site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <section class="piscinas-rj-hero site-primitive-surface--dark">
    <Image src={servicoPiscinas} alt="Construção de piscina de alto padrão no Rio de Janeiro" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="piscinas-rj-hero__image" />
    <div class="piscinas-rj-hero__veil"></div>
    <div class="piscinas-rj-hero__content">
      <h1 class="site-primitive-page-title">
        <span class="piscinas-rj-hero__line">Construção de piscinas</span>
        <span class="piscinas-rj-hero__line">em todo o estado do</span>
        <span class="piscinas-rj-hero__line piscinas-rj-hero__geo">Rio de Janeiro</span>
      </h1>
      <p class="site-primitive-body">Projetos personalizados, borda infinita, iluminação, aquecimento e automação para criar a piscina sob medida que sua casa merece.</p>
      <div class="site-primitive-actions">
        <a href="#avaliacao" class="site-primitive-action site-primitive-action--primary">Solicitar avaliação</a>
      </div>
    </div>
  </section>


  <!-- Narrative -->
  <section class="piscinas-rj-narrative site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section site-primitive-section--entry piscinas-rj-narrative__layout">
      <div class="piscinas-rj-narrative__copy">
        <h2 class="site-primitive-display">Cada piscina é um projeto único</h2>
        <div class="site-primitive-reading">
          <p class="site-primitive-body site-primitive-supporting">Sabemos que cada residência é diferente. Por isso, todos os nossos projetos de piscina são desenvolvidos sob medida, considerando o espaço disponível, o estilo da propriedade e os objetivos de uso. Alvenaria armada, materiais premium, e acabamentos de excelência para criar um espaço que realmente eleva o padrão da sua casa em todo o estado do Rio de Janeiro.</p>
        </div>
        <ul class="piscinas-rj-narrative__scope">
          <li><Icon name="check" class="piscinas-rj-narrative__icon" /> Projetos com borda infinita e prainha</li>
          <li><Icon name="check" class="piscinas-rj-narrative__icon" /> Iluminação LED, aquecimento e automação</li>
        </ul>
      </div>
      <div class="piscinas-rj-gallery">
        <GaleriaZoom imagens={[
          { src: obra1, alt: 'Piscina de alto padrão construída' },
          { src: servicoPiscinas, alt: 'Piscina com iluminação LED' },
          { src: obra3, alt: 'Detalhe do acabamento' },
          { src: obra4, alt: 'Área de lazer com piscina' },
        ]} />
      </div>
    </div>
  </section>

  <!-- Serviços -->
  <section id="projeto" class="piscinas-rj-services site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Projetos Sob Medida</h2>
      <div class="piscinas-rj-services__list">
        <article class="piscinas-rj-service">
          <Icon name="box" class="piscinas-rj-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Projeto Personalizado</h3>
            <p class="site-primitive-body site-primitive-supporting">Do conceito à planta executiva, desenho sob medida para o seu terreno, estilo de vida e preferências de design.</p>
          </div>
        </article>
        <article class="piscinas-rj-service">
          <Icon name="target" class="piscinas-rj-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Execução Completa</h3>
            <p class="site-primitive-body site-primitive-supporting">Construção da estrutura, acabamento, iluminação, aquecimento e automação com qualidade e cronograma definidos.</p>
          </div>
        </article>
        <article class="piscinas-rj-service">
          <Icon name="cpu" class="piscinas-rj-service__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Recursos Integrados</h3>
            <p class="site-primitive-body site-primitive-supporting">Borda infinita, prainha, iluminação LED, aquecimento, sistema de tratamento e automação de piscina.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Alto Padrão -->
  <section id="alto-padrao" class="piscinas-rj-standard site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Piscinas de Alto Padrão</h2>
      <div class="piscinas-rj-standard__content">
        <div class="piscinas-rj-standard__copy">
          <p class="site-primitive-body">A Royal Splash especializa-se em construção de piscinas premium. Utilizamos alvenaria armada de alta qualidade, sistemas de automação de ponta, e acabamentos que transmitem exclusividade e durabilidade.</p>
          <p class="site-primitive-body">Nossas construções refletem rigor técnico, atenção ao detalhe, e compromisso com a qualidade em cada etapa do processo — do projeto até a conclusão.</p>
        </div>
        <ul class="piscinas-rj-standard__list">
          <li><Icon name="check" class="piscinas-rj-standard__icon" /> Alvenaria armada de máxima qualidade</li>
          <li><Icon name="check" class="piscinas-rj-standard__icon" /> Acabamentos premium e revestimentos importados</li>
          <li><Icon name="check" class="piscinas-rj-standard__icon" /> Sistemas de automação, iluminação e climatização</li>
          <li><Icon name="check" class="piscinas-rj-standard__icon" /> Expertise em borda infinita e piscinas de formato livre</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Por que -->
  <section class="piscinas-rj-trust site-primitive-surface--soft site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Por que a Royal Splash?</h2>
      <div class="piscinas-rj-trust__list">
        <article class="piscinas-rj-trust__entry">
          <Icon name="users" class="piscinas-rj-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Atendimento Premium</h3>
            <p class="site-primitive-body site-primitive-supporting">Consultoria exclusiva do primeiro contato à entrega. Atendemos em todo o estado do Rio de Janeiro com a mesma excelência.</p>
          </div>
        </article>
        <article class="piscinas-rj-trust__entry">
          <Icon name="cpu" class="piscinas-rj-trust__icon" />
          <div>
            <h3 class="site-primitive-subtitle">Tecnologia de Ponta</h3>
            <p class="site-primitive-body site-primitive-supporting">Automação, aquecimento, tratamento e controle inteligente de última geração.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="piscinas-rj-faq site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section piscinas-rj-faq__layout">
      <h2 class="site-primitive-display">Perguntas frequentes</h2>
      <div class="piscinas-rj-faq__list">
        {[
          { pergunta: 'Como é desenvolvido um projeto de construção de piscina?', resposta: 'Avaliamos o espaço disponível, suas necessidades de uso e preferências de design. Depois desenvolvemos o projeto de forma personalizada, considerando alvenaria, acabamentos, iluminação, aquecimento e automação.' },
          { pergunta: 'É possível construir piscina em qualquer espaço?', resposta: 'A maioria dos espaços permite construção. Avaliamos o terreno, legislação local e condições do solo para definir as melhores soluções técnicas para sua propriedade.' },
          { pergunta: 'Qual o prazo para construir uma piscina?', resposta: 'O prazo varia conforme o tamanho, complexidade do projeto e características da construção. Após avaliar seu espaço, fornecemos um cronograma realista.' },
          { pergunta: 'Vocês oferecem garantia nas construções?', resposta: 'Sim. Nossas construções incluem garantia em estrutura, acabamentos e sistemas. Todas as garantias são formalizadas contratualmente.' },
          { pergunta: 'Atende todo o estado do Rio de Janeiro?', resposta: 'Sim. A Royal Splash atende construção de piscinas em todo o estado do Rio de Janeiro, da capital ao interior, com a mesma qualidade e excelência.' },
          { pergunta: 'Como solicitar uma avaliação?', resposta: 'Preencha o formulário desta página com seu nome e contexto para abrir uma conversa com a equipe Royal Splash pelo WhatsApp.' },
        ].map((item) => (
          <details class="piscinas-rj-faq__item">
            <summary class="site-primitive-subtitle">
              {item.pergunta}
              <span aria-hidden="true">+</span>
            </summary>
            <p class="site-primitive-body site-primitive-supporting">{item.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="piscinas-rj-cta site-primitive-surface--dark">
    <div class="site-primitive-section">
      <h2 class="site-primitive-display">Pronto para construir a piscina dos seus sonhos no Rio de Janeiro?</h2>
      <div class="site-primitive-actions">
        <a href="#avaliacao" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a>
      </div>
    </div>
  </section>

  <!-- Financing -->
  <section id="financiamento" class="piscinas-rj-financing site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Financiamento em até 60x</h2>
      <div class="piscinas-rj-financing__content">
        <p class="site-primitive-body">A Royal Splash oferece opções de pagamento parcelado via boleto, em até 60 meses, conforme análise de crédito, perfil do cliente, valor e características da obra.</p>
        <p class="site-primitive-body">A entrada, o valor financiável, o prazo e as condições financeiras são definidos caso a caso. As operações podem ser realizadas diretamente pela Royal Splash ou estruturadas com parceiros financeiros.</p>
        <p class="site-primitive-body">Disponível para pessoas físicas e jurídicas, sujeito à análise e aprovação de crédito e à apresentação da documentação necessária.</p>
        <p class="piscinas-rj-financing__disclaimer"><small>*Condições, entrada, limite financiável, prazo, encargos e eventual atualização monetária são definidos conforme a análise da operação e as condições vigentes no momento da contratação.</small></p>
      </div>
    </div>
  </section>

  <!-- Formulário -->
  <section id="avaliacao" class="site-primitive-section piscinas-rj-form">
    <div class="site-primitive-reading piscinas-rj-form__heading">
      <h2 class="site-primitive-section-title">Solicite uma Avaliação</h2>
      <p class="site-primitive-body site-primitive-supporting">Compartilhe o contexto que já souber e abra uma conversa estruturada com a equipe Royal Splash pelo WhatsApp. Atendemos todo o estado do Rio de Janeiro.</p>
    </div>
    <PiscinasRJWhatsAppForm />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>

  .piscinas-rj-narrative__layout { display: grid; grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr); gap: var(--site-space-8); align-items: center; }
  .piscinas-rj-narrative h2, .piscinas-rj-narrative p { margin-block-start: 0; }
  .piscinas-rj-narrative__scope { display: grid; gap: var(--site-space-3); margin: var(--site-space-6) 0 0; padding: var(--site-space-5) 0 0; border-block-start: 1px solid var(--site-color-divider); list-style: none; }
  .piscinas-rj-narrative__scope li { display: flex; gap: var(--site-space-3); align-items: center; }
  :global(.piscinas-rj-narrative__icon) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--site-color-text-primary); }
  .piscinas-rj-gallery { min-width: 0; }

  .piscinas-rj-hero { position: relative; display: grid; min-height: max(40rem, 85svh); isolation: isolate; overflow: hidden; }
  .piscinas-rj-hero__image, .piscinas-rj-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .piscinas-rj-hero__image { z-index: -2; object-fit: cover; object-position: center 58%; }
  .piscinas-rj-hero__veil { z-index: -1; background: color-mix(in srgb, var(--site-color-surface-dark) 72%, transparent); }
  .piscinas-rj-hero__content { align-self: end; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .piscinas-rj-hero h1 { margin: 0; }
  .piscinas-rj-hero__line { display: block; }
  .piscinas-rj-hero__geo { white-space: nowrap; }
  .piscinas-rj-hero p { max-width: 42rem; margin: var(--site-space-5) 0 0; color: var(--site-color-text-on-dark); }

  .piscinas-rj-services h2, .piscinas-rj-services h3, .piscinas-rj-standard h2, .piscinas-rj-trust h2, .piscinas-rj-trust h3, .piscinas-rj-faq h2, .piscinas-rj-financing h2, .piscinas-rj-form h2 { margin-block-start: 0; }
  :global(.piscinas-rj-service__icon), :global(.piscinas-rj-trust__icon) { width: 1.5rem; height: 1.5rem; flex: none; color: var(--site-color-text-primary); }
  :global(.piscinas-rj-standard__icon) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--site-color-text-primary); }
  .piscinas-rj-services h2, .piscinas-rj-standard h2, .piscinas-rj-trust h2, .piscinas-rj-financing h2 { margin-block-end: var(--site-space-6); }
  .piscinas-rj-services .site-primitive-supporting { color: var(--site-color-text-primary); }
  .piscinas-rj-services__list { max-width: var(--site-layout-reading-max); border-block: 1px solid var(--site-color-divider); }
  .piscinas-rj-service { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-6); }
  .piscinas-rj-service + .piscinas-rj-service { border-block-start: 1px solid var(--site-color-divider); }
  .piscinas-rj-service p, .piscinas-rj-trust p, .piscinas-rj-form p { margin-block-end: 0; }

  .piscinas-rj-standard__content { max-width: var(--site-layout-reading-max); }
  .piscinas-rj-standard p { margin-block-end: var(--site-space-4); }
  .piscinas-rj-standard__list { display: grid; gap: var(--site-space-3); margin: 0; padding: 0; list-style: none; }
  .piscinas-rj-standard__list li { display: flex; gap: var(--site-space-3); align-items: center; }

  .piscinas-rj-trust__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 60rem; }
  .piscinas-rj-trust__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-4); padding-block: var(--site-space-5); border-block-start: 1px solid var(--site-color-divider); }
  .piscinas-rj-trust__entry + .piscinas-rj-trust__entry { margin-inline-start: var(--site-space-7); }

  .piscinas-rj-faq__layout { display: grid; grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr); align-items: center; gap: var(--site-space-8); }
  .piscinas-rj-faq h2 { max-width: 12ch; margin-block-end: 0; }
  .piscinas-rj-faq__list { border-block-start: 1px solid var(--site-color-divider); }
  .piscinas-rj-faq__item { border-block-end: 1px solid var(--site-color-divider); }
  .piscinas-rj-faq__item summary { display: flex; justify-content: space-between; gap: var(--site-space-4); padding-block: var(--site-space-5); cursor: pointer; list-style: none; }
  .piscinas-rj-faq__item summary::-webkit-details-marker { display: none; }
  .piscinas-rj-faq__item summary span { color: var(--site-color-text-primary); transition: transform 160ms ease; }
  .piscinas-rj-faq__item[open] summary span { transform: rotate(45deg); }
  .piscinas-rj-faq__item p { margin: 0; padding: 0 0 var(--site-space-5); }

  .piscinas-rj-cta .site-primitive-section { display: block; }
  .piscinas-rj-cta h2 { max-width: 28ch; margin: 0; }
  .piscinas-rj-cta .site-primitive-actions { margin-block-start: var(--site-space-6); }

  .piscinas-rj-form { padding-block-end: calc(var(--site-space-8) + 4.5rem); }
  .piscinas-rj-form__heading { margin: 0 auto var(--site-space-7); text-align: center; }

  .piscinas-rj-financing__content { max-width: var(--site-layout-reading-max); }
  .piscinas-rj-financing p { margin-block-end: 0; }
  .piscinas-rj-financing__disclaimer { display: block; margin-block-start: var(--site-space-4); color: var(--site-color-text-secondary); }

  @media (max-width: 52rem) {
    .piscinas-rj-narrative__layout { grid-template-columns: 1fr; gap: var(--site-space-7); }
    .piscinas-rj-gallery { width: min(100%, 38rem); margin-inline: auto; }
    .piscinas-rj-hero__content { text-align: center; }
    .piscinas-rj-hero h1, .piscinas-rj-hero p { margin-inline: auto; }
    .piscinas-rj-hero .site-primitive-actions { justify-content: center; }
    .piscinas-rj-services h2, .piscinas-rj-standard h2, .piscinas-rj-trust h2, .piscinas-rj-faq h2 { text-align: center; }
    .piscinas-rj-trust__list, .piscinas-rj-faq__layout { grid-template-columns: 1fr; }
    .piscinas-rj-trust__entry + .piscinas-rj-trust__entry { margin-inline-start: 0; }
    .piscinas-rj-faq__layout { align-items: stretch; gap: var(--site-space-5); }
    .piscinas-rj-faq h2 { max-width: none; }
  }

  @media (max-width: 30rem) {
    .piscinas-rj-hero { min-height: calc(100svh + 2rem); }
    .piscinas-rj-hero__content { align-self: center; padding-block: var(--site-space-7); }
    .piscinas-rj-form { padding-block-end: calc(var(--site-space-7) + 5rem); }
  }
</style>
