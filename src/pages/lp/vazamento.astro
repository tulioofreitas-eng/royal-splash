---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import servicoVazamento from '../../assets/servico-vazamento.jpg';
---

<LandingLayout title="Detecção de Vazamento em Piscinas — Royal Splash" description="Sua piscina está perdendo água? Detectamos e reparamos vazamentos." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-vazamento site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <section class="vazamento-hero site-primitive-surface--dark">
    <Image src={servicoVazamento} alt="Detecção de vazamento em piscina" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="vazamento-hero__image" />
    <div class="vazamento-hero__veil"></div>
    <div class="vazamento-hero__content">
      <h1 class="site-primitive-page-title">Sua piscina está perdendo água?</h1>
    </div>
  </section>

  <section class="vazamento-diagnosis site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section site-primitive-section--entry">
      <div class="site-primitive-reading vazamento-diagnosis__reading">
        <h2 class="site-primitive-display">Detecção de Vazamentos</h2>
        <p class="site-primitive-body site-primitive-supporting">Piscina perdendo nível de água constantemente? Pode ser vazamento estrutural, em tubulação ou no revestimento.</p>
      </div>
    </div>
  </section>

  <section class="vazamento-method site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Como Trabalhamos</h2>
      <article class="vazamento-method__entry">
        <Icon name="wrench" class="vazamento-method__icon" />
        <div>
          <h3 class="site-primitive-subtitle">Reparo</h3>
          <p class="site-primitive-body">Correção estrutural, de tubulação ou revestimento, sem gambiarra.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="vazamento-trust site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section">
      <h2 class="site-primitive-section-title">Por que a Royal Splash?</h2>
      <div class="vazamento-trust__grid">
        <article class="vazamento-trust__entry">
          <Icon name="cpu" class="vazamento-trust__icon" />
          <h3 class="site-primitive-subtitle font-semibold mb-1">Tecnologia de Ponta</h3>
        </article>
        <article class="vazamento-trust__entry">
          <Icon name="users" class="vazamento-trust__icon" />
          <h3 class="site-primitive-subtitle font-semibold mb-1">Atendimento Premium</h3>
          <p class="site-primitive-body site-primitive-supporting">Consultoria clara do diagnóstico à entrega.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="vazamento-cta site-primitive-surface--dark">
    <div class="site-primitive-section">
      <h2 class="site-primitive-display">Não deixe o vazamento aumentar sua conta de água</h2>
      <div class="site-primitive-actions">
        <a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a>
      </div>
    </div>
  </section>

  <section id="orcamento" class="site-primitive-section vazamento-form">
    <div class="site-primitive-reading vazamento-form__heading">
      <h2 class="site-primitive-section-title">Solicite seu Orçamento</h2>
      <p class="site-primitive-body site-primitive-supporting">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu caso em detalhes.</p>
    </div>
    <FormularioGHL />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>
  .vazamento-hero { position: relative; display: grid; min-height: clamp(24rem, 58vh, 40rem); isolation: isolate; border-block-end: 1px solid var(--site-color-accent-on-dark); }
  .vazamento-hero__image, .vazamento-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vazamento-hero__image { z-index: -2; object-fit: cover; object-position: center 30%; }
  .vazamento-hero__veil { z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--site-color-surface-dark) 92%, transparent) 0%, color-mix(in srgb, var(--site-color-surface-dark) 72%, transparent) 58%, color-mix(in srgb, var(--site-color-surface-dark) 46%, transparent) 100%); }
  .vazamento-hero__content { align-self: end; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .vazamento-hero h1 { max-width: 12ch; margin: 0; }
  .vazamento-diagnosis__reading { max-width: 46rem; }
  .vazamento-diagnosis h2, .vazamento-method h2, .vazamento-method h3, .vazamento-trust h2, .vazamento-trust h3, .vazamento-form h2 { margin-block-start: 0; }
  .vazamento-diagnosis p, .vazamento-method p, .vazamento-trust p, .vazamento-form p { margin-block-end: 0; }
  .vazamento-method h2, .vazamento-trust h2 { margin-block-end: var(--site-space-6); }
  .vazamento-method__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-5); max-width: 46rem; padding-block: var(--site-space-5); border-block: 1px solid var(--site-color-required-boundary); }
  :global(.vazamento-method__icon), :global(.vazamento-trust__icon) { width: 1.5rem; height: 1.5rem; flex: none; color: var(--site-color-text-primary); }
  .vazamento-trust__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 52rem; border-block: 1px solid var(--site-color-divider); }
  .vazamento-trust__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); align-content: start; gap: var(--site-space-3) var(--site-space-4); padding: var(--site-space-5); }
  .vazamento-trust__entry + .vazamento-trust__entry { border-inline-start: 1px solid var(--site-color-divider); }
  .vazamento-trust__entry p { grid-column: 2; }
  .vazamento-cta .site-primitive-section { max-width: 52rem; }
  .vazamento-cta h2 { max-width: 18ch; margin: 0; }
  .vazamento-form { padding-block-end: calc(var(--site-space-8) + 4.5rem); }
  .vazamento-form__heading { margin: 0 auto var(--site-space-7); }
  @media (max-width: 52rem) {
    .vazamento-hero { min-height: 100svh; }
    .vazamento-hero__content { align-self: center; padding-block: var(--site-space-7); }
    .vazamento-trust__grid { grid-template-columns: 1fr; }
    .vazamento-trust__entry { padding-inline: 0; }
    .vazamento-trust__entry + .vazamento-trust__entry { border-block-start: 1px solid var(--site-color-divider); border-inline-start: 0; }
  }
  @media (max-width: 30rem) {
    .vazamento-method__entry { gap: var(--site-space-3); }
    .vazamento-form { padding-block-end: calc(var(--site-space-7) + 5rem); }
  }
</style>
