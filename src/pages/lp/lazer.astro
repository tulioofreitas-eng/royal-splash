---
import '../../styles/global.css';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';
import Icon from '../../components/Icon.astro';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import { Image } from 'astro:assets';
import servicoLazer from '../../assets/servico-lazer.jpg';
import lazerGeral from '../../assets/lazer-geral.jpg';
import lazerGourmet from '../../assets/lazer-gourmet.jpg';
import lazerDeck from '../../assets/lazer-deck.jpg';
import lazerNoturno from '../../assets/lazer-noturno.jpg';

---

<html lang="pt-BR">
  <head>
    <GTMHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Áreas de Lazer de Alto Padrão — Royal Splash</title>
    <meta name="description" content="Projetamos e construímos áreas de lazer completas — piscina, deck, área gourmet e paisagismo." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="bg-marca text-white">
    <GTMBody />

    <LPHeader />

    <section class="relative">
      <div class="absolute inset-0">
        <Image src={servicoLazer} alt="Área de lazer de alto padrão" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-marca/80"></div>
      </div>
      <div class="relative max-w-3xl mx-auto text-center px-6 py-14 md:py-20">
        <h1 class="text-3xl md:text-5xl font-semibold mb-4 leading-tight">
          Sua área de lazer completa, do projeto à entrega
        </h1>
        <p class="text-base md:text-lg text-slate-300 mb-6 max-w-xl mx-auto">
          Piscina, deck, área gourmet e paisagismo integrados em um só projeto.
        </p>
        <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
          Solicitar orçamento exclusivo
        </a>
      </div>
    </section>


    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-semibold mb-4">Excelência em <span class="text-piscina">cada detalhe</span></h2>
          <p class="text-slate-400 mb-4">
            Uma área de lazer de verdade vai além da piscina: deck, área gourmet, paisagismo e iluminação integrados formam um espaço pensado pra viver, receber e relaxar.
          </p>
          <p class="text-slate-400 mb-6">
            Cuidamos de todo o projeto — arquitetura, execução e acabamento — com o mesmo padrão de excelência em cada etapa.
          </p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-slate-300"><Icon name="check" class="w-5 h-5 text-ouro shrink-0" /> Projeto integrado (piscina, deck, gourmet)</li>
            <li class="flex items-center gap-3 text-slate-300"><Icon name="check" class="w-5 h-5 text-ouro shrink-0" /> Paisagismo e iluminação sob medida</li>
          </ul>
        </div>
        <GaleriaZoom imagens={[
  { src: lazerGeral, alt: 'Área de lazer completa' },
  { src: lazerGourmet, alt: 'Área gourmet integrada' },
  { src: lazerDeck, alt: 'Deck e paisagismo' },
  { src: lazerNoturno, alt: 'Área de lazer à noite' },
]} />
      </div>
    </section>

    <section class="py-16 px-6 bg-marca-suave">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-12">Nossos Serviços</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-marca border border-ouro/30 rounded-2xl p-6">
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-4 text-ouro"><Icon name="box" /></div>
            <h3 class="text-xl font-semibold mb-2">Projeto Integrado</h3>
            <p class="text-slate-400">Piscina, deck e área gourmet planejados como um único espaço.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl font-semibold mb-12">Por que a Royal Splash?</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="users" /></div>
            <h4 class="font-semibold mb-1">Atendimento Premium</h4>
            <p class="text-sm text-slate-400">Consultoria exclusiva do primeiro contato à entrega.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-ouro/10 flex items-center justify-center mb-3 mx-auto text-ouro"><Icon name="cpu" /></div>
            <h4 class="font-semibold mb-1">Tecnologia de Ponta</h4>
            <p class="text-sm text-slate-400">Automação, aquecimento e iluminação de última geração.</p>
          </div>
        </div>
      </div>
    </section>



    <!-- FAQ -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-semibold text-center mb-10">Perguntas frequentes</h2>
        <div class="space-y-4">
          {[
            { pergunta: 'O que está incluso no projeto de área de lazer?', resposta: 'Piscina, deck, área gourmet, paisagismo e iluminação são planejados como um único projeto integrado — você recebe a visualização completa antes de aprovar.' },
            { pergunta: 'Preciso ter piscina pra contratar a área de lazer completa?', resposta: 'Não. Também executamos deck, área gourmet e paisagismo separadamente, mesmo em espaços que já têm piscina pronta.' },
            { pergunta: 'Vocês cuidam do paisagismo também?', resposta: 'Sim. Paisagismo e iluminação fazem parte do projeto integrado, pensados junto com a arquitetura de todo o espaço.' },
            { pergunta: 'É possível fazer em etapas, respeitando o orçamento?', resposta: 'Sim. Planejamos o projeto completo, mas a execução pode ser dividida em etapas, de acordo com sua prioridade e orçamento.' },
          ].map((item) => (
            <details class="bg-marca-suave border border-white/10 rounded-2xl p-6 group">
              <summary class="font-semibold cursor-pointer list-none flex items-center justify-between gap-4">
                {item.pergunta}
                <span class="text-ouro shrink-0 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-slate-400 mt-3">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-6 bg-marca-suave text-center border-y border-ouro/20">
      <h2 class="text-3xl md:text-4xl font-semibold mb-6 max-w-2xl mx-auto">
        Pronto para criar sua área de lazer dos sonhos?
      </h2>
      <a href="#orcamento" class="inline-block bg-ouro hover:opacity-90 text-marca font-semibold px-8 py-4 rounded-full transition-opacity">
        Falar com um especialista
      </a>
    </section>

    <section id="orcamento" class="py-16 px-6">
      <div class="max-w-xl mx-auto text-center mb-10">
        <h2 class="text-3xl font-semibold mb-3">Solicite seu Orçamento</h2>
        <p class="text-slate-400">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p>
      </div>
      <FormularioGHL />
    </section>

    <LPFooter />
    <BotaoWhatsapp />
  </body>
</html>