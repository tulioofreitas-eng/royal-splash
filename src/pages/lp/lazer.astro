---
import '../../styles/global.css';
import LandingLayout from '../../layouts/LandingLayout.astro';
import GTMHead from '../../components/GTMHead.astro';
import GTMBody from '../../components/GTMBody.astro';
import LPHeader from '../../components/LPHeader.astro';
import LPFooter from '../../components/LPFooter.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import FormularioGHL from '../../components/FormularioGHL.astro';
import Icon from '../../components/Icon.astro';
import GaleriaZoom from '../../components/GaleriaZoom.astro';
import { Image } from 'astro:assets';
import servicoLazer from '../../assets/servico-lazer.jpg';
import lazerGeral from '../../assets/lazer-geral.jpg';
import lazerGourmet from '../../assets/lazer-gourmet.jpg';
import lazerDeck from '../../assets/lazer-deck.jpg';
import lazerNoturno from '../../assets/lazer-noturno.jpg';
---

<LandingLayout title="Áreas de Lazer de Alto Padrão — Royal Splash" description="Projetamos e construímos áreas de lazer completas — piscina, deck, área gourmet e paisagismo." robots="noindex, nofollow" visualMode="brand" bodyClass="site-brand-lp-lazer site-primitive-page">
  <GTMHead slot="head" />
  <link slot="head" rel="icon" type="image/x-icon" href="/favicon.ico" />
  <GTMBody slot="body-start" />
  <LPHeader slot="header" visualMode="brand" />

  <section class="lazer-hero site-primitive-surface--dark">
    <Image src={servicoLazer} alt="Área de lazer de alto padrão" widths={[390, 640, 768, 1024, 1280, 1536, 1792, 2400]} sizes="100vw" priority class="lazer-hero__image" />
    <div class="lazer-hero__veil"></div>
    <div class="lazer-hero__content">
      <h1 class="site-primitive-page-title">Sua área de lazer completa, do projeto à entrega</h1>
      <p class="site-primitive-body">Piscina, deck, área gourmet e paisagismo integrados em um só projeto.</p>
      <div class="site-primitive-actions"><a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Solicitar orçamento exclusivo</a></div>
    </div>
  </section>

  <section class="lazer-narrative site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section site-primitive-section--entry lazer-narrative__layout">
      <div class="lazer-narrative__copy">
        <h2 class="site-primitive-display">Excelência em cada detalhe</h2>
        <div class="site-primitive-reading">
          <p class="site-primitive-body site-primitive-supporting">Uma área de lazer de verdade vai além da piscina: deck, área gourmet, paisagismo e iluminação integrados formam um espaço pensado pra viver, receber e relaxar.</p>
          <p class="site-primitive-body site-primitive-supporting">Cuidamos de todo o projeto — arquitetura, execução e acabamento — com o mesmo padrão de excelência em cada etapa.</p>
        </div>
        <ul class="lazer-narrative__scope">
          <li><Icon name="check" class="lazer-narrative__icon" /> Projeto integrado (piscina, deck, gourmet)</li>
          <li><Icon name="check" class="lazer-narrative__icon" /> Paisagismo e iluminação sob medida</li>
        </ul>
      </div>
      <div class="lazer-gallery">
        <GaleriaZoom imagens={[
          { src: lazerGeral, alt: 'Área de lazer completa' },
          { src: lazerGourmet, alt: 'Área gourmet integrada' },
          { src: lazerDeck, alt: 'Deck e paisagismo' },
          { src: lazerNoturno, alt: 'Área de lazer à noite' },
        ]} />
      </div>
    </div>
  </section>

  <section class="lazer-service site-primitive-surface--soft site-primitive-datum-bottom">
    <div class="site-primitive-section lazer-service__layout">
      <h2 class="site-primitive-section-title">Nossos Serviços</h2>
      <article class="lazer-service__entry">
        <Icon name="box" class="lazer-service__icon" />
        <div><h3 class="site-primitive-subtitle">Projeto Integrado</h3><p class="site-primitive-body site-primitive-supporting">Piscina, deck e área gourmet planejados como um único espaço.</p></div>
      </article>
    </div>
  </section>

  <section class="lazer-trust site-primitive-surface--muted site-primitive-datum-bottom">
    <div class="site-primitive-section lazer-trust__layout">
      <h2 class="site-primitive-section-title">Por que a Royal Splash?</h2>
      <div class="lazer-trust__list">
        <article><Icon name="users" class="lazer-trust__icon" /><h3 class="site-primitive-subtitle">Atendimento Premium</h3><p class="site-primitive-body site-primitive-supporting">Consultoria exclusiva do primeiro contato à entrega.</p></article>
        <article><Icon name="cpu" class="lazer-trust__icon" /><h3 class="site-primitive-subtitle">Tecnologia de Ponta</h3><p class="site-primitive-body site-primitive-supporting">Automação, aquecimento e iluminação de última geração.</p></article>
      </div>
    </div>
  </section>

  <section class="lazer-faq site-primitive-surface--light site-primitive-datum-bottom">
    <div class="site-primitive-section lazer-faq__layout">
      <div class="lazer-faq__heading"><h2 class="site-primitive-display">Perguntas frequentes</h2></div>
      <div class="lazer-faq__disclosures">
        {[
          { pergunta: 'O que está incluso no projeto de área de lazer?', resposta: 'Piscina, deck, área gourmet, paisagismo e iluminação são planejados como um único projeto integrado — você recebe a visualização completa antes de aprovar.' },
          { pergunta: 'Preciso ter piscina pra contratar a área de lazer completa?', resposta: 'Não. Também executamos deck, área gourmet e paisagismo separadamente, mesmo em espaços que já têm piscina pronta.' },
          { pergunta: 'Vocês cuidam do paisagismo também?', resposta: 'Sim. Paisagismo e iluminação fazem parte do projeto integrado, pensados junto com a arquitetura de todo o espaço.' },
          { pergunta: 'É possível fazer em etapas, respeitando o orçamento?', resposta: 'Sim. Planejamos o projeto completo, mas a execução pode ser dividida em etapas, de acordo com sua prioridade e orçamento.' },
        ].map((item) => (
          <details class="lazer-faq__item">
            <summary class="site-primitive-subtitle">
              {item.pergunta}
              <span aria-hidden="true">+</span>
            </summary>
            <p class="site-primitive-body site-primitive-supporting">{item.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="lazer-cta site-primitive-surface--dark">
    <div class="site-primitive-section"><h2 class="site-primitive-display">Pronto para criar sua área de lazer dos sonhos?</h2><div class="site-primitive-actions"><a href="#orcamento" class="site-primitive-action site-primitive-action--primary">Falar com um especialista</a></div></div>
  </section>

  <section id="orcamento" class="site-primitive-section lazer-form">
    <div class="site-primitive-reading lazer-form__heading"><h2 class="site-primitive-section-title">Solicite seu Orçamento</h2><p class="site-primitive-body site-primitive-supporting">Preencha os dados abaixo e nossa equipe entrará em contato para entender seu projeto em detalhes.</p></div>
    <FormularioGHL />
  </section>

  <LPFooter slot="footer" visualMode="brand" />
  <BotaoWhatsapp slot="body-end" />
</LandingLayout>

<style>
  .lazer-hero { position: relative; display: grid; min-height: max(40rem, 88svh); isolation: isolate; overflow: hidden; }
  .lazer-hero__image, .lazer-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lazer-hero__image { z-index: -2; object-fit: cover; object-position: center; }
  .lazer-hero__veil { z-index: -1; background: color-mix(in srgb, var(--site-color-surface-dark) 72%, transparent); }
  .lazer-hero__content { align-self: end; width: min(calc(100% - (2 * var(--site-layout-gutter))), var(--site-layout-content-max)); margin-inline: auto; padding-block: var(--site-space-8); }
  .lazer-hero h1 { max-width: 18ch; margin: 0; }
  .lazer-hero p { max-width: 38rem; margin: var(--site-space-5) 0 0; color: var(--site-color-text-on-dark); }
  .lazer-hero .site-primitive-actions { margin-block-start: var(--site-space-6); }
  .lazer-narrative__layout { display: grid; grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr); gap: var(--site-space-8); align-items: center; }
  .lazer-narrative h2, .lazer-narrative p { margin-block-start: 0; }
  .lazer-narrative__scope { display: grid; gap: var(--site-space-3); margin: var(--site-space-6) 0 0; padding: var(--site-space-5) 0 0; border-block-start: 1px solid var(--site-color-divider); list-style: none; }
  .lazer-narrative__scope li { display: flex; gap: var(--site-space-3); align-items: center; }
  :global(.lazer-narrative__icon) { width: 1.25rem; height: 1.25rem; flex: none; }
  .lazer-gallery { min-width: 0; }
  .lazer-service__layout, .lazer-trust__layout { display: grid; grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr); gap: var(--site-space-8); }
  .lazer-service h2, .lazer-trust h2 { margin-block-start: 0; }
  .lazer-service__entry { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--site-space-5); padding-block: var(--site-space-5); border-block: 1px solid var(--site-color-divider); }
  .lazer-service__entry h3, .lazer-service__entry p { margin-block-start: 0; }
  .lazer-service__entry p { margin-block-end: 0; }
  :global(.lazer-service__icon), :global(.lazer-trust__icon) { width: 1.5rem; height: 1.5rem; }
  .lazer-trust__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--site-space-6); }
  .lazer-trust__list article { padding-block-start: var(--site-space-4); border-block-start: 1px solid var(--site-color-divider); }
  .lazer-trust__list h3 { margin: var(--site-space-4) 0 var(--site-space-2); }
  .lazer-trust__list p { margin: 0; color: var(--site-color-text-primary); }
  .lazer-faq__layout { display: grid; grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr); gap: var(--site-space-8); align-items: start; }
  .lazer-faq__heading { position: sticky; top: var(--site-space-6); }
  .lazer-faq h2 { margin: 0; }
  .lazer-faq__disclosures { border-block-start: 1px solid var(--site-color-divider); }
  .lazer-faq__item { border-block-end: 1px solid var(--site-color-divider); }
  .lazer-faq__item summary { display: flex; gap: var(--site-space-5); align-items: center; justify-content: space-between; padding-block: var(--site-space-5); cursor: pointer; list-style: none; }
  .lazer-faq__item summary::-webkit-details-marker { display: none; }
  .lazer-faq__item summary span { flex: none; font-family: var(--site-font-family-body); }
  .lazer-faq__item p { margin: calc(-1 * var(--site-space-2)) 0 var(--site-space-5); }
  .lazer-cta .site-primitive-section { display: flex; gap: var(--site-space-7); align-items: end; justify-content: space-between; }
  .lazer-cta h2 { max-width: 19ch; margin: 0; }
  .lazer-cta .site-primitive-actions { flex: none; margin: 0; }
  .lazer-form { padding-block-end: calc(var(--site-space-8) + 4.5rem); }
  .lazer-form__heading { margin: 0 auto var(--site-space-7); text-align: center; }
  .lazer-form__heading h2, .lazer-form__heading p { margin-block-start: 0; }
  @media (max-width: 52rem) {
    .lazer-narrative__layout, .lazer-service__layout, .lazer-trust__layout, .lazer-faq__layout { grid-template-columns: 1fr; gap: var(--site-space-7); }
    .lazer-gallery { width: min(100%, 38rem); margin-inline: auto; }
    .lazer-faq__heading { position: static; }
    .lazer-cta .site-primitive-section { display: block; }
    .lazer-cta .site-primitive-actions { margin-block-start: var(--site-space-6); }
  }
  @media (max-width: 42rem) {
    .lazer-hero { min-height: calc(100svh + 5rem); }
    .lazer-hero__content { align-self: center; }
    .lazer-trust__list { grid-template-columns: 1fr; }
    .lazer-form { padding-block-end: calc(var(--site-space-7) + 5rem); }
  }
</style>
