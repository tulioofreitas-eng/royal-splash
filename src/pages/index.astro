---
import SegmentRouter from "../components/site/SegmentRouter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-functional-home"
>
  <SiteHeader slot="header" />

  <section
    class="home-section home-entry"
    aria-labelledby="home-heading"
    data-home-stage="entry"
  >
    <p class="home-eyebrow">
      Royal Splash
    </p>

    <h1 id="home-heading">
      Encontre o contexto certo para avançar.
    </h1>

    <p>
      Explore o contexto relevante, consulte projetos e evidências
      disponíveis e avance quando estiver pronto para iniciar seu projeto.
    </p>

    <div class="home-actions">
      <a
        class="home-primary-action"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="home_entry"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a href="/projetos">
        Ver Projetos
      </a>
    </div>
  </section>

  <SegmentRouter />

  <section
    class="home-section"
    aria-labelledby="proof-heading"
    data-home-stage="proof"
  >
    <h2 id="proof-heading">
      Projetos e evidências
    </h2>

    <p>
      Consulte a área de Projetos para acessar conteúdo de prova
      estruturado conforme evidências verificadas estiverem disponíveis.
    </p>

    <a href="/projetos">
      Explorar Projetos
    </a>
  </section>

  <section
    class="home-section"
    aria-labelledby="method-trust-heading"
    data-home-stage="method-trust"
  >
    <h2 id="method-trust-heading">
      Método e confiança
    </h2>

    <div class="home-bridge-grid">
      <article>
        <h3>Método Royal</h3>
        <p>
          Entenda a estrutura de método e processo sustentada
          pelas evidências disponíveis.
        </p>
        <a href="/metodo-royal">
          Conhecer Método Royal
        </a>
      </article>

      <article>
        <h3>A Royal</h3>
        <p>
          Acesse a superfície institucional destinada à compreensão
          e confiança sobre a Royal.
        </p>
        <a href="/sobre">
          Conhecer A Royal
        </a>
      </article>
    </div>
  </section>

  <section
    class="home-section home-conversion"
    aria-labelledby="conversion-heading"
    data-home-stage="qualified-action"
  >
    <h2 id="conversion-heading">
      Próximo passo
    </h2>

    <p>
      Quando fizer sentido avançar, compartilhe o contexto
      do seu projeto pelo fluxo estruturado.
    </p>

    <div class="home-actions">
      <a
        class="home-primary-action"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="home_qualified_action"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a href="/contato">
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  body.site-functional-home {
    margin: 0;
    background: Canvas;
    color: CanvasText;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  body.site-functional-home * {
    box-sizing: border-box;
  }

  body.site-functional-home a {
    color: inherit;
  }

  body.site-functional-home a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }
</style>

<style>
  .home-section {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 3rem;
  }

  .home-entry {
    padding-block-start: 4rem;
  }

  .home-eyebrow {
    font-weight: 700;
  }

  .home-entry h1 {
    max-width: 20ch;
  }

  .home-entry > p:not(.home-eyebrow),
  .home-section > p {
    max-width: 65ch;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-block-start: 1.5rem;
  }

  .home-actions a,
  .home-section > a,
  .home-bridge-grid a {
    display: inline-block;
    padding: 0.75rem;
  }

  .home-primary-action {
    border: 2px solid currentColor;
    font-weight: 700;
  }

  .home-bridge-grid {
    display: grid;
    gap: 1rem;
  }

  .home-bridge-grid article {
    padding: 1.25rem;
    border: 1px solid currentColor;
  }

  .home-conversion {
    border-block-start: 1px solid currentColor;
  }

  @media (min-width: 48rem) {
    .home-bridge-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
