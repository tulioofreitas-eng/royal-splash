---
import ExperienceMotion from "../components/motion/ExperienceMotion.astro";import SiteHeader from "../components/site/SiteHeader.astro";import SiteLayout from "../layouts/SiteLayout.astro";import heroVideo from "../assets/home-hero-r2.mp4";import heroFallback from "../assets/obra-2.jpg";import residential from "../assets/lazer-geral.jpg";import corporate from "../assets/corp-hotel.jpg";import proof1 from "../assets/obra-1.jpg";import proof2 from "../assets/fibra-detalhe.jpg";import proof3 from "../assets/lazer-noturno.jpg";import proof4 from "../assets/corp-olimpica.jpg";import "../styles/experience-motion.css";const caps=["Piscinas","Sauna","Lazer","Reforma","Vazamento","Fibra"];const steps=["Entendimento","Escopo e proposta","Execução","Entrega e apoio"];
---
<SiteLayout title="Royal Splash" description="Engenharia e integração para projetos aquáticos residenciais, corporativos e institucionais." robots="noindex, nofollow" bodyClass="site-primitive-page home-r3" visualMode="brand"><SiteHeader slot="header" visualMode="brand" /><div data-experience-motion><section class="cinematic-hero" aria-labelledby="home-heading" data-motion-hero data-home-stage="entry"><video autoplay muted playsinline loop preload="metadata" poster={heroFallback.src} aria-hidden="true" data-motion-media="hero"><source src={heroVideo} type="video/mp4" /></video><div class="cinematic-hero__veil" data-motion-hero-veil></div><div class="cinematic-hero__content"><p class="kicker" data-motion-reveal>Arquitetura • água • engenharia</p><h1 id="home-heading" data-motion-reveal data-motion-hero-title>Água como parte da arquitetura.</h1><p data-motion-reveal data-motion-hero-copy>Projetamos e executamos soluções aquáticas com leitura técnica, integração ao espaço e atenção à experiência final.</p><div class="actions" data-motion-reveal data-motion-hero-actions><a class="site-primitive-action site-primitive-action--primary experience-action" href="/inicie-seu-projeto">Inicie seu projeto</a><a class="site-primitive-action site-primitive-action--tertiary experience-action" href="/projetos">Explorar projetos</a></div></div></section><section class="context-transition" aria-labelledby="contexts-heading" data-motion-section><div class="context-transition__intro" data-motion-reveal><p class="kicker">01 / Duas escalas. Uma engenharia.</p><h2 id="contexts-heading">Residencial ou corporativo, a água começa no projeto.</h2></div><a href="/servicos" data-motion-reveal><img src={residential.src} alt="Projeto residencial Royal Splash com piscina e área de lazer" data-motion-image/><div class="context-transition__caption"><span>Residencial</span><strong>Integração ao espaço de viver.</strong></div></a><a href="/corporativo" data-motion-reveal><img src={corporate.src} alt="Projeto corporativo Royal Splash em ambiente hoteleiro" data-motion-image/><div class="context-transition__caption"><span>Corporativo / Institucional</span><strong>Escala, uso e operação.</strong></div></a></section><section class="capabilities" aria-labelledby="cap-heading" data-motion-section><div data-motion-reveal><p class="kicker">02 / Capacidades</p><h2 id="cap-heading">Do projeto à intervenção técnica.</h2><p>Seis especialidades compõem a prática Royal.</p></div><ol>{caps.map((cap,i)=><li data-motion-reveal><span>{String(i+1).padStart(2,"0")}</span>{cap}</li>)}</ol></section><section class="proof-stage" aria-labelledby="proof-heading" data-motion-section><div data-motion-reveal><p class="kicker">03 / Execução real</p><h2 id="proof-heading">A matéria construída como prova.</h2><p>Fotografias de projetos realizados. Explore a galeria completa para ver contexto e execução.</p><a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">Ver Acervo</a></div><div class="proof-strip">{[proof1,proof2,proof3,proof4].map((image,i)=><img src={image.src} alt={`Evidência visual Royal Splash ${i+1}`} loading="lazy" data-motion-image/>)}</div></section><section class="method-stage" aria-labelledby="home-method" data-motion-section><div data-motion-reveal><p class="kicker">04 / Método Royal</p><h2 id="home-method">Clareza em cada passagem.</h2><p>Clareza técnica no percurso desde a primeira conversa até a entrega.</p></div><ol>{steps.map((step,i)=><li data-motion-reveal><span>{String(i+1).padStart(2,"0")}</span>{step}</li>)}</ol><a class="site-primitive-action site-primitive-action--tertiary" href="/metodo-royal" data-motion-reveal>Conhecer o método</a></section><section class="home-final" aria-labelledby="home-final" data-motion-final><p class="kicker" data-motion-reveal>Contato direto</p><h2 id="home-final" data-motion-reveal>Seu projeto começa com uma boa conversa.</h2><p data-motion-reveal>Fale diretamente com a Royal pelo canal que funciona para você.</p><a class="site-primitive-action site-primitive-action--primary" href="/inicie-seu-projeto" data-motion-reveal data-analytics-cta data-analytics-component="home_final_project_form" data-analytics-subject="project_start" data-analytics-channel="site_form">Fale com a Royal</a></section></div><ExperienceMotion slot="body-end" /></SiteLayout>
<style>.kicker{margin:0 0 1rem;color:#d9b746;font:600 .75rem/1.3 var(--site-font-ui);letter-spacing:.12em;text-transform:uppercase}.actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem}.cinematic-hero{position:relative;min-height:55svh;display:grid;align-items:end;overflow:hidden;background:#12171c;color:#fff}.cinematic-hero>video,.cinematic-hero__veil{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%}.cinematic-hero>video{filter:brightness(1.15) contrast(1.05) saturate(1.05)}.cinematic-hero__veil{background:linear-gradient(90deg,rgba(10,14,18,.80),rgba(10,14,18,.5) 44%,rgba(10,14,18,.05)),linear-gradient(0deg,rgba(10,14,18,.45),transparent 50%)}.cinematic-hero__content{position:relative;z-index:1;width:min(100% - 2 * var(--site-layout-gutter),var(--site-layout-content-max));margin:auto;padding-block:clamp(4rem,10vh,8rem) clamp(3rem,6vh,5rem)}.cinematic-hero h1{max-width:11ch;margin:0;font:500 clamp(4rem,8vw,7rem)/.88 var(--site-font-display)}.cinematic-hero__content>p:not(.kicker){max-width:40rem;font-size:1.1rem}.cinematic-hero .site-primitive-action--tertiary{color:#fff}.context-transition,.capabilities,.proof-stage,.method-stage,.home-final{padding:clamp(4rem,9vw,8rem) max(var(--site-layout-gutter),calc((100vw - var(--site-layout-content-max))/2))}.context-transition{display:grid;gap:1.5rem;background:#12171c;color:#fff}.context-transition__intro{grid-column:1/-1}.context-transition h2,.capabilities h2,.proof-stage h2,.method-stage h2,.home-final h2{max-width:15ch;margin:0;font:500 clamp(2.7rem,6vw,5rem)/.95 var(--site-font-display)}.context-transition>a{position:relative;min-height:24rem;overflow:hidden;color:#fff}.context-transition img{position:absolute;width:100%;height:100%;object-fit:cover;filter:brightness(.62);transition:transform .5s}.context-transition a:hover img{transform:scale(1.03)}.context-transition__caption{position:absolute;right:2rem;bottom:2rem;left:2rem;display:flex;flex-direction:column;align-items:flex-start;gap:.8rem}.context-transition a span{color:#d9b746;font:600 .75rem var(--site-font-ui);text-transform:uppercase}.context-transition a strong{font:500 1.8rem var(--site-font-display)}.capabilities .kicker,.method-stage .kicker{color:#6f5500}.capabilities{display:grid;gap:3rem;background:#faf9f6}.capabilities ol,.method-stage ol{list-style:none;margin:0;padding:0}.capabilities li,.method-stage li{display:flex;gap:1.5rem;padding:1.4rem 0;border-top:1px solid #d8d5cc;font:500 clamp(1.35rem,2.5vw,2rem) var(--site-font-display)}.capabilities li span,.method-stage li span{color:#6f5500;font:600 .7rem var(--site-font-ui)}.proof-stage{display:grid;gap:3rem;background:#12171c;color:#fff}.proof-stage p{max-width:36rem;color:rgba(255,255,255,.74)}.proof-stage .site-primitive-action--tertiary{color:#fff}.proof-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.proof-strip img{width:100%;height:28rem;object-fit:cover}.method-stage{display:grid;gap:3rem}.home-final{background:#12171c;color:#fff;border-top:3px solid #d9b746}.home-final p{max-width:38rem}.home-final a{margin-top:1rem}@media(min-width:48rem){.context-transition{grid-template-columns:repeat(2,1fr)}.capabilities,.proof-stage,.method-stage{grid-template-columns:.8fr 1.2fr}.method-stage>a{grid-column:2}}@media(max-width:47.99rem){.cinematic-hero{min-height:50svh}.cinematic-hero__veil{background:linear-gradient(0deg,rgba(10,14,18,.85) 8%,rgba(10,14,18,.35) 75%)}.cinematic-hero h1{font-size:clamp(3.5rem,17vw,5.3rem)}.context-transition>a{min-height:20rem}.proof-strip{grid-template-columns:repeat(2,1fr)}.proof-strip img{height:15rem}}@media(prefers-reduced-motion:reduce){.context-transition img{transition:none}.context-transition a:hover img{transform:none}}</style>
