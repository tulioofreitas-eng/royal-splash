---
import SegmentRouter from "../components/site/SegmentRouter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-home site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="home-section home-entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="home-heading"
    data-home-stage="entry"
  >
    <p class="home-eyebrow site-primitive-eyebrow site-primitive-supporting">
      Royal Splash
    </p>

    <h1 id="home-heading" class="site-primitive-page-title site-primitive-reading">
      Encontre o contexto certo para avançar.
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Escolha entre os contextos Residencial e Corporativo / Institucional,
      consulte Projetos e avance quando estiver pronto para iniciar seu projeto.
    </p>

    <div class="home-actions site-primitive-actions">
      <a
        class="home-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="home_entry"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
        Ver Projetos
      </a>
    </div>
  </section>

  <SegmentRouter />

  <section
    class="home-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="proof-heading"
    data-home-stage="proof"
  >
    <h2 id="proof-heading" class="site-primitive-section-title">
      Projetos
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Acesse a área de Projetos para consultar os projetos
      atualmente disponíveis.
    </p>

    <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
      Explorar Projetos
    </a>
  </section>

  <section
    class="home-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="method-trust-heading"
    data-home-stage="method-trust"
  >
    <h2 id="method-trust-heading" class="site-primitive-section-title">
      Método e confiança
    </h2>

    <div class="home-bridge-grid">
      <article class="site-primitive-datum-top">
        <h3 class="site-primitive-subtitle">Método Royal</h3>
        <p class="site-primitive-body site-primitive-supporting">
          Acesse a seção Método Royal e continue explorando
          os contextos de projeto.
        </p>
        <a class="site-primitive-action site-primitive-action--tertiary" href="/metodo-royal">
          Conhecer Método Royal
        </a>
      </article>

      <article class="site-primitive-datum-top">
        <h3 class="site-primitive-subtitle">A Royal</h3>
        <p class="site-primitive-body site-primitive-supporting">
          Acesse a seção A Royal e encontre caminhos para
          Projetos, Método Royal e contato.
        </p>
        <a class="site-primitive-action site-primitive-action--tertiary" href="/sobre">
          Conhecer A Royal
        </a>
      </article>
    </div>
  </section>

  <section
    class="home-section home-conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="conversion-heading"
    data-home-stage="qualified-action"
  >
    <h2 id="conversion-heading" class="site-primitive-section-title">
      Próximo passo
    </h2>

    <p class="site-primitive-body site-primitive-reading">
      Quando fizer sentido avançar, compartilhe informações
      sobre seu projeto e seus dados de contato.
    </p>

    <div class="home-actions site-primitive-actions">
      <a
        class="home-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="home_qualified_action"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/contato">
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .home-eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .home-entry .site-primitive-page-title,
  .home-section .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .home-section > p {
    margin-block: 0;
  }

  .home-bridge-grid {
    display: grid;
    gap: var(--site-space-6);
    margin-block-start: var(--site-space-6);
  }

  .home-bridge-grid article {
    padding-block-start: var(--site-space-5);
  }

  .home-bridge-grid .site-primitive-subtitle {
    margin-block: 0 var(--site-space-3);
  }

  .home-bridge-grid article p {
    margin-block: 0 var(--site-space-4);
  }

  .home-section > .site-primitive-action {
    margin-block-start: var(--site-space-6);
  }

  .home-conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
  }

  @media (min-width: 48rem) {
    .home-bridge-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .home-conversion {
      margin-block-end: var(--site-space-6);
      padding-inline: var(--site-space-5);
    }
  }
</style>
