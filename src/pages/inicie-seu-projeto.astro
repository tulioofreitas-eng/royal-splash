---
import SiteHeader from "../components/site/SiteHeader.astro";
import StructuredIntake from "../components/site/StructuredIntake.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Inicie seu projeto — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-intake site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="project-start project-start--entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="project-start-heading"
  >
    <h1
      id="project-start-heading"
      class="site-primitive-page-title site-primitive-reading"
    >
      Inicie seu projeto
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Compartilhe o contexto necessário para iniciar
      um envio estruturado pelo Site.
    </p>
  </section>

  <StructuredIntake />

  <section
    class="project-start project-start--auxiliary site-primitive-section site-primitive-datum-top"
    aria-labelledby="auxiliary-contact-heading"
  >
    <h2
      id="auxiliary-contact-heading"
      class="site-primitive-section-title"
    >
      Precisa de outro canal?
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Contato direto permanece disponível como caminho auxiliar.
    </p>

    <a
      class="site-primitive-action site-primitive-action--tertiary"
      href="/contato"
    >
      Ver canais de contato
    </a>
  </section>
</SiteLayout>

<style>
  .project-start--entry .site-primitive-page-title,
  .project-start--auxiliary .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .project-start p {
    margin-block: 0;
  }

  .project-start--auxiliary > .site-primitive-action {
    margin-block-start: var(--site-space-5);
  }
</style>
