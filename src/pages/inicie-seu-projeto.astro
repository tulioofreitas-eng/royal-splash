---
import SiteHeader from "../components/site/SiteHeader.astro";
import ProjectStartForm from "../components/site/ProjectStartForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/complete-experience.css";
---
<SiteLayout title="Inicie seu projeto — Royal Splash" robots="noindex, nofollow" bodyClass="site-primitive-page experience-page" visualMode="brand">
  <SiteHeader slot="header" visualMode="brand" />
  <section class="experience-entry" aria-labelledby="start-heading">
    <p class="experience-kicker">Inicie seu projeto</p>
    <h1 id="start-heading">Organize seu contexto para uma conversa mais útil.</h1>
    <p class="experience-lead">Preencha apenas o que já souber. Ao continuar, o WhatsApp abre com uma mensagem estruturada para você revisar e enviar.</p>
  </section>
  <ProjectStartForm />
</SiteLayout>
