---
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/brand-foundation.css";
---

<SiteLayout
  title="A Royal — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-about"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="trust-section trust-entry"
    aria-labelledby="trust-heading"
    data-trust-stage="entry"
  >
    <p class="trust-eyebrow">
      A Royal
    </p>

    <h1 id="trust-heading">
      A Royal
    </h1>

    <p>
      Encontre o contexto institucional disponível e siga
      para projetos, método e os próximos passos da experiência.
    </p>

    <div class="trust-actions">
      <a href="/projetos">
        Ver Projetos
      </a>

      <a href="/metodo-royal">
        Conhecer Método Royal
      </a>
    </div>
  </section>

  <section
    class="trust-section"
    aria-labelledby="institutional-context-heading"
    data-trust-stage="institutional-context"
  >
    <h2 id="institutional-context-heading">
      Contexto institucional
    </h2>

    <p>
      Informações institucionais devem ser publicadas a partir
      de fontes controladas. Nesta implementação funcional,
      métricas, histórico e demais afirmações que ainda dependam
      de comprovação versionada permanecem fora da superfície.
    </p>
  </section>

  <section
    class="trust-section"
    aria-labelledby="trust-references-heading"
    data-trust-stage="references"
  >
    <h2 id="trust-references-heading">
      Referências para sua avaliação
    </h2>

    <div class="trust-grid">
      <article>
        <h3>
          Projetos e evidências
        </h3>

        <p>
          Consulte a área de Projetos para acessar referências
          verificadas conforme estiverem disponíveis para publicação.
        </p>

        <a href="/projetos">
          Explorar Projetos
        </a>
      </article>

      <article>
        <h3>
          Método Royal
        </h3>

        <p>
          Consulte a estrutura de método disponível para compreender
          como o processo é apresentado na experiência digital.
        </p>

        <a href="/metodo-royal">
          Conhecer Método Royal
        </a>
      </article>

      <article>
        <h3>
          Conteúdo institucional controlado
        </h3>

        <p>
          História, métricas, abrangência, equipe e demais afirmações
          institucionais dependem de fonte controlada antes de sua
          publicação nesta superfície.
        </p>
      </article>
    </div>
  </section>

  <section
    class="trust-section trust-conversion"
    aria-labelledby="trust-action-heading"
    data-trust-stage="qualified-action"
  >
    <h2 id="trust-action-heading">
      Próximo passo
    </h2>

    <p>
      Se já houver contexto suficiente para avançar,
      use o fluxo estruturado do projeto.
    </p>

    <div class="trust-actions">
      <a
        class="trust-primary-action"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="royal_trust"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a href="/contato">
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  body.site-brand-about {
    margin: 0;
    background: var(--site-color-page-background);
    color: var(--site-color-text-primary);
    font-family: var(--site-font-text);
    font-size: var(--site-type-body);
    font-weight: var(--site-font-weight-text);
    line-height: var(--site-leading-body);
  }

  body.site-brand-about * {
    box-sizing: border-box;
  }

  body.site-brand-about a {
    color: inherit;
  }

  body.site-brand-about a:focus-visible {
    outline: 3px solid var(--site-color-required-boundary);
    outline-offset: 3px;
  }
</style>

<style>
  .trust-section {
    width: calc(100% - (2 * var(--site-layout-gutter)));
    max-width: var(--site-layout-content-max);
    margin-inline: auto;
    padding-block: var(--site-space-7);
  }

  .trust-entry {
    padding-block-start: var(--site-space-8);
    padding-block-end: var(--site-space-8);
  }

  .trust-section + .trust-section {
    border-block-start: 1px solid var(--site-color-divider);
  }

  .trust-eyebrow {
    margin-block: 0 var(--site-space-4);
    color: var(--site-color-text-secondary);
    font-family: var(--site-font-ui);
    font-size: var(--site-type-ui);
    font-weight: var(--site-font-weight-ui-strong);
    line-height: var(--site-leading-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: var(--site-layout-reading-max);
    margin-block: 0 var(--site-space-5);
    font-family: var(--site-font-display);
    font-size: var(--site-type-display-xl);
    font-weight: var(--site-font-weight-display);
    line-height: var(--site-leading-display);
  }

  h2 {
    margin-block: 0 var(--site-space-5);
    font-family: var(--site-font-text);
    font-size: var(--site-type-heading);
    font-weight: var(--site-font-weight-ui-strong);
    line-height: var(--site-leading-heading);
  }

  h3 {
    margin-block: 0 var(--site-space-3);
    font-family: var(--site-font-text);
    font-size: var(--site-type-body-lg);
    font-weight: var(--site-font-weight-ui-strong);
    line-height: var(--site-leading-heading);
  }

  .trust-section > p {
    max-width: var(--site-layout-reading-max);
    margin-block: 0;
    color: var(--site-color-text-secondary);
  }

  .trust-grid {
    display: grid;
    gap: var(--site-space-6);
    margin-block-start: var(--site-space-6);
  }

  .trust-grid article {
    padding-block-start: var(--site-space-5);
    border-block-start: 1px solid var(--site-color-divider);
  }

  .trust-grid article p {
    margin-block: 0 var(--site-space-4);
    color: var(--site-color-text-secondary);
  }

  .trust-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-4) var(--site-space-5);
    align-items: center;
    margin-block-start: var(--site-space-6);
  }

  .trust-actions a,
  .trust-grid a {
    display: inline-block;
    font-family: var(--site-font-ui);
    font-size: var(--site-type-ui);
    font-weight: var(--site-font-weight-ui-strong);
    line-height: var(--site-leading-ui);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
  }

  .trust-conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
    background: var(--site-color-surface-dark);
    color: var(--site-color-text-on-dark);
  }

  .trust-conversion > p {
    color: var(--site-color-text-on-dark);
  }

  .trust-conversion a:focus-visible {
    outline-color: var(--site-color-accent-on-dark);
  }

  .trust-primary-action {
    padding: var(--site-space-3) var(--site-space-4);
    border: 2px solid var(--site-color-accent-on-dark);
    color: var(--site-color-text-on-dark);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .trust-grid {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .trust-section {
      padding-block: var(--site-space-6);
    }

    .trust-entry {
      padding-block-start: var(--site-space-7);
      padding-block-end: var(--site-space-7);
    }

    .trust-conversion {
      margin-block-end: var(--site-space-6);
      padding-inline: var(--site-space-5);
    }
  }
</style>
