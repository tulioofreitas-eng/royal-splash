---
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import media from "../assets/sobre-equipe.jpg";
import "../styles/complete-experience.css";

const practice = [
  ["01", "Projeto", "Entendimento técnico de como a água se integra à arquitetura, com materiais e sistemas adequados ao contexto."],
  ["02", "Execução", "Construção acompanhada em suas fases, com atenção ao detalhe e presença técnica no canteiro."],
  ["03", "Relacionamento", "Conversa clara com cliente e arquiteto sobre escopo, cronograma, responsabilidades e próximos passos."],
];
---

<SiteLayout title="A Royal — Royal Splash" robots="noindex, nofollow" bodyClass="site-primitive-page experience-page" visualMode="brand">
  <SiteHeader slot="header" visualMode="brand" />

  <section class="experience-entry" aria-labelledby="about-heading" data-about-block="entry">
    <p class="experience-kicker">A Royal</p>
    <h1 id="about-heading">Engenharia de água para espaços que permanecem.</h1>
    <p class="experience-lead">Piscinas, lazer, sauna, proteção estrutural e acabamentos coordenados como parte da arquitetura residencial, corporativa e institucional.</p>
  </section>

  <section class="experience-section about-context" aria-labelledby="contexts-heading" data-about-block="photo-context">
    <div>
      <p class="experience-kicker">Contextos de trabalho</p>
      <h2 id="contexts-heading">Residencial e coletivo pedem leituras diferentes.</h2>
      <p>No residencial, piscina, sauna e lazer se integram ao projeto de habitar. Em espaços corporativos e institucionais, escala, circulação e intensidade de uso orientam a solução.</p>
      <p>Cada contexto recebe uma leitura técnica específica, sem perder a relação entre água, arquitetura e execução.</p>
    </div>
    <div class="experience-media">
      <img src={media.src} alt="Equipe Royal Splash em contexto de trabalho" />
      <span class="experience-media__veil"></span>
      <p class="experience-media__label">Royal Splash • Equipe</p>
    </div>
  </section>

  <section class="experience-section" aria-labelledby="practice-heading" data-about-block="practice">
    <div class="experience-section__intro about-editorial-pair">
      <p class="experience-kicker">Prática e identidade</p>
      <h2 id="practice-heading">Engenharia, execução e integração.</h2>
      <p>A Royal Splash trabalha na intersecção entre projeto, execução e relacionamento.</p>
    </div>
    <div class="experience-grid about-practice-grid">
      {practice.map(([number, heading, body]) => (
        <article class="experience-card">
          <span>{number}</span>
          <h3>{heading}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-section about-identity" aria-labelledby="identity-heading" data-about-block="identity">
    <div class="about-identity__content about-editorial-pair">
      <p class="experience-kicker">Identidade</p>
      <h2 id="identity-heading">A prática aparece no trabalho.</h2>
      <div class="about-identity__support">
        <p>Fotografia de projetos, capacidades técnicas concretas, documentação de escopo e contato direto mostram como a Royal atua hoje.</p>
        <div class="experience-links">
          <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">Ver Acervo</a>
          <a class="site-primitive-action site-primitive-action--tertiary" href="/metodo-royal">Ver Método Royal</a>
        </div>
      </div>
    </div>
  </section>

  <section class="experience-conversion" data-about-block="conversion">
    <p class="experience-kicker">Contato direto</p>
    <h2>Pronto para conversar?</h2>
    <p>Escolha o canal que funciona para você.</p>
    <a class="site-primitive-action site-primitive-action--primary" href="https://wa.me/5521982590643" target="_blank" rel="noopener noreferrer">Conversar no WhatsApp</a>
  </section>
</SiteLayout>

<style>
  .about-context {
    display: grid;
    gap: 2rem;
  }

  .about-context h2 {
    max-width: 14ch;
    margin: 0.3rem 0 1.5rem;
    font: 500 clamp(2.5rem, 5vw, 4rem) / 0.98 var(--site-font-display);
  }

  .about-context > div:first-child > p:not(.experience-kicker) {
    max-width: 38rem;
    color: var(--site-color-text-secondary);
  }

  .about-identity__support > p {
    max-width: 38rem;
    margin: 0;
    color: var(--site-color-text-secondary);
  }

  .about-editorial-pair {
    display: grid;
  }

  @media (min-width: 48rem) {
    .about-practice-grid > :last-child {
      grid-column: 1 / -1;
    }

    .about-context {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: center;
    }

    .about-editorial-pair {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
      column-gap: clamp(2rem, 6vw, 7rem);
      row-gap: 0.75rem;
      align-items: end;
    }

    .about-editorial-pair > .experience-kicker {
      grid-column: 1 / -1;
      margin-bottom: 0;
    }

    .about-editorial-pair > h2 {
      grid-column: 1;
    }

    .about-identity__content > h2 {
      margin-bottom: 0.35rem;
    }

    .about-editorial-pair > p,
    .about-editorial-pair > .about-identity__support {
      grid-column: 2;
      padding-bottom: 0.35rem;
    }

    .about-identity__content > .about-identity__support {
      padding-bottom: 0;
    }

  }

  @media (min-width: 64rem) {
    .about-practice-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-practice-grid > :last-child {
      grid-column: auto;
    }

  }
</style>
