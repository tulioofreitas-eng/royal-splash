---
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="A Royal — Royal Splash"
  robots="noindex, nofollow"
  bodyClass="site-brand-about site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="trust-section trust-entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="trust-heading"
    data-trust-stage="entry"
  >
    <p class="trust-eyebrow site-primitive-eyebrow site-primitive-supporting">
      A Royal
    </p>

    <h1
      id="trust-heading"
      class="site-primitive-page-title site-primitive-reading"
    >
      A Royal
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Acesse Projetos, Método Royal e os próximos passos
      disponíveis no site.
    </p>

    <div class="trust-actions site-primitive-actions">
      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/projetos"
      >
        Ver Projetos
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/metodo-royal"
      >
        Conhecer Método Royal
      </a>
    </div>
  </section>

  <section
    class="trust-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="institutional-context-heading"
    data-trust-stage="institutional-context"
  >
    <h2
      id="institutional-context-heading"
      class="site-primitive-section-title"
    >
      Contexto institucional
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Use os caminhos desta página para conhecer Projetos,
      Método Royal e as formas de iniciar um projeto.
    </p>
  </section>

  <section
    class="trust-section site-primitive-section site-primitive-datum-top"
    aria-labelledby="trust-references-heading"
    data-trust-stage="references"
  >
    <h2
      id="trust-references-heading"
      class="site-primitive-section-title"
    >
      Referências para sua avaliação
    </h2>

    <div class="trust-grid">
      <article class="site-primitive-datum-top">
        <h3 class="site-primitive-subtitle">
          Projetos
        </h3>

        <p class="site-primitive-body site-primitive-supporting">
          Consulte a área de Projetos para ver os projetos
          atualmente disponíveis.
        </p>

        <a
          class="site-primitive-action site-primitive-action--tertiary"
          href="/projetos"
        >
          Explorar Projetos
        </a>
      </article>

      <article class="site-primitive-datum-top">
        <h3 class="site-primitive-subtitle">
          Método Royal
        </h3>

        <p class="site-primitive-body site-primitive-supporting">
          Acesse a seção Método Royal e continue explorando
          os contextos de projeto.
        </p>

        <a
          class="site-primitive-action site-primitive-action--tertiary"
          href="/metodo-royal"
        >
          Conhecer Método Royal
        </a>
      </article>

      <article class="site-primitive-datum-top">
        <h3 class="site-primitive-subtitle">
          Próximos passos
        </h3>

        <p class="site-primitive-body site-primitive-supporting">
          Continue para Projetos, Método Royal ou para o início
          de um projeto usando os caminhos desta página.
        </p>
      </article>
    </div>
  </section>

  <section
    class="trust-section trust-conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="trust-action-heading"
    data-trust-stage="qualified-action"
  >
    <h2 id="trust-action-heading" class="site-primitive-section-title">
      Próximo passo
    </h2>

    <p class="site-primitive-body site-primitive-reading">
      Se estiver pronto para avançar, compartilhe informações
      sobre o projeto e seus dados de contato.
    </p>

    <div class="trust-actions site-primitive-actions">
      <a
        class="trust-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="royal_trust"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/contato"
      >
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .trust-eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .trust-entry .site-primitive-page-title {
    margin-block: 0 var(--site-space-5);
  }

  .trust-section .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .trust-grid .site-primitive-subtitle {
    margin-block: 0 var(--site-space-3);
  }

  .trust-section > p {
    margin-block: 0;
  }

  .trust-grid {
    display: grid;
    gap: var(--site-space-6);
    margin-block-start: var(--site-space-6);
  }

  .trust-grid article {
    padding-block-start: var(--site-space-5);
  }

  .trust-grid article p {
    margin-block: 0 var(--site-space-4);
  }

  .trust-conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
  }

  @media (min-width: 48rem) {
    .trust-grid {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .trust-conversion {
      margin-block-end: var(--site-space-6);
      padding-inline: var(--site-space-5);
    }
  }
</style>
