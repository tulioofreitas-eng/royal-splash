<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  const root = document.querySelector("[data-experience-motion]");

  if (root instanceof HTMLElement) {
    gsap.registerPlugin(ScrollTrigger);
    const mediaQuery = gsap.matchMedia();
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    root.dataset.motionPreference = reducedMotion.matches ? "reduced" : "full";
    root.dataset.motionEngine = "gsap-scrolltrigger";

    mediaQuery.add(
      {
        desktop: "(min-width: 768px) and (prefers-reduced-motion: no-preference)",
        mobile: "(max-width: 767px) and (prefers-reduced-motion: no-preference)",
        reduce: "(prefers-reduced-motion: reduce)",
      },
      (motionContext) => {
        const { desktop, mobile, reduce } = motionContext.conditions as {
          desktop: boolean;
          mobile: boolean;
          reduce: boolean;
        };

        if (reduce) {
          root.dataset.motionPreference = "reduced";
          gsap.set(root.querySelectorAll("[data-motion-reveal], [data-motion-media], [data-motion-image]"), { clearProps: "all" });
          return;
        }

        root.dataset.motionPreference = "full";
        root.dataset.motionReady = "true";

        const hero = root.querySelector<HTMLElement>("[data-motion-hero]");
        const heroMedia = root.querySelector<HTMLElement>("[data-motion-media='hero']");
        const heroVeil = root.querySelector<HTMLElement>("[data-motion-hero-veil]");
        const heroTitle = root.querySelector<HTMLElement>("[data-motion-hero-title]");
        const heroCopy = root.querySelector<HTMLElement>("[data-motion-hero-copy]");
        const heroActions = root.querySelector<HTMLElement>("[data-motion-hero-actions]");
        const heroKicker = hero?.querySelector<HTMLElement>(".kicker");
        const heroTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });

        if (heroMedia) heroTimeline.fromTo(heroMedia, { autoAlpha: 0, scale: desktop ? 1.075 : 1.035 }, { autoAlpha: 1, scale: 1, duration: desktop ? 1.45 : 0.8 });
        if (heroVeil) heroTimeline.fromTo(heroVeil, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.9 }, 0.08);
        if (heroKicker) heroTimeline.fromTo(heroKicker, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.55 }, 0.28);
        if (heroTitle) heroTimeline.fromTo(heroTitle, { opacity: 0, yPercent: mobile ? 14 : 20 }, { opacity: 1, yPercent: 0, duration: mobile ? 0.72 : 0.95 }, 0.36);
        if (heroCopy) heroTimeline.fromTo(heroCopy, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.65 }, 0.56);
        if (heroActions) heroTimeline.fromTo(heroActions, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 0.68);

        if (desktop && hero && heroMedia) {
          gsap.to(heroMedia, {
            yPercent: 5,
            scale: 1.025,
            ease: "none",
            scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.7 },
          });
        }

        root.querySelectorAll<HTMLElement>("[data-motion-section]").forEach((section) => {
          const editorial = section.querySelectorAll<HTMLElement>("[data-motion-reveal]");
          if (editorial.length) {
            gsap.fromTo(editorial, { y: mobile ? 16 : 28 }, {
              y: 0,
              duration: mobile ? 0.55 : 0.78,
              stagger: mobile ? 0.045 : 0.075,
              ease: "power3.out",
              clearProps: "transform",
              scrollTrigger: { trigger: section, start: mobile ? "top 91%" : "top 82%", once: true },
            });
          }

          const media = section.querySelectorAll<HTMLElement>("[data-motion-image]");
          if (media.length) {
            gsap.fromTo(media, { autoAlpha: 0, scale: mobile ? 1.015 : 1.045, clipPath: "inset(0 0 12% 0)" }, {
              autoAlpha: 1,
              scale: 1,
              clipPath: "inset(0 0 0% 0)",
              duration: mobile ? 0.62 : 0.95,
              stagger: mobile ? 0.05 : 0.09,
              ease: "power2.out",
              scrollTrigger: { trigger: section, start: mobile ? "top 90%" : "top 79%", once: true },
            });
          }
        });

        const finalSection = root.querySelector<HTMLElement>("[data-motion-final]");
        if (finalSection) {
          gsap.fromTo(finalSection.querySelectorAll<HTMLElement>("[data-motion-reveal]"), { y: mobile ? 16 : 24 }, {
            y: 0,
            duration: mobile ? 0.55 : 0.75,
            stagger: 0.08,
            ease: "power3.out",
            scrollTrigger: { trigger: finalSection, start: "top 86%", once: true },
          });
        }

        ScrollTrigger.refresh();
      },
    );

    window.addEventListener("pagehide", () => mediaQuery.revert(), { once: true });
  }
</script>
