---
// BotaoWhatsapp — Botão flutuante contextualizado por LP
// Recebe serviceIntent (MAJOR_RENOVATION | POOL_CONSTRUCTION | FIBERGLASS_POOL_RESTORATION | POOL_LEAK_DETECTION)
// Usa whatsapp-composer.ts para mensagens contextualizadas
// Emite whatsapp_click com service_intent

export interface Props {
  serviceIntent?: "MAJOR_RENOVATION" | "POOL_CONSTRUCTION" | "FIBERGLASS_POOL_RESTORATION" | "POOL_LEAK_DETECTION";
  ctaSurface?: "floating_button";
}

const { serviceIntent, ctaSurface = "floating_button" } = Astro.props;
---
<button
  type="button"
  id="btn-abrir-whatsapp"
  aria-label="Falar no WhatsApp"
  data-service-intent={serviceIntent}
  data-cta-surface={ctaSurface}
  style="position:fixed; bottom:24px; right:24px; z-index:9999; display:inline-flex; align-items:center; gap:8px; background:#22c55e; color:#fff; font-weight:600; padding:14px 22px; border-radius:9999px; box-shadow:0 4px 16px rgba(0,0,0,0.4); border:none; cursor:pointer;"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05.088C5.495.088.088 5.495.085 12.05a11.86 11.86 0 001.588 5.945L.088 23.911l5.938-1.557a11.89 11.89 0 005.694 1.451h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.483-8.413z"/></svg>
  <span>WhatsApp</span>
</button>

<div id="whatsapp-modal" style="display:none; position:fixed; inset:0; z-index:10000; background:rgba(0,0,0,0.7); align-items:center; justify-content:center; padding:16px;">
  <div style="background:#0B1D2E; border:1px solid rgba(255,255,255,0.15); border-radius:16px; padding:24px; max-width:400px; width:100%;">
    <h3 style="color:#fff; font-size:1.25rem; font-weight:600; margin-bottom:16px;">Antes de conversar...</h3>
    <div style="margin-bottom:12px;">
      <label for="wa-nome" style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:4px;">Nome</label>
      <input type="text" id="wa-nome" style="width:100%; background:#0B1D2E; border:1px solid rgba(255,255,255,0.15); border-radius:8px; padding:10px 14px; color:#fff;" placeholder="Seu nome" />
    </div>
    <div style="margin-bottom:12px;">
      <label for="wa-telefone" style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:4px;">Telefone</label>
      <input type="tel" id="wa-telefone" style="width:100%; background:#0B1D2E; border:1px solid rgba(255,255,255,0.15); border-radius:8px; padding:10px 14px; color:#fff;" placeholder="(00) 00000-0000" />
    </div>
    <div style="display:flex; align-items:flex-start; gap:10px; margin-bottom:16px;">
  <input type="checkbox" id="wa-consentimento" required style="margin-top:4px; accent-color:#38BDF8; cursor:pointer; flex-shrink:0;" />
  <label for="wa-consentimento" style="font-size:0.8rem; color:#94a3b8; line-height:1.4; cursor:pointer;">
    Li e concordo com a <a href="/politica-de-privacidade" target="_blank" rel="noopener" style="color:#38BDF8;">Política de Privacidade</a> e autorizo o contato da Royal Splash.
  </label>
</div>
    <div style="display:flex; gap:10px;">
      <button type="button" id="wa-cancelar" style="flex:1; background:transparent; border:1px solid rgba(255,255,255,0.2); color:#94a3b8; padding:12px; border-radius:9999px; cursor:pointer;">Cancelar</button>
      <button type="button" id="wa-enviar" style="flex:2; background:#22c55e; border:none; color:#fff; font-weight:600; padding:12px; border-radius:9999px; cursor:pointer;">Continuar no WhatsApp</button>
    </div>
  </div>
</div>

<script>
  import {
    buildReformaWhatsAppUrl,
    buildPiscinasRJWhatsAppUrl,
    buildFibraWhatsAppUrl,
    buildVazamentoWhatsAppUrl,
    type ReformaProjectContext,
    type PiscinasRJProjectContext,
    type FibraProjectContext,
    type VazamentoProjectContext,
  } from "../utils/whatsapp-composer.ts";
  import { observeSubmissionTouch } from "../growth/attribution.ts";
  import { emitIntakeCreatedOnce } from "../growth/emitIntakeCreatedOnce.ts";
  import { getMeasurementRequestHeaders } from "../privacy/measurement-request.ts";

  const MODAL_ATIVO = true;
  const NUMERO_WHATSAPP = '5521982590643';
  const botoesAbrir = document.querySelectorAll('#btn-abrir-whatsapp, .abrir-whatsapp-modal');
  const modal = document.getElementById('whatsapp-modal')!;
  const btnCancelar = document.getElementById('wa-cancelar')!;
  const btnEnviar = document.getElementById('wa-enviar')!;

  interface WhatsAppEventWindow extends Window {
    __royalWhatsAppClickEventLastEmittedAt?: number;
    __royalMeasurementConsent?: {
      get?: () => {
        marketing?: boolean;
      } | null;
    };
    dataLayer?: unknown[];
  }

  const DUPLICATE_EVENT_WINDOW_MS = 500;

  function marketingMeasurementAllowed(w: WhatsAppEventWindow) {
    const runtime = w.__royalMeasurementConsent;
    if (!runtime) return true;
    return runtime.get?.()?.marketing === true;
  }

  function emitWhatsAppClickEvent(serviceIntent?: string, ctaSurface?: string) {
    const w = window as WhatsAppEventWindow;
    const now = Date.now();
    const last = w.__royalWhatsAppClickEventLastEmittedAt;
    if (last !== undefined && now - last < DUPLICATE_EVENT_WINDOW_MS) return;
    w.__royalWhatsAppClickEventLastEmittedAt = now;

    if (!marketingMeasurementAllowed(w)) return;

    w.dataLayer = w.dataLayer || [];
    const eventPayload: any = { event: 'whatsapp_click' };

    if (serviceIntent) eventPayload.service_intent = serviceIntent;
    if (ctaSurface) eventPayload.cta_surface = ctaSurface;
    eventPayload.acquisition_geography = "RJ";
    eventPayload.entry_surface = window.location.pathname;

    w.dataLayer.push(eventPayload);
  }

  function registrarClique() {
    const btn = document.getElementById('btn-abrir-whatsapp');
    const serviceIntent = btn?.getAttribute('data-service-intent');
    const ctaSurface = btn?.getAttribute('data-cta-surface');

    emitWhatsAppClickEvent(serviceIntent || undefined, ctaSurface || undefined);

    fetch('/api/whatsapp-click', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pagina: window.location.pathname }),
    }).catch(() => {});
  }

  function buildContextualWhatsAppUrl(userName = "Visitante"): string {
    const btn = document.getElementById('btn-abrir-whatsapp');
    const serviceIntent = btn?.getAttribute('data-service-intent');

    switch (serviceIntent) {
      case 'MAJOR_RENOVATION': {
        const context: ReformaProjectContext = { nome: userName };
        return buildReformaWhatsAppUrl(context);
      }
      case 'POOL_CONSTRUCTION': {
        const context: PiscinasRJProjectContext = { nome: userName };
        return buildPiscinasRJWhatsAppUrl(context);
      }
      case 'FIBERGLASS_POOL_RESTORATION': {
        const context: FibraProjectContext = { nome: userName };
        return buildFibraWhatsAppUrl(context);
      }
      case 'POOL_LEAK_DETECTION': {
        const context: VazamentoProjectContext = { nome: userName };
        return buildVazamentoWhatsAppUrl(context);
      }
      default:
        return `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent('Olá! Tenho interesse em um orçamento.')}`;
    }
  }

  botoesAbrir.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();

      const serviceIntent = btn.getAttribute('data-service-intent');

      if (!MODAL_ATIVO || !serviceIntent) {
        registrarClique();
        const url = buildContextualWhatsAppUrl();
        window.open(url, '_blank');
        return;
      }

      modal.style.display = 'flex';
      (document.getElementById('wa-nome') as HTMLInputElement | null)?.focus();
    });
  });

  btnCancelar.addEventListener('click', () => {
    modal.style.display = 'none';
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });

  const intakeMetadataByIntent: Record<string, {
    experiment_id: string;
  }> = {
    MAJOR_RENOVATION: { experiment_id: "HV-RJ-MAJOR-RENOVATION" },
    POOL_CONSTRUCTION: { experiment_id: "HV-RJ-POOL-CONSTRUCTION" },
    FIBERGLASS_POOL_RESTORATION: { experiment_id: "HV-RJ-FIBERGLASS-RESTORATION" },
    POOL_LEAK_DETECTION: { experiment_id: "HV-RJ-POOL-LEAK-DETECTION" },
  };

  function submitMinimalWhatsAppIntake(
    nome: string,
    telefone: string,
    serviceIntent: string,
    pageRef: string,
  ): void {
    const submissionRef = `RS-whatsapp-${crypto.randomUUID()}`;
    const runtime = (window as any).__royalGrowthAttribution;
    runtime?.persistAfterConsent?.();
    const firstTouch = runtime?.readPersisted?.();
    const submissionTouch = observeSubmissionTouch(new URL(window.location.href));

    const payload: any = {
      submissionRef,
      consentCapturedAt: new Date().toISOString(),
      projectContext: "residencial",
      name: nome,
      phone: telefone,
      consent: true,
      source: "site",
      pageRef,
    };

    if (firstTouch || submissionTouch) {
      payload.attribution = {};
      if (firstTouch) payload.attribution.firstTouch = firstTouch;
      if (submissionTouch) payload.attribution.submissionTouch = submissionTouch;
    }

    fetch('/api/site-lead', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...getMeasurementRequestHeaders(window),
      },
      body: JSON.stringify(payload),
      keepalive: true,
    })
      .then(async (response) => {
        if (!response.ok) return;
        const receipt = await response.json();
        if (receipt?.replay === true) return;

        const metadata = intakeMetadataByIntent[serviceIntent];
        if (!metadata) return;

        emitIntakeCreatedOnce(submissionRef, {
          service_intent: serviceIntent,
          acquisition_geography: "RJ",
          experiment_id: metadata.experiment_id,
          entry_surface: pageRef,
          has_attachments: false,
        });
      })
      .catch(() => {
        // O registro é best-effort e nunca deve bloquear a ida ao WhatsApp.
      });
  }

  btnEnviar.addEventListener('click', () => {
    const nome = (document.getElementById('wa-nome') as HTMLInputElement).value.trim();
    const telefone = (document.getElementById('wa-telefone') as HTMLInputElement).value.trim();
    const consentimento = (document.getElementById('wa-consentimento') as HTMLInputElement).checked;

    if (!consentimento) {
      alert('Por favor, confirme que leu a Política de Privacidade.');
      return;
    }
    if (!nome || !telefone) {
      alert('Por favor, preencha nome e telefone.');
      return;
    }

    const btn = document.getElementById('btn-abrir-whatsapp');
    const serviceIntent = btn?.getAttribute('data-service-intent');
    const pageRef = window.location.pathname;

    if (serviceIntent) {
      submitMinimalWhatsAppIntake(nome, telefone, serviceIntent, pageRef);
    }

    registrarClique();
    const url = buildContextualWhatsAppUrl(nome);
    window.open(url, '_blank');
    modal.style.display = 'none';
  });
</script>
