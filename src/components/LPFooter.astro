---
interface Props {
  visualMode?: "functional" | "brand";
}

const { visualMode = "functional" } = Astro.props;
---
<footer class="py-8 px-6 text-center border-t border-white/10 mt-16" data-lp-footer-visual={visualMode}>
  <p class="text-sm text-slate-500 mt-3">© 2026 Royal Splash. Todos os direitos reservados.</p>
  <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
  <a href="https://wa.me/5521982590643" class="hover:text-piscina transition-colors">WhatsApp</a>
  <span class="text-slate-700">·</span>
  <a href="mailto:contato@royalsplash.com.br" class="hover:text-piscina transition-colors">contato@royalsplash.com.br</a>
  <span class="text-slate-700">·</span>
  <a href="/politica-de-privacidade" class="hover:text-piscina transition-colors">Política de Privacidade</a>
</p>
</footer>

<style>
  [data-lp-footer-visual="brand"] {
    margin-block-start: 0;
    border-color: var(--site-color-divider);
    background: var(--site-color-surface-dark);
    color: var(--site-color-text-on-dark);
    font-family: var(--site-font-ui);
  }

  [data-lp-footer-visual="brand"] :global(p),
  [data-lp-footer-visual="brand"] :global(a),
  [data-lp-footer-visual="brand"] :global(span) {
    color: inherit;
  }

  [data-lp-footer-visual="brand"] :global(a:focus-visible) {
    outline: 3px solid var(--site-color-accent-on-dark);
    outline-offset: 3px;
  }
</style>
