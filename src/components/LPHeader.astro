---
interface Props {
  visualMode?: "functional" | "brand";
}

const { visualMode = "functional" } = Astro.props;
---
<header class="py-6 px-6 text-center" data-lp-header-visual={visualMode}>
  <a href="/" aria-label={visualMode === "brand" ? "Royal Splash — Início" : undefined} class="inline-flex items-center gap-2 text-white hover:opacity-80 transition-opacity">
    {visualMode === "brand" ? (
      <img src="/brand/identity/signatures/royal-splash-signature-h1-gold.svg" alt="" aria-hidden="true" class="lp-brand-signature" />
    ) : (
      <>
        <img src="/logo.png" alt="" class="h-8 w-8" />
        <span class="text-lg font-semibold tracking-wide">ROYAL SPLASH</span>
      </>
    )}
  </a>
</header>

<script>
  const matchLp = window.location.pathname.match(/\/lp\/([^/?#]+)/);
  if (matchLp) {
    try {
      document.cookie = `mtm_campanha=lp-${matchLp[1]}; path=/; max-age=300; SameSite=Lax`;
    } catch {}
  }
</script>

<style>
  [data-lp-header-visual="brand"] {
    background: var(--site-color-surface-dark);
    border-block-end: 1px solid var(--site-color-divider);
  }

  [data-lp-header-visual="brand"] a:focus-visible {
    outline: 3px solid var(--site-color-accent-on-dark);
    outline-offset: 4px;
  }

  .lp-brand-signature {
    display: block;
    width: min(13rem, 70vw);
    height: auto;
  }
</style>
