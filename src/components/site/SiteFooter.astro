---
const navigationItems = [
  { href: "/", label: "Início" },
  { href: "/projetos", label: "Projetos" },
  { href: "/servicos", label: "Residencial" },
  { href: "/corporativo", label: "Corporativo / Institucional" },
  { href: "/metodo-royal", label: "Método Royal" },
  { href: "/sobre", label: "A Royal" },
  { href: "/inicie-seu-projeto", label: "Inicie seu projeto" },
  { href: "/contato", label: "Contato" },
  { href: "/politica-de-privacidade", label: "Política de Privacidade" },
] as const;
---

<footer class="site-footer" data-site-footer>
  <div class="site-footer__inner">
    <a class="site-footer__identity" href="/" aria-label="Royal Splash — Início">
      <img
        src="/brand/identity/signatures/royal-splash-signature-h1-gold.svg"
        alt=""
        aria-hidden="true"
      />
    </a>

    <nav class="site-footer__navigation" aria-label="Navegação do rodapé">
      {
        navigationItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
    <p class="site-footer__relationship">Royal Splash • parte do MTM Group</p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-block-start: 1px solid var(--site-color-divider);
    background: var(--site-color-surface-dark);
    color: var(--site-color-text-on-dark);
    font-family: var(--site-font-ui);
  }

  .site-footer__inner {
    width: calc(100% - (2 * var(--site-layout-gutter)));
    max-width: var(--site-layout-content-max);
    margin-inline: auto;
    padding-block: var(--site-space-7);
  }

  .site-footer__identity {
    display: inline-flex;
    max-width: 100%;
  }

  .site-footer__identity img {
    display: block;
    width: auto;
    max-width: min(100%, 15rem);
    height: 3rem;
  }

  .site-footer__navigation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--site-space-3) var(--site-space-6);
    margin-block-start: var(--site-space-6);
  }

  .site-footer__relationship {
    margin: var(--site-space-6) 0 0;
    color: var(--site-color-text-secondary-on-dark, rgba(255,255,255,.65));
    font-size: .75rem;
    letter-spacing: .06em;
  }

  .site-footer a {
    color: var(--site-color-text-on-dark);
    font-size: var(--site-type-ui);
    font-weight: var(--site-font-weight-ui);
    line-height: var(--site-leading-ui);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
  }

  .site-footer__navigation a {
    width: fit-content;
    max-width: 100%;
  }

  .site-footer a:hover {
    text-decoration-line: underline;
  }

  .site-footer a:focus-visible {
    outline: 3px solid var(--site-color-accent-on-dark);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      padding-block: var(--site-space-6);
    }

    .site-footer__navigation {
      grid-template-columns: 1fr;
      gap: var(--site-space-4);
      margin-block-start: var(--site-space-5);
    }
  }
</style>
