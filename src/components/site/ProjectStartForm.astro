<section class="project-start" aria-labelledby="project-form-heading">
  <form data-project-start-form novalidate>
    <fieldset>
      <legend id="project-form-heading">Forme o contexto da conversa</legend>
      <p class="project-start__required"><span aria-hidden="true">*</span> Campos obrigatórios</p>
      <div class="project-start__summary" data-error-summary role="alert" tabindex="-1" hidden></div>

      <div class="project-start__field">
        <label for="project-name"><span>01</span> Nome <b aria-hidden="true">*</b></label>
        <p id="project-name-help">Como você prefere ser chamado?</p>
        <input id="project-name" name="nome" type="text" minlength="2" maxlength="100" autocomplete="name" placeholder="ex: João" aria-describedby="project-name-help project-name-error" required />
        <p id="project-name-error" class="project-start__error" data-error-for="nome"></p>
      </div>

      <div class="project-start__field">
        <label for="project-type"><span>02</span> Tipo de projeto <b aria-hidden="true">*</b></label>
        <p id="project-type-help">Residencial ou corporativo / institucional?</p>
        <select id="project-type" name="tipo_projeto" aria-describedby="project-type-help project-type-error" required>
          <option value="">Selecione</option>
          <option value="residencial">Residencial (piscina, sauna, lazer, reforma)</option>
          <option value="corporativo">Corporativo / Institucional</option>
        </select>
        <p id="project-type-error" class="project-start__error" data-error-for="tipo_projeto"></p>
      </div>

            <div class="project-start__field">
        <label for="project-city"><span>03</span> Cidade / Localização <b aria-hidden="true">*</b></label>
        <p id="project-city-help">Onde o projeto será realizado?</p>
        <input id="project-city" name="cidade" type="text" minlength="2" maxlength="100" autocomplete="address-level2" placeholder="ex: Rio de Janeiro" aria-describedby="project-city-help project-city-error" required />
        <p id="project-city-error" class="project-start__error" data-error-for="cidade"></p>
      </div>

      <div class="project-start__field">
        <label for="project-scale"><span>04</span> Escala aproximada <small>Opcional</small></label>
        <p id="project-scale-help">O que seu projeto envolve? Qual o tamanho aproximado?</p>
        <textarea id="project-scale" name="escala" maxlength="200" rows="4" placeholder="ex: Piscina 5x10m + deck + sauna" aria-describedby="project-scale-help project-scale-count project-scale-error"></textarea>
        <p id="project-scale-error" class="project-start__error" data-error-for="escala"></p>
        <output id="project-scale-count" for="project-scale">0 / 200 caracteres</output>
      </div>

      <div class="project-start__field">
        <label for="project-timeline"><span>05</span> Prazo <small>Opcional</small></label>
        <p id="project-timeline-help">Quando espera começar?</p>
        <select id="project-timeline" name="prazo" aria-describedby="project-timeline-help">
          <option value="">Selecione se já souber</option>
          <option value="urgente">Urgente (próximas semanas)</option>
          <option value="proximos_meses">Próximos meses</option>
          <option value="aberto">Aberto (sem pressa definida)</option>
        </select>
      </div>

      <div class="project-start__field">
        <label for="project-question"><span>06</span> Questão específica <small>Opcional</small></label>
        <p id="project-question-help">Há algo crítico ou algum desafio que precisa resolver?</p>
        <textarea id="project-question" name="questao" maxlength="300" rows="4" placeholder="ex: Vazamento em piscina existente" aria-describedby="project-question-help project-question-count project-question-error"></textarea>
        <p id="project-question-error" class="project-start__error" data-error-for="questao"></p>
        <output id="project-question-count" for="project-question">0 / 300 caracteres</output>
      </div>

            <div class="project-start__field">
        <label for="project-email"><span>07</span> E-mail</label>
        <p id="project-email-help">Obrigatório se não fornecer telefone.</p>
        <input id="project-email" name="email" type="email" autocomplete="email" placeholder="ex: seu@email.com" aria-describedby="project-email-help project-email-error" />
        <p id="project-email-error" class="project-start__error" data-error-for="email"></p>
      </div>

      <div class="project-start__field">
        <label for="project-phone"><span>08</span> Telefone / WhatsApp</label>
        <p id="project-phone-help">Obrigatório se não fornecer e-mail.</p>
        <input id="project-phone" name="telefone" type="tel" autocomplete="tel" placeholder="ex: 21 99999-9999" aria-describedby="project-phone-help project-phone-error" />
        <p id="project-phone-error" class="project-start__error" data-error-for="telefone"></p>
      </div>

      <div class="project-start__consent">
        <input id="project-consent" name="consentimento" type="checkbox" aria-describedby="project-consent-error" required />
                <label for="project-consent">Autorizo o envio destas informações à Royal Splash, que serão registradas (Intake) para recebimento, análise e resposta ao meu projeto. O e-mail e/ou telefone fornecidos poderão ser usados para esse retorno. Continuar pelo WhatsApp após o envio é opcional. Concordo com a <a href="/politica-de-privacidade" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.</label>
        <p id="project-consent-error" class="project-start__error" data-error-for="consentimento"></p>
      </div>

      <button class="site-primitive-action site-primitive-action--primary" type="submit">Enviar contexto do projeto</button>
      <a class="project-start__back" href="/contato">Prefiro outro canal</a>
    </fieldset>
  </form>

    <div class="project-start__privacy" aria-labelledby="privacy-heading">
    <p class="experience-kicker">Privacidade</p>
    <h2 id="privacy-heading">Transparência no contato.</h2>
    <p>Suas informações são enviadas de forma segura para a Royal Splash. O envio pelo WhatsApp após a submissão é opcional e serve para agilizar o atendimento.</p>
    <a href="/politica-de-privacidade">Leia a Política de Privacidade</a>
  </div>

    <div class="project-start__fallback" data-whatsapp-fallback role="status" tabindex="-1" hidden>
    <h2>Informações recebidas com sucesso.</h2>
    <p>Sua solicitação foi registrada. Se desejar agilizar o atendimento, você pode continuar a conversa pelo WhatsApp agora mesmo.</p>
    <button type="button" class="site-primitive-action site-primitive-action--primary" data-open-whatsapp style="margin-bottom: 1rem;">Continuar pelo WhatsApp</button>
    <p data-copy-status></p>
    <button type="button" data-copy-context>Copiar contexto</button>
    <p style="margin-top: 1rem;">Ou fale por <a href="mailto:contato@royalsplash.com.br">e-mail</a>, <a href="tel:+5521982590643">telefone</a> ou <a href="https://instagram.com/royalsplashoficial" target="_blank" rel="noopener noreferrer">Instagram</a>.</p>
  </div>
</section>

<script>
  import { buildProjectWhatsAppUrl, composeProjectMessage, type ProjectContext } from "../../utils/whatsapp-composer.ts";

  interface FormAnalyticsWindow extends Window { __projectFormAnalyticsEvents?: Array<Record<string, unknown>> }
  const form = document.querySelector<HTMLFormElement>("[data-project-start-form]");
  const analyticsWindow = window as FormAnalyticsWindow;
  analyticsWindow.__projectFormAnalyticsEvents ??= [];
  const track = (eventName: string, metadata: Record<string, string | number> = {}) => {
    const detail = { eventName, component: "project_start_form", eventSource: "inicie_seu_projeto", ...metadata };
    analyticsWindow.__projectFormAnalyticsEvents?.push(detail);
    window.dispatchEvent(new CustomEvent("site:project-form-analytics", { detail }));
  };

  if (form) {
    const fields = {
      nome: form.elements.namedItem("nome") as HTMLInputElement,
      tipo: form.elements.namedItem("tipo_projeto") as HTMLSelectElement,
      cidade: form.elements.namedItem("cidade") as HTMLInputElement,
      escala: form.elements.namedItem("escala") as HTMLTextAreaElement,
      prazo: form.elements.namedItem("prazo") as HTMLSelectElement,
      questao: form.elements.namedItem("questao") as HTMLTextAreaElement,
      email: form.elements.namedItem("email") as HTMLInputElement,
      telefone: form.elements.namedItem("telefone") as HTMLInputElement,
      consentimento: form.elements.namedItem("consentimento") as HTMLInputElement,
    };
    let started = false;
    let lastMessage = "";

    const setError = (name: string, message = "") => {
      const field = fields[name as keyof typeof fields];
      const target = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (target) target.textContent = message;
      field?.setAttribute("aria-invalid", message ? "true" : "false");
    };
    const validate = () => {
      Object.keys(fields).forEach((name) => setError(name));
      const errors: Array<{name: string; message: string; type: string}> = [];
      const nome = fields.nome.value.trim();
      const cidade = fields.cidade.value.trim();
      const email = fields.email.value.trim();
      const telefone = fields.telefone.value.trim();
      
      if (!nome) errors.push({ name: "nome", message: "Este campo é obrigatório", type: "required" });
      else if (nome.length < 2) errors.push({ name: "nome", message: "Nome deve ter pelo menos 2 caracteres", type: "min_length" });
      
      if (!fields.tipo.value) errors.push({ name: "tipo_projeto", message: "Este campo é obrigatório", type: "required" });
      if (!cidade) errors.push({ name: "cidade", message: "Este campo é obrigatório", type: "required" });
      
      if (!email && !telefone) {
        errors.push({ name: "email", message: "Informe e-mail ou telefone", type: "required" });
        errors.push({ name: "telefone", message: "Informe e-mail ou telefone", type: "required" });
      } else if (email && (!email.includes("@") || !email.includes("."))) {
        errors.push({ name: "email", message: "E-mail inválido", type: "format" });
      }
      
      if (!fields.consentimento.checked) errors.push({ name: "consentimento", message: "Você deve aceitar antes de continuar", type: "required" });
      
      errors.forEach((error) => { setError(error.name, error.message); track("form_validation_error", { field: error.name, errorType: error.type }); });
      const summary = form.querySelector<HTMLElement>("[data-error-summary]");
      if (summary) {
        summary.hidden = errors.length === 0;
        summary.textContent = errors.length ? `Revise ${errors.length === 1 ? "o campo indicado" : "os campos indicados"}.` : "";
      }
      if (errors.length) fields[errors[0].name as keyof typeof fields]?.focus();
      return errors.length === 0;
    };
    const updateCount = (field: HTMLTextAreaElement, outputId: string) => {
      const output = document.getElementById(outputId);
      if (output) output.textContent = `${field.value.length} / ${field.maxLength} caracteres`;
    };

    form.addEventListener("focusin", (event) => {
      const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (!started) { started = true; track("form_start"); }
      if (target.name && target.name !== "consentimento") track("form_field_focus", { field: target.name });
    });
    fields.escala.addEventListener("input", () => updateCount(fields.escala, "project-scale-count"));
    fields.questao.addEventListener("input", () => updateCount(fields.questao, "project-question-count"));
    fields.nome.addEventListener("blur", () => { const value = fields.nome.value.trim(); setError("nome", value && value.length < 2 ? "Nome deve ter pelo menos 2 caracteres" : ""); });
    
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validate()) return;
      
      const summary = form.querySelector<HTMLElement>("[data-error-summary]");
      if (summary) summary.hidden = true;

      const context: ProjectContext = { nome: fields.nome.value, tipoProjeto: fields.tipo.value as ProjectContext["tipoProjeto"], escala: fields.escala.value, prazo: fields.prazo.value as ProjectContext["prazo"], questao: fields.questao.value };
      lastMessage = composeProjectMessage(context);
      
      let mappedContext = fields.tipo.value;
      if (mappedContext === "corporativo") mappedContext = "corporativo_institucional";
      
      const projectNeedParts = [];
      if (fields.escala.value) projectNeedParts.push(`Escala: ${fields.escala.value}`);
      if (fields.prazo.value) projectNeedParts.push(`Prazo: ${fields.prazo.value}`);
      if (fields.questao.value) projectNeedParts.push(`Questão: ${fields.questao.value}`);
      const projectNeed = projectNeedParts.join(". ") || "Não especificado";

      const payload = {
        submissionRef: crypto.randomUUID(),
        consentCapturedAt: new Date().toISOString(),
        projectContext: mappedContext,
        projectNeed: projectNeed,
        city: fields.cidade.value,
        name: fields.nome.value,
        email: fields.email.value || undefined,
        phone: fields.telefone.value || undefined,
        consent: fields.consentimento.checked,
        pageRef: "/inicie-seu-projeto",
      };

      try {
        const response = await fetch("/api/site-lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload)
        });
        
        if (!response.ok) throw new Error("Submission failed");
        
        const fallback = document.querySelector<HTMLElement>("[data-whatsapp-fallback]");
        if (fallback) { 
          fallback.hidden = false; 
          fallback.focus(); 
          const waBtn = fallback.querySelector("[data-open-whatsapp]");
          if (waBtn) {
            waBtn.addEventListener("click", () => {
              window.open(buildProjectWhatsAppUrl(context), "_blank", "noopener,noreferrer");
            });
          }
        }
        form.hidden = true;
      } catch (e) {
        if (summary) {
          summary.hidden = false;
          summary.textContent = "Não foi possível enviar as informações no momento. Tente novamente ou use os canais diretos.";
        }
      }
    });
    document.querySelector<HTMLButtonElement>("[data-copy-context]")?.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("[data-copy-status]");
      try { await navigator.clipboard.writeText(lastMessage); if (status) status.textContent = "Contexto copiado. Cole a mensagem no WhatsApp."; }
      catch { if (status) status.textContent = "Não foi possível copiar automaticamente. Selecione e copie o contexto antes de continuar."; }
    });
  }
</script>

<style>
  .project-start{width:min(100% - 2 * var(--site-layout-gutter),62rem);margin:0 auto;padding:0 0 clamp(5rem,10vw,8rem)}.project-start__privacy{max-width:44rem;margin-bottom:3rem;padding:2rem;border-left:3px solid #d9b746;background:#f0eee8}.project-start__privacy h2{margin:.2rem 0 1rem;font:500 clamp(2rem,4vw,3.2rem)/1 var(--site-font-display)}.project-start__privacy a,.project-start__back,.project-start__fallback a{color:inherit;text-underline-offset:.2em}form{max-width:42rem}fieldset{min-width:0;margin:0;padding:0;border:0}legend{margin-bottom:.5rem;font:500 clamp(2.5rem,5vw,4rem)/.98 var(--site-font-display)}.project-start__required{margin-bottom:2rem;color:var(--site-color-text-secondary)}.project-start__field{margin-bottom:2rem}.project-start__field label{display:flex;align-items:baseline;gap:.7rem;margin-bottom:.35rem;font:600 1rem var(--site-font-ui)}.project-start__field label span{color:#6f5500;font-size:.72rem}.project-start__field label small{margin-left:auto;color:var(--site-color-text-secondary);font-weight:400}.project-start__field>p:not(.project-start__error){margin:.2rem 0 .75rem;color:var(--site-color-text-secondary)}input[type="text"],select,textarea{width:100%;min-height:3.25rem;padding:.8rem 1rem;border:1px solid #77736c;border-radius:0;background:#fff;color:#12171c;font:inherit}textarea{min-height:6.5rem;resize:vertical}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,.project-start__back:focus-visible,.project-start__fallback a:focus-visible{outline:3px solid #8a6800;outline-offset:3px}[aria-invalid="true"]{border:2px solid #a11d16}.project-start__error{min-height:1.25rem;margin:.35rem 0 0;color:#8b1712;font-weight:600}.project-start__field output{display:block;text-align:right;color:var(--site-color-text-secondary);font-size:.8rem}.project-start__consent{display:grid;grid-template-columns:1.5rem 1fr;gap:.75rem;margin:2.5rem 0}.project-start__consent input{width:1.35rem;height:1.35rem;margin:.2rem 0}.project-start__consent .project-start__error{grid-column:2}.project-start__summary{margin-bottom:1.5rem;padding:1rem;border-left:3px solid #a11d16;background:#fff1ef;color:#72120e}.project-start__back{display:inline-block;margin-left:1.25rem}.project-start__fallback{max-width:42rem;margin-top:2rem;padding:1.5rem;border:1px solid var(--site-color-divider)}.project-start__fallback h2{margin-top:0}.project-start__fallback button{min-height:2.75rem;padding:.7rem 1rem;border:1px solid currentColor;background:transparent;font:600 .8rem var(--site-font-ui)}@media(max-width:35rem){.project-start__privacy{padding:1.35rem}.project-start__back{display:block;margin:1.25rem 0 0}.project-start .site-primitive-action{width:100%;min-height:3.25rem}textarea{max-height:9.5rem}}
</style>
