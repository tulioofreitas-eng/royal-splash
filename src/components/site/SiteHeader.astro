---
type SiteHeaderVisualMode = "functional" | "brand";

interface Props {
  visualMode?: SiteHeaderVisualMode;
}

const { visualMode = "functional" } = Astro.props;

const currentPath = Astro.url.pathname;

const navigationItems = [
  {
    href: "/projetos",
    label: "Projetos",
    routes: ["/projetos"],
  },
  {
    href: "/servicos",
    label: "Residencial",
    routes: ["/servicos"],
  },
  {
    href: "/corporativo",
    label: "Corporativo / Institucional",
    routes: ["/corporativo"],
  },
  {
    href: "/metodo-royal",
    label: "Método Royal",
    routes: ["/metodo-royal"],
  },
  {
    href: "/sobre",
    label: "A Royal",
    routes: ["/sobre"],
  },
] as const;

const isCurrent = (routes: readonly string[]) =>
  routes.some(
    (route) =>
      currentPath === route ||
      currentPath.startsWith(`${route}/`),
  );

const projectStartIsCurrent =
  currentPath === "/inicie-seu-projeto" ||
  currentPath.startsWith("/inicie-seu-projeto/");
---

<header
  class="site-header"
  data-site-header
  data-site-header-visual={visualMode}
>
  <nav
    class="site-header__bar"
    aria-label="Navegação principal"
  >
    <a
      class="site-header__identity"
      href="/"
      aria-label="Royal Splash — Início"
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      {
        visualMode === "brand" ? (
          <img
            class="site-header__brand-signature"
            src="/brand/identity/signatures/royal-splash-signature-h1-gold.svg"
            alt=""
            aria-hidden="true"
          />
        ) : (
          "Royal Splash"
        )
      }
    </a>

    <div class="site-header__desktop">
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            aria-current={
              isCurrent(item.routes)
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }

      <a
        class="site-header__primary-action"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="site_header"
        data-analytics-subject="project_start"
        data-analytics-channel="site_contact"
        aria-current={
          projectStartIsCurrent
            ? "page"
            : undefined
        }
      >
        Inicie seu projeto
      </a>
    </div>

    <button
      class="site-header__trigger"
      type="button"
      aria-label="Abrir navegação"
      aria-expanded="false"
      aria-controls="site-mobile-navigation"
      data-site-nav-trigger
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </nav>

  <div
    class="site-header__mobile"
    id="site-mobile-navigation"
    data-site-mobile-navigation
    hidden
  >
    <nav aria-label="Navegação móvel">
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            aria-current={
              isCurrent(item.routes)
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }

      <a
        class="site-header__primary-action"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="site_header"
        data-analytics-subject="project_start"
        data-analytics-channel="site_contact"
        aria-current={
          projectStartIsCurrent
            ? "page"
            : undefined
        }
      >
        Inicie seu projeto
      </a>

      <div class="site-header__auxiliary">
        <a href="/contato">Contato</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("[data-site-header]");

  if (header instanceof HTMLElement) {
    const trigger = header.querySelector("[data-site-nav-trigger]");
    const mobileNavigation = header.querySelector(
      "[data-site-mobile-navigation]",
    );

    if (
      trigger instanceof HTMLButtonElement &&
      mobileNavigation instanceof HTMLElement
    ) {
      const firstLink =
        mobileNavigation.querySelector("a");

      const setOpen = (
        open: boolean,
        restoreFocus = false,
      ) => {
        trigger.setAttribute(
          "aria-expanded",
          String(open),
        );

        trigger.setAttribute(
          "aria-label",
          open ? "Fechar navegação" : "Abrir navegação",
        );

        mobileNavigation.hidden = !open;

        if (open) {
          requestAnimationFrame(() => {
            if (firstLink instanceof HTMLElement) {
              firstLink.focus();
            }
          });
        } else if (restoreFocus) {
          trigger.focus();
        }
      };

      trigger.addEventListener("click", () => {
        const isOpen =
          trigger.getAttribute("aria-expanded") ===
          "true";

        setOpen(!isOpen, isOpen);
      });

      mobileNavigation
        .querySelectorAll("a")
        .forEach((link) => {
          link.addEventListener("click", () => {
            setOpen(false);
          });
        });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          trigger.getAttribute("aria-expanded") ===
            "true"
        ) {
          setOpen(false, true);
        }
      });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 1000;
    background: Canvas;
    color: CanvasText;
    border-block-end: 1px solid currentColor;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header a:hover {
    text-decoration: underline;
  }

  .site-header a:focus-visible,
  .site-header button:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .site-header a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 0.15em;
    text-underline-offset: 0.3em;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 80rem;
    min-height: 4.5rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .site-header__identity {
    font-weight: 700;
    white-space: nowrap;
  }

  .site-header__desktop {
    display: none;
  }

  .site-header__trigger {
    display: inline-grid;
    width: 3rem;
    min-width: 3rem;
    height: 3rem;
    place-items: center;
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    padding: 0.65rem;
    font: inherit;
    cursor: pointer;
  }

  .site-header__menu-icon {
    display: grid;
    width: 1.35rem;
    gap: 0.28rem;
  }

  .site-header__menu-icon > span {
    display: block;
    height: 2px;
    background: currentColor;
    transform-origin: center;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .site-header__trigger[aria-expanded="true"]
    .site-header__menu-icon > span:first-child {
    transform: translateY(0.38rem) rotate(45deg);
  }

  .site-header__trigger[aria-expanded="true"]
    .site-header__menu-icon > span:nth-child(2) {
    opacity: 0;
  }

  .site-header__trigger[aria-expanded="true"]
    .site-header__menu-icon > span:last-child {
    transform: translateY(-0.38rem) rotate(-45deg);
  }

  .site-header__mobile {
    border-block-start: 1px solid currentColor;
    padding: 1rem;
  }

  .site-header__mobile[hidden] {
    display: none;
  }

  .site-header__mobile nav {
    display: grid;
    gap: 0.5rem;
    max-width: 80rem;
    margin-inline: auto;
  }

  .site-header__mobile a {
    display: block;
    padding: 0.75rem;
  }

  .site-header__primary-action {
    border: 2px solid currentColor;
    font-weight: 700;
  }

  .site-header__auxiliary {
    margin-block-start: 0.75rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid currentColor;
  }

  @media (min-width: 64rem) {
    .site-header__desktop {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .site-header__desktop a {
      padding: 0.5rem;
    }

    .site-header__trigger,
    .site-header__mobile {
      display: none;
    }
  }

  .site-header[data-site-header-visual="brand"] {
    background: var(--site-color-surface-dark);
    color: var(--site-color-text-on-dark);
    font-family: var(--site-font-ui);
  }

  .site-header[data-site-header-visual="brand"] .site-header__bar {
    gap: var(--site-space-3);
    max-width: var(--site-layout-content-max);
    min-height: 5rem;
    padding-inline: var(--site-layout-gutter);
  }

  .site-header[data-site-header-visual="brand"] .site-header__identity {
    min-width: 0;
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__brand-signature {
    display: block;
    width: clamp(8.5rem, 38vw, 13rem);
    max-width: 100%;
    height: auto;
  }

  .site-header[data-site-header-visual="brand"]
    a[aria-current="page"] {
    text-decoration-color: var(--site-color-accent-on-dark);
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__primary-action {
    border-color: var(--site-color-accent-on-dark);
    color: var(--site-color-text-on-dark);
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__trigger {
    display: block;
    border-color: var(--site-color-text-on-dark);
    color: var(--site-color-text-on-dark);
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__mobile:not([hidden]) {
    display: block;
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__mobile {
    border-block-start-color: var(--site-color-divider);
    padding: var(--site-space-4) var(--site-layout-gutter);
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__mobile nav {
    gap: var(--site-space-2);
    max-width: var(--site-layout-content-max);
  }

  .site-header[data-site-header-visual="brand"]
    .site-header__auxiliary {
    border-block-start-color: var(--site-color-divider);
  }

  .site-header[data-site-header-visual="brand"] a:focus-visible,
  .site-header[data-site-header-visual="brand"] button:focus-visible {
    outline-color: var(--site-color-accent-on-dark);
  }

  @media (min-width: 80rem) {
    .site-header[data-site-header-visual="brand"]
      .site-header__desktop {
      display: flex;
    }

    .site-header[data-site-header-visual="brand"]
      .site-header__trigger,
    .site-header[data-site-header-visual="brand"]
      .site-header__mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__menu-icon > span {
      transition: none;
    }
  }
</style>
