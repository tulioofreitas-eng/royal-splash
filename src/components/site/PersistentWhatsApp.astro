---
const path = Astro.url.pathname;
---
<a class="persistent-whatsapp" href="https://wa.me/5521982590643" target="_blank" rel="noopener noreferrer" aria-label="Conversa WhatsApp com Royal Splash (abre em nova janela)" data-persistent-whatsapp data-analytics-cta data-analytics-component="persistent_whatsapp" data-analytics-subject={path} data-analytics-channel="whatsapp"><span aria-hidden="true">WA</span><strong>WhatsApp</strong></a>
<style>
  .persistent-whatsapp{position:fixed;z-index:40;right:clamp(1rem,2.5vw,2rem);bottom:clamp(1rem,2.5vw,2rem);display:inline-flex;min-height:3.25rem;align-items:center;gap:.65rem;padding:.7rem 1rem;border:1px solid rgba(18,23,28,.22);border-radius:999px;background:#d9b746;color:#12171c;box-shadow:0 12px 34px rgba(0,0,0,.2);font:600 .75rem/1 var(--site-font-ui,sans-serif);letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.persistent-whatsapp span{display:grid;width:1.8rem;height:1.8rem;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:.62rem}.persistent-whatsapp:hover{transform:translateY(-2px)}.persistent-whatsapp:focus-visible{outline:3px solid #fff;outline-offset:4px;box-shadow:0 0 0 7px #12171c}@media(max-width:30rem){.persistent-whatsapp{right:1rem;bottom:1rem;min-width:3.25rem;padding:.7rem}.persistent-whatsapp strong{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}}@media(prefers-reduced-motion:reduce){.persistent-whatsapp{transition:none}.persistent-whatsapp:hover{transform:none}}
</style>
