---
import type {
  RoyalCaseNarrativeKind,
  RoyalPublicCaseDetail,
} from "../../content/royal/case-detail.ts";

interface Props {
  record: RoyalPublicCaseDetail;
}

const {
  record,
} = Astro.props;

const {
  siteCase,
  detail,
  evidence,
} = record;

const blockHeadings:
  Record<
    RoyalCaseNarrativeKind,
    string
  > = {
    context: "Contexto",
    challenge: "Desafio",
    reasoning: "Raciocínio",
    royal_scope: "Escopo Royal",
    solution: "Solução",
    execution: "Execução",
    detail: "Detalhe",
    outcome: "Resultado",
  };

const supportingEvidence =
  evidence.filter(
    (item) =>
      item.kind !== "testimonial" &&
      item.kind !== "metric",
  );

const testimonials =
  detail.testimonialEvidenceRefs
    .map(
      (evidenceRef) =>
        evidence.find(
          (item) =>
            item.id ===
            evidenceRef,
        ),
    )
    .filter(
      (
        item,
      ): item is NonNullable<
        typeof item
      > =>
        item !== undefined,
    );

const metrics =
  detail.metricEvidenceRefs
    .map(
      (evidenceRef) =>
        evidence.find(
          (item) =>
            item.id ===
            evidenceRef,
        ),
    )
    .filter(
      (
        item,
      ): item is NonNullable<
        typeof item
      > =>
        item !== undefined,
    );
---

<article
  class="case-detail"
  data-case-detail
  data-case-id={siteCase.id}
>
  <header
    class="case-detail-section case-detail-entry site-primitive-section site-primitive-section--entry"
    data-case-detail-stage="entry"
  >
    <p
      class="case-detail-eyebrow site-primitive-eyebrow site-primitive-supporting"
    >
      Projeto
    </p>

    <h1
      class="site-primitive-page-title site-primitive-reading"
    >
      {siteCase.title}
    </h1>

    <p
      class="site-primitive-body site-primitive-supporting site-primitive-reading"
    >
      {siteCase.summary}
    </p>

    <div
      class="case-detail-actions site-primitive-actions"
    >
      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/projetos"
      >
        Voltar para Projetos
      </a>
    </div>
  </header>

  {
    detail.blocks.map(
      (block) => (
        <section
          class="case-detail-section site-primitive-section site-primitive-datum-top"
          aria-labelledby={`case-${block.id}-heading`}
          data-case-detail-stage={block.kind}
        >
          <h2
            id={`case-${block.id}-heading`}
            class="site-primitive-section-title"
          >
            {blockHeadings[block.kind]}
          </h2>

          <p
            class="site-primitive-body site-primitive-reading"
          >
            {block.body}
          </p>
        </section>
      ),
    )
  }

  {
    supportingEvidence.length > 0 && (
      <section
        class="case-detail-section site-primitive-section site-primitive-datum-top"
        aria-labelledby="case-evidence-heading"
        data-case-detail-stage="evidence"
      >
        <h2
          id="case-evidence-heading"
          class="site-primitive-section-title"
        >
          Evidências verificadas
        </h2>

        <ul class="case-detail-list">
          {supportingEvidence.map((item) => (
            <li
              class="case-detail-item site-primitive-datum-top"
            >
              <strong
                class="site-primitive-subtitle"
              >
                {item.title ?? "Evidência verificada"}
              </strong>

              {
                item.summary && (
                  <p
                    class="site-primitive-body site-primitive-supporting site-primitive-reading"
                  >
                    {item.summary}
                  </p>
                )
              }
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    testimonials.length > 0 && (
      <section
        class="case-detail-section site-primitive-section site-primitive-datum-top"
        aria-labelledby="case-testimonials-heading"
        data-case-detail-stage="testimonial"
      >
        <h2
          id="case-testimonials-heading"
          class="site-primitive-section-title"
        >
          Depoimentos verificados
        </h2>

        <ul class="case-detail-list">
          {testimonials.map((item) => (
            <li
              class="case-detail-item site-primitive-datum-top"
            >
              <strong
                class="site-primitive-subtitle"
              >
                {item.title ?? "Depoimento verificado"}
              </strong>

              {
                item.summary && (
                  <p
                    class="site-primitive-body site-primitive-supporting site-primitive-reading"
                  >
                    {item.summary}
                  </p>
                )
              }
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    metrics.length > 0 && (
      <section
        class="case-detail-section site-primitive-section site-primitive-datum-top"
        aria-labelledby="case-metrics-heading"
        data-case-detail-stage="metric"
      >
        <h2
          id="case-metrics-heading"
          class="site-primitive-section-title"
        >
          Métricas verificadas
        </h2>

        <ul class="case-detail-list">
          {metrics.map((item) => (
            <li
              class="case-detail-item site-primitive-datum-top"
            >
              <strong
                class="site-primitive-subtitle"
              >
                {item.title ?? "Métrica verificada"}
              </strong>

              {
                item.summary && (
                  <p
                    class="site-primitive-body site-primitive-supporting site-primitive-reading"
                  >
                    {item.summary}
                  </p>
                )
              }
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section
    class="case-detail-section case-detail-conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="case-action-heading"
    data-case-detail-stage="qualified-action"
  >
    <h2
      id="case-action-heading"
      class="site-primitive-section-title"
    >
      Avance com o contexto do seu projeto
    </h2>

    <p
      class="site-primitive-body site-primitive-reading"
    >
      Use o fluxo estruturado quando houver
      contexto suficiente para iniciar a conversa.
    </p>

    <div
      class="case-detail-actions site-primitive-actions"
    >
      <a
        class="case-detail-primary-action site-primitive-action site-primitive-action--primary"
        href="/inicie-seu-projeto"
        data-analytics-cta
        data-analytics-component="royal_case_detail"
        data-analytics-subject="project_start"
        data-analytics-channel="site_form"
      >
        Inicie seu projeto
      </a>

      <a
        class="site-primitive-action site-primitive-action--tertiary"
        href="/contato"
      >
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</article>

<style>
  .case-detail-eyebrow {
    margin-block:
      0
      var(--site-space-4);
  }

  .case-detail-entry .site-primitive-page-title,
  .case-detail-section .site-primitive-section-title {
    margin-block:
      0
      var(--site-space-5);
  }

  .case-detail-section > .site-primitive-body {
    margin-block: 0;
  }

  .case-detail-list {
    margin:
      var(--site-space-6)
      0
      0;
    padding: 0;
    list-style: none;
  }

  .case-detail-item {
    padding-block:
      var(--site-space-5);
  }

  .case-detail-item > .site-primitive-subtitle {
    display: block;
  }

  .case-detail-item > p {
    margin-block:
      var(--site-space-3)
      0;
  }

  .case-detail-conversion {
    margin-block-end:
      var(--site-space-8);
    padding:
      var(--site-space-7);
    border-block-start:
      3px solid
      var(--site-color-accent-on-dark);
  }

  @media (max-width: 30rem) {
    .case-detail-conversion {
      margin-block-end:
        var(--site-space-6);
      padding-inline:
        var(--site-space-5);
    }
  }
</style>
