---
import SiteHeader from "./SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import residentialMedia from "../../assets/lazer-geral.jpg";
import residentialUnderstanding from "../../assets/residential-process-understanding.png";
import residentialScope from "../../assets/residential-process-scope.png";
import residentialWork from "../../assets/residential-process-work.png";
import residentialDelivery from "../../assets/residential-process-delivery.png";
import corporateMedia from "../../assets/corp-hotel.jpg";
import corporateScale from "../../assets/corp-olimpica.jpg";
import corporateIntervention from "../../assets/corp-manutencao.jpg";
import corporateFinish from "../../assets/corp-revestimento.jpg";
import "../../styles/complete-experience.css";
type SegmentContext = "residencial" | "corporativo_institucional";
interface Props { context: SegmentContext; title?: string; intro?: string }
const { context } = Astro.props;
const residential = context === "residencial";
const label = residential ? "Residencial" : "Corporativo / Institucional";
const specialties = residential ? [
  ["01", "Piscinas", "Desenho e construção de piscinas residenciais com atenção à qualidade construtiva, aos materiais e à integração arquitetônica."],
  ["02", "Sauna", "Sistemas de sauna integrados aos ambientes residenciais, com segurança térmica e acabamento."],
  ["03", "Lazer", "Deck, áreas gourmet, iluminação noturna e conforto exterior coordenados com o conjunto."],
  ["04", "Reforma", "Intervenção em piscinas existentes, atualização de sistemas e integração com um novo escopo."],
  ["05", "Proteção estrutural", "Diagnóstico de vazamentos, reparo e proteção contra umidade em estruturas existentes."],
  ["06", "Fibra e revestimentos", "Aplicação especializada em superfícies, proteção e acabamento."],
] : [
  ["01", "Piscinas de uso coletivo", "Projeto, construção e integração com atenção a circulação, segurança, acessibilidade e intensidade de uso."],
  ["02", "Sistemas integrados", "Coordenação de piscina, sauna, iluminação e demais sistemas presentes no escopo."],
  ["03", "Diagnóstico e intervenção", "Leitura técnica de estruturas e sistemas existentes para definir uma intervenção compatível com a operação do espaço."],
  ["04", "Fibra e revestimentos", "Acabamentos especializados para superfícies submetidas a uso intenso, produtos químicos e ciclos térmicos."],
];
const moments = [
  ["Projeto novo", "Piscina, sauna e lazer entram desde a concepção do espaço externo, em coordenação com arquitetura, paisagem e fluxo da casa."],
  ["Projeto existente", "A estrutura, o espaço disponível e as áreas construídas orientam a adaptação de uma nova piscina ou sistema de lazer."],
  ["Manutenção e intervenção", "Vazamentos, reparos estruturais e atualizações de fibra ou sistemas começam por diagnóstico e definição precisa do escopo."],
];
const execution = [
  ["01", "Entendimento", "Conversa sobre condição atual, visão para o novo, escala, prazo e restrições do espaço.", residentialUnderstanding, "Conversa de entendimento sobre o contexto residencial"],
  ["02", "Escopo e proposta", "Organização técnica do que foi compreendido, com responsabilidades e próximos passos claros.", residentialScope, "Desenhos, materiais e referências para definição da proposta"],
  ["03", "Obra", "Execução acompanhada, comunicação ao longo das fases e atenção à integração construtiva.", residentialWork, "Execução física da estrutura da piscina"],
  ["04", "Entrega", "Conclusão, orientação de uso e continuidade do contato conforme o escopo realizado.", residentialDelivery, "Ambiente residencial concluído e pronto para uso"],
];
const collective = [
  ["Volume e simultaneidade", "A intensidade de uso orienta circulação, filtração e qualidade da água. O dimensionamento considera a demanda coletiva do espaço."],
  ["Contexto técnico", "Segurança, acessibilidade e condições existentes precisam entrar no escopo desde o início."],
  ["Durabilidade sob uso", "Estruturas, materiais e acabamentos são definidos considerando intensidade de uso e ciclos de intervenção."],
  ["Integração ao espaço", "A solução aquática precisa conviver com acessos, fluxos, horários e outras operações do ambiente."],
];
---
<SiteLayout title={`${label} — Royal Splash`} robots="noindex, nofollow" bodyClass="site-primitive-page experience-page segment-depth" visualMode="brand">
  <SiteHeader slot="header" visualMode="brand" />
  <section class="experience-entry" aria-labelledby="segment-heading" data-segment-context={context}><p class="experience-kicker">{label}</p><h1 id="segment-heading">{residential ? "Água integrada ao projeto de habitar." : "Engenharia aquática para uso coletivo."}</h1><p class="experience-lead">{residential ? "Piscinas, sauna, lazer, reforma, proteção estrutural e acabamentos especializados — coordenados como parte da arquitetura residencial." : "Escala, circulação, intensidade de uso e contexto técnico orientam cada projeto corporativo ou institucional."}</p></section>
  <section class="experience-section segment-feature" aria-labelledby="segment-context-heading"><div class:list={["experience-section__intro", residential ? "segment-intro--residential" : "segment-intro--corporate"]}><p class="experience-kicker">Contexto</p><h2 id="segment-context-heading">{residential ? "Como a água entra no projeto residencial" : "O que muda em espaços coletivos"}</h2><p>{residential ? "A atuação pode começar no desenho de um novo espaço, na adaptação do que já existe ou em uma intervenção técnica." : "A engenharia é orientada pela relação entre uso coletivo, escala, sistemas e condições de operação."}</p></div><div class="experience-media"><img src={(residential ? residentialMedia : corporateMedia).src} alt={residential ? "Área de lazer com piscina integrada à residência" : "Piscina em espaço de uso coletivo"} loading="eager" /><span class="experience-media__veil"></span><p class="experience-media__label">Royal Splash</p></div><div class:list={["segment-factors", !residential && "segment-factors--corporate"]}>{(residential ? moments : collective).map(([heading, body]) => <article><h3>{heading}</h3><p>{body}</p></article>)}</div></section>
  <section class="experience-section" aria-labelledby="segment-specialties"><div class:list={["experience-section__intro", residential ? "segment-intro--residential-stack" : "segment-intro--corporate-stack"]}><p class="experience-kicker">Especialidades</p><h2 id="segment-specialties">{residential ? "Seis especialidades compõem a prática residencial" : "Engenharia para contextos de uso coletivo"}</h2></div><div class="experience-grid">{specialties.map(([n,h,b]) => <article class="experience-card"><span>{n}</span><h3>{h}</h3><p>{b}</p></article>)}</div></section>
  {residential ? <section class="experience-section" aria-labelledby="residential-method"><div class="experience-section__intro segment-intro--residential-stack"><p class="experience-kicker">Execução</p><h2 id="residential-method">Do entendimento à entrega</h2></div><ol class="segment-process">{execution.map(([n,h,b,image,alt]) => <li><div><span>{n as string}</span><h3>{h as string}</h3><p>{b as string}</p></div><img src={(image as typeof residentialMedia).src} alt={alt as string} loading="lazy" data-process-conceptual-media /></li>)}</ol></section> : <section class="experience-section" aria-labelledby="corporate-evidence"><div class="experience-section__intro segment-intro--corporate"><p class="experience-kicker">Execução</p><h2 id="corporate-evidence">Escala, intervenção e acabamento</h2><p>O acervo mostra estruturas, leitura de sistemas existentes e acabamentos em diferentes momentos de execução.</p></div><div class="segment-evidence">{[[corporateScale,"Piscina de uso coletivo em escala ampliada"],[corporateFinish,"Mergulhador em intervenção técnica subaquática"],[corporateIntervention,"Limpeza e manutenção de piscina"]].map(([image,alt]) => <img src={(image as typeof corporateMedia).src} alt={alt as string} loading="lazy" />)}</div></section>}
  {residential ? <section class="experience-section segment-archive segment-archive--residential" aria-labelledby="segment-archive"><div class="experience-section__intro segment-archive__layout"><div class="segment-archive__heading"><p class="experience-kicker">Acervo</p><h2 id="segment-archive">Fotografias de projetos realizados.</h2></div><div class="segment-archive__action"><p>Veja contextos de integração, estrutura, intervenção e acabamento no Acervo Royal Splash.</p><a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">Ver Acervo</a></div></div></section> : <section class="experience-section segment-archive" aria-labelledby="segment-archive"><div class="experience-section__intro segment-archive--corporate"><p class="experience-kicker">Acervo</p><h2 id="segment-archive">Fotografias de projetos realizados.</h2><p>Veja contextos de integração, estrutura, intervenção e acabamento no Acervo Royal Splash.</p><a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">Ver Acervo</a></div></section>}
  <section class="experience-conversion" aria-labelledby="segment-conversion"><p class="experience-kicker">Próximo passo</p><h2 id="segment-conversion">{residential ? "Compartilhe o contexto do seu projeto." : "Comece pela escala e pelo contexto de uso."}</h2><p>Converse agora ou prepare as informações antes de abrir o WhatsApp.</p><div class="experience-links"><a class="site-primitive-action site-primitive-action--primary" href="https://wa.me/5521982590643" target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp para projeto ${label} (abre em nova janela)`} data-analytics-cta data-analytics-component={`${context}_whatsapp`} data-analytics-subject="project_start" data-analytics-channel="whatsapp">Conversar no WhatsApp</a><a class="site-primitive-action site-primitive-action--tertiary" href="/inicie-seu-projeto">Prepare a conversa</a></div></section>
</SiteLayout>
<style>
  .segment-factors{display:grid;gap:1px;margin-top:2rem;background:var(--site-color-divider)}.segment-factors article{padding:1.5rem;background:var(--site-color-surface)}.segment-factors h3{margin:0 0 .65rem;font:600 .8rem var(--site-font-ui);letter-spacing:.08em;text-transform:uppercase}.segment-factors p{margin:0;color:var(--site-color-text-secondary)}.segment-process{list-style:none;margin:0;padding:0}.segment-process li{display:grid;gap:1.5rem;padding:2rem 0;border-top:1px solid var(--site-color-divider)}.segment-process span{color:#6f5500;font:600 .75rem var(--site-font-ui)}.segment-process h3{margin:.5rem 0;font:500 clamp(2rem,4vw,3rem)/1 var(--site-font-display)}.segment-process p{max-width:35rem;color:var(--site-color-text-secondary)}.segment-process img{display:block;width:100%;height:auto;aspect-ratio:12/5;object-fit:cover}.segment-evidence img{display:block;width:100%;height:22rem;object-fit:cover}.segment-evidence{display:grid;gap:1rem}.segment-archive{padding-top:0}.segment-archive__heading,.segment-archive__action{display:contents}@media(min-width:48rem){.segment-factors{grid-template-columns:repeat(3,1fr)}.segment-factors--corporate{grid-template-columns:repeat(2,minmax(0,1fr))}.segment-intro--residential,.segment-intro--corporate{grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);column-gap:clamp(2rem,6vw,7rem);row-gap:.75rem;align-items:end}.segment-intro--residential>.experience-kicker,.segment-intro--corporate>.experience-kicker{grid-column:1/-1;margin-bottom:0}.segment-intro--residential>h2,.segment-intro--corporate>h2{grid-column:1}.segment-intro--residential>p,.segment-intro--corporate>p{grid-column:2;padding-bottom:.35rem}.segment-intro--residential-stack,.segment-intro--corporate-stack,.segment-archive--corporate{grid-template-columns:minmax(0,44rem);row-gap:1rem}.segment-intro--residential-stack>*,.segment-intro--corporate-stack>*,.segment-archive--corporate>*{grid-column:1}.segment-intro--residential-stack>.experience-kicker,.segment-intro--corporate-stack>.experience-kicker,.segment-archive--corporate>.experience-kicker{margin-bottom:0}.segment-intro--residential-stack>h2{max-width:13ch;line-height:1.12;letter-spacing:-.015em}.segment-archive--corporate>a{justify-self:start;margin-top:.5rem}.segment-process li{grid-template-columns:1fr 1fr;align-items:center}.segment-process li:nth-child(even) img{grid-column:1;grid-row:1}.segment-process li:nth-child(even)>div{grid-column:2}.segment-evidence{grid-template-columns:repeat(3,1fr)}.segment-evidence img{height:28rem}.segment-archive__layout{grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:clamp(2rem,6vw,7rem);align-items:end}.segment-archive__heading,.segment-archive__action{display:block}.segment-archive__heading .experience-kicker{margin-bottom:1rem}.segment-archive__action{padding-bottom:.35rem}.segment-archive__action p{max-width:30rem}.segment-archive__action .site-primitive-action{margin-top:1.5rem}}
@media(min-width:48rem){.segment-archive--residential .segment-archive__heading h2{margin-bottom:.35rem}.segment-archive--residential .segment-archive__action{padding-bottom:0}}
</style>
