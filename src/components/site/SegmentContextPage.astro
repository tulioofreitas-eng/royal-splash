---
import SiteHeader from "./SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

type SegmentContext =
  | "residencial"
  | "corporativo_institucional";

interface Props {
  context: SegmentContext;
  title: string;
  intro: string;
}

const {
  context,
  title,
  intro,
} = Astro.props;

const isResidential =
  context === "residencial";

const contextLabel = isResidential
  ? "Residencial"
  : "Corporativo / Institucional";

const qualifiedActionLabel = isResidential
  ? "Inicie seu projeto residencial"
  : "Inicie seu projeto corporativo / institucional";

const qualifiedActionHref =
  `/inicie-seu-projeto?context=${encodeURIComponent(context)}`;
---

<SiteLayout
  title={`${title} — Royal Splash`}
  robots="noindex, nofollow"
  bodyClass="site-brand-segment site-primitive-page"
  visualMode="brand"
>
  <SiteHeader slot="header" visualMode="brand" />

  <section
    class="segment-context segment-context--entry site-primitive-section site-primitive-section--entry"
    aria-labelledby="segment-context-heading"
    data-segment-context={context}
  >
    <p class="segment-context__eyebrow site-primitive-eyebrow site-primitive-supporting">
      Contexto {contextLabel}
    </p>

    <h1 id="segment-context-heading" class="site-primitive-page-title site-primitive-reading">
      {title}
    </h1>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      {intro}
    </p>

    <div class="segment-context__actions site-primitive-actions">
      <a
        class="segment-context__primary-action site-primitive-action site-primitive-action--primary"
        href={qualifiedActionHref}
        data-segment-qualified-action
        data-analytics-cta
        data-analytics-component="segment_context"
        data-analytics-subject={context}
        data-analytics-channel="site_form"
      >
        {qualifiedActionLabel}
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
        Ver Projetos
      </a>
    </div>
  </section>

  <section
    class="segment-context site-primitive-section site-primitive-datum-top"
    aria-labelledby="segment-proof-heading"
  >
    <h2 id="segment-proof-heading" class="site-primitive-section-title">
      Projetos
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Consulte os projetos atualmente disponíveis
      antes de escolher o próximo passo.
    </p>

    <a class="site-primitive-action site-primitive-action--tertiary" href="/projetos">
      Explorar Projetos
    </a>
  </section>

  <section
    class="segment-context site-primitive-section site-primitive-datum-top"
    aria-labelledby="segment-method-heading"
  >
    <h2 id="segment-method-heading" class="site-primitive-section-title">
      Método
    </h2>

    <p class="site-primitive-body site-primitive-supporting site-primitive-reading">
      Acesse a seção Método Royal para continuar
      explorando os contextos de projeto.
    </p>

    <a class="site-primitive-action site-primitive-action--tertiary" href="/metodo-royal">
      Conhecer Método Royal
    </a>
  </section>

  <section
    class="segment-context segment-context--conversion site-primitive-section site-primitive-surface--dark"
    aria-labelledby="segment-action-heading"
  >
    <h2 id="segment-action-heading" class="site-primitive-section-title">
      Avance com o contexto do seu projeto
    </h2>

    <p class="site-primitive-body site-primitive-reading">
      O contexto selecionado será mantido ao iniciar
      o preenchimento.
    </p>

    <div class="segment-context__actions site-primitive-actions">
      <a
        class="segment-context__primary-action site-primitive-action site-primitive-action--primary"
        href={qualifiedActionHref}
        data-segment-qualified-action
        data-analytics-cta
        data-analytics-component="segment_context"
        data-analytics-subject={context}
        data-analytics-channel="site_form"
      >
        {qualifiedActionLabel}
      </a>

      <a class="site-primitive-action site-primitive-action--tertiary" href="/contato">
        Contato e canais auxiliares
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .segment-context__eyebrow {
    margin-block: 0 var(--site-space-4);
  }

  .segment-context--entry .site-primitive-page-title,
  .segment-context .site-primitive-section-title {
    margin-block: 0 var(--site-space-5);
  }

  .segment-context > p {
    margin-block: 0;
  }

  .segment-context > a {
    margin-block-start: var(--site-space-6);
  }

  .segment-context--conversion {
    margin-block-end: var(--site-space-8);
    padding: var(--site-space-7);
    border-block-start: 3px solid var(--site-color-accent-on-dark);
  }

  @media (max-width: 30rem) {
    .segment-context--conversion {
      margin-block-end: var(--site-space-6);
      padding-inline: var(--site-space-5);
    }
  }
</style>
