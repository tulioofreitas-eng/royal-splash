<script>
  interface WhatsAppAnalyticsWindow extends Window {
    __royalWhatsAppClickAnalyticsInstalled?: boolean;
    __royalWhatsAppClickEventLastEmittedAt?: number;
    __royalMeasurementConsent?: {
      get?: () => {
        marketing?: boolean;
      } | null;
    };
    dataLayer?: unknown[];
  }

  const analyticsWindow = window as WhatsAppAnalyticsWindow;

  // Same physical handoff can reach recordWhatsAppClick via two independent
  // observers (raw wa.me anchor click and the LP forms' custom event). This
  // window keeps a single logical handoff from emitting whatsapp_click twice.
  const DUPLICATE_EVENT_WINDOW_MS = 500;

  if (!analyticsWindow.__royalWhatsAppClickAnalyticsInstalled) {
    analyticsWindow.__royalWhatsAppClickAnalyticsInstalled = true;

    const marketingMeasurementAllowed = () => {
      const runtime =
        analyticsWindow.__royalMeasurementConsent;

      // Preview/test does not install production measurement consent.
      if (!runtime) return true;

      return runtime.get?.()?.marketing === true;
    };

    const emitWhatsAppClickEvent = () => {
      const now = Date.now();
      const last = analyticsWindow.__royalWhatsAppClickEventLastEmittedAt;
      if (last !== undefined && now - last < DUPLICATE_EVENT_WINDOW_MS) return;
      analyticsWindow.__royalWhatsAppClickEventLastEmittedAt = now;

      if (!marketingMeasurementAllowed()) return;

      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({ event: "whatsapp_click" });
    };

    const recordWhatsAppClick = () => {
      emitWhatsAppClickEvent();

      fetch("/api/whatsapp-click", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ pagina: window.location.pathname }),
        keepalive: true,
      }).catch(() => {});
    };

    document.addEventListener(
      "click",
      (event) => {
        if (!(event.target instanceof Element)) return;

        const anchor = event.target.closest<HTMLAnchorElement>("a[href]");
        if (!anchor) return;

        try {
          if (new URL(anchor.href).hostname === "wa.me") {
            recordWhatsAppClick();
          }
        } catch {
          // An invalid href is not a trackable WhatsApp handoff.
        }
      },
      { capture: true },
    );

    window.addEventListener(
      "site:whatsapp-handoff-initiated",
      recordWhatsAppClick,
    );
  }
</script>
