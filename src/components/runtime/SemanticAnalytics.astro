---
import { getCurrentEnvironmentContract } from "../../safety/runtime.ts";

const environment =
  getCurrentEnvironmentContract();

const enabled =
  !environment.isProduction;

const pageRef =
  Astro.url.pathname;
---

{
  enabled && (
    <div
      hidden
      data-semantic-analytics-runtime
      data-page-ref={pageRef}
      data-template-ref="site"
    ></div>
  )
}

<script>
  import {
    installBrowserSemanticAnalyticsRuntime,
  } from "../../analytics/browser-runtime.ts";

  const config = document.querySelector(
    "[data-semantic-analytics-runtime]",
  );

  if (config instanceof HTMLElement) {
    const pageRef =
      config.dataset.pageRef;

    const templateRef =
      config.dataset.templateRef;

    if (pageRef) {
      installBrowserSemanticAnalyticsRuntime({
        pageRef,
        route: window.location.pathname,
        ...(templateRef
          ? { templateRef }
          : {}),
      });
    }
  }
</script>
