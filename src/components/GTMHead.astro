---
import { getCurrentEnvironmentContract } from "../safety/runtime.ts";

const { allowProductionAnalytics } = getCurrentEnvironmentContract();
---
{allowProductionAnalytics && (
  <script is:inline>
    (function (w, d) {
      var STORAGE_KEY = "royal_measurement_consent.v1";
      var VERSION = 1;
      var GTM_ID = "GTM-TFW2WDRG";
      var loaded = false;

      w.dataLayer = w.dataLayer || [];

      w.gtag = w.gtag || function () {
        w.dataLayer.push(arguments);
      };

      function normalizeChoice(value) {
        if (
          !value ||
          typeof value !== "object" ||
          value.version !== VERSION ||
          typeof value.analytics !== "boolean" ||
          typeof value.marketing !== "boolean"
        ) {
          return null;
        }

        return {
          version: VERSION,
          analytics: value.analytics === true,
          marketing: value.marketing === true,
        };
      }

      function readStoredChoice() {
        try {
          return normalizeChoice(
            JSON.parse(w.localStorage.getItem(STORAGE_KEY) || "null"),
          );
        } catch (_) {
          return null;
        }
      }

      function persistChoice(choice) {
        try {
          w.localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(choice),
          );
        } catch (_) {
          // Storage can be unavailable. The current-page choice still applies.
        }
      }

      function googleConsentState(choice) {
        var analyticsGranted =
          !!choice && choice.analytics === true;
        var marketingGranted =
          !!choice && choice.marketing === true;

        return {
          analytics_storage:
            analyticsGranted ? "granted" : "denied",
          ad_storage:
            marketingGranted ? "granted" : "denied",
          ad_user_data:
            marketingGranted ? "granted" : "denied",
          ad_personalization:
            marketingGranted ? "granted" : "denied",
        };
      }

      function shouldLoadContainer(choice) {
        return !!choice && (
          choice.analytics === true ||
          choice.marketing === true
        );
      }

      function pushConsentCategoryEvent(choice) {
        // Null (cleared storage) must revoke stale GTM DLV category flags.
        choice = choice || { analytics: false, marketing: false };
        w.dataLayer.push({
          event: "royal_measurement_consent",
          analytics_consent:
            choice.analytics === true,
          marketing_consent:
            choice.marketing === true,
        });
      }

      function loadContainer() {
        if (loaded) {
          return;
        }

        loaded = true;

        w.dataLayer.push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });

        var firstScript =
          d.getElementsByTagName("script")[0];
        var script = d.createElement("script");

        script.async = true;
        script.src =
          "https://www.googletagmanager.com/gtm.js?id=" +
          GTM_ID;

        firstScript.parentNode.insertBefore(
          script,
          firstScript,
        );
      }

      var storedChoice = readStoredChoice();
      var currentChoice = storedChoice;

      // Strict/basic Consent Mode: establish an explicit default before
      // any Google measurement container can execute.
      w.gtag(
        "consent",
        "default",
        googleConsentState(storedChoice),
      );

      // Keep every open tab synchronized: storage changes do not fire on
      // the tab that made them, so both update() and storage events pass
      // through this same consent and attribution notification boundary.
      function sameChoice(a, b) {
        return (!!a === !!b) &&
          (!a || (
            a.version === b.version &&
            a.analytics === b.analytics &&
            a.marketing === b.marketing
          ));
      }

      function applyChoice(choice, callerManagesRouting) {
        if (sameChoice(currentChoice, choice)) return;

        currentChoice = choice;
        w.gtag("consent", "update", googleConsentState(choice));
        w.dispatchEvent(
          new CustomEvent("royal:measurement-consent-changed", {
            detail: choice,
          }),
        );

        if (!callerManagesRouting) {
          if (shouldLoadContainer(choice)) {
            loadContainer();
          }
          if (loaded) {
            pushConsentCategoryEvent(choice);
          }
        }
      }

      // Re-read the durable choice at use time, not only on page load.
      // Missing, cleared or malformed storage fails closed for Marketing.
      function reconcileStoredChoice() {
        var latest = readStoredChoice();
        applyChoice(latest);
        return currentChoice;
      }

      w.__royalMeasurementConsent = {
        version: VERSION,
        hasChoice: function () {
          return reconcileStoredChoice() !== null;
        },
        get: function () {
          return reconcileStoredChoice();
        },
        update: function (value) {
          var choice = normalizeChoice(value);
          if (!choice) return false;
          persistChoice(choice);
          applyChoice(choice, true);
          // Storage restrictions fail closed instead of claiming durable
          // cross-tab permission that cannot be synchronized.
          choice = reconcileStoredChoice();

          if (shouldLoadContainer(choice)) {
            loadContainer();
          }
          if (loaded) {
            pushConsentCategoryEvent(choice);
          }
          return true;
        },
      };

      w.addEventListener("storage", function (event) {
        if (event.storageArea !== w.localStorage) return;
        if (event.key !== STORAGE_KEY && event.key !== null) return;
        reconcileStoredChoice();
      });

      if (shouldLoadContainer(storedChoice)) {
        loadContainer();
        pushConsentCategoryEvent(storedChoice);
      }
    })(window, document);
  </script>
)}
