---
import BotaoWhatsapp from "../BotaoWhatsapp.astro";
---
<form class="sauna-whatsapp-form" data-sauna-whatsapp-form novalidate>
  <div class="sauna-whatsapp-form__summary" role="alert" aria-live="assertive" hidden data-error-summary></div>
  <div class="sauna-whatsapp-form__field">
    <label for="sauna-nome">Nome <small>Obrigatório</small></label>
    <p id="sauna-nome-help">Como você prefere ser chamado?</p>
    <input type="text" id="sauna-nome" name="nome" required autocomplete="name" aria-describedby="sauna-nome-help" />
    <p class="sauna-whatsapp-form__error" data-error-for="nome" aria-live="polite"></p>
  </div>
  <div class="sauna-whatsapp-form__field">
    <label for="sauna-detalhes">Contexto do projeto <small>Opcional</small></label>
    <p>Descreva o espaço, tipo de sauna (seca/vapor) ou integração desejada.</p>
    <textarea id="sauna-detalhes" name="detalhes" maxlength="500"></textarea>
    <output id="sauna-project-detalhes-count">0 / 500 caracteres</output>
  </div>
  <div class="sauna-whatsapp-form__field">
    <label for="sauna-prazo">Prazo <small>Opcional</small></label>
    <select id="sauna-prazo" name="prazo">
      <option value="">Selecione...</option>
      <option value="imediato">O quanto antes (Imediato)</option>
      <option value="proximos_meses">Próximos 3 meses</option>
      <option value="planejamento">Estou apenas planejando</option>
    </select>
  </div>
  <div class="sauna-whatsapp-form__consent">
    <input type="checkbox" id="sauna-consentimento" name="consentimento" required />
    <label for="sauna-consentimento">Autorizo preparar estas informações para iniciar minha conversa pelo WhatsApp. Li a <a href="/politica-de-privacidade" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.</label>
    <p class="sauna-whatsapp-form__error" data-error-for="consentimento" aria-live="polite"></p>
  </div>
  <button type="submit" class="site-primitive-action site-primitive-action--primary">Abrir conversa no WhatsApp</button>
  <p class="sauna-whatsapp-form__privacy">Os dados permanecem neste navegador até o handoff para o WhatsApp. Este formulário não os armazena em servidor ou CRM da Royal Splash.</p>
</form>

<div class="sauna-whatsapp-form__fallback" hidden data-whatsapp-fallback tabindex="-1">
  <h3>Quase lá!</h3>
  <p>O navegador bloqueou a abertura automática do WhatsApp. Se preferir, copie a mensagem pronta e envie para <strong>(21) 98259-0643</strong>.</p>
  <textarea data-composed-message readonly aria-label="Sua mensagem pronta"></textarea>
  <p aria-live="polite" data-copy-status></p>
  <button type="button" data-copy-message>Copiar mensagem</button>
</div>

<script>
  import {
    buildSaunaWhatsAppUrl,
    composeSaunaProjectMessage,
    type SaunaProjectContext,
  } from "../../utils/whatsapp-composer.ts";

  const form = document.querySelector<HTMLFormElement>("[data-sauna-whatsapp-form]");

  if (form) {
    const fields = {
      nome: form.elements.namedItem("nome") as HTMLInputElement,
      detalhes: form.elements.namedItem("detalhes") as HTMLTextAreaElement,
      prazo: form.elements.namedItem("prazo") as HTMLSelectElement,
      consentimento: form.elements.namedItem("consentimento") as HTMLInputElement,
    };

    let lastMessage = "";

    const setError = (name: "nome" | "consentimento", message = "") => {
      const field = fields[name];
      const target = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      field.setAttribute("aria-invalid", message ? "true" : "false");
      if (target) target.textContent = message;
    };

    const validate = () => {
      setError("nome");
      setError("consentimento");

      const errors: Array<{ field: "nome" | "consentimento"; message: string }> = [];
      const nome = fields.nome.value.trim();
      if (!nome) errors.push({ field: "nome", message: "Informe seu nome." });
      else if (nome.length < 2) errors.push({ field: "nome", message: "O nome deve ter pelo menos 2 caracteres." });
      if (!fields.consentimento.checked) errors.push({ field: "consentimento", message: "Confirme o consentimento antes de continuar." });

      errors.forEach(({ field, message }) => setError(field, message));
      const summary = form.querySelector<HTMLElement>("[data-error-summary]");
      if (summary) {
        summary.hidden = errors.length === 0;
        summary.textContent = errors.length ? `Revise ${errors.length === 1 ? "o campo indicado" : "os campos indicados"}.` : "";
      }
      if (errors.length) fields[errors[0].field].focus();
      return errors.length === 0;
    };

    fields.detalhes.addEventListener("input", () => {
      const count = document.getElementById("sauna-project-detalhes-count");
      if (count) count.textContent = `${fields.detalhes.value.length} / ${fields.detalhes.maxLength} caracteres`;
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!validate()) return;

      const context: SaunaProjectContext = {
        nome: fields.nome.value,
        detalhes: fields.detalhes.value,
        prazo: fields.prazo.value as SaunaProjectContext["prazo"],
      };

      lastMessage = composeSaunaProjectMessage(context);
      const fallback = document.querySelector<HTMLElement>("[data-whatsapp-fallback]");
      const composedMessage = fallback?.querySelector<HTMLTextAreaElement>("[data-composed-message]");
      if (composedMessage) composedMessage.value = lastMessage;
      if (fallback) fallback.hidden = false;

      window.dispatchEvent(new CustomEvent("site:whatsapp-handoff-initiated", {
        detail: {
          componentRef: "lp_sauna_whatsapp_form",
          subjectRef: "sauna",
          channelRef: "whatsapp",
        },
      }));

      const opened = window.open(buildSaunaWhatsAppUrl(context), "_blank", "noopener,noreferrer");
      if (!opened) fallback?.focus();
    });

    document.querySelector<HTMLButtonElement>("[data-copy-message]")?.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(lastMessage);
        if (status) status.textContent = "Mensagem copiada. Cole o conteúdo no WhatsApp para continuar.";
      } catch {
        if (status) status.textContent = "Não foi possível copiar automaticamente. Selecione a mensagem e copie antes de continuar.";
      }
    });
  }
</script>

<style>
  .sauna-whatsapp-form, .sauna-whatsapp-form__fallback { width: min(100%, var(--site-layout-reading-max)); margin-inline: auto; }
  .sauna-whatsapp-form > button { display: block; margin-inline: auto; }
  .sauna-whatsapp-form__field { margin-block-end: var(--site-space-6); }
  .sauna-whatsapp-form__field label { display: flex; align-items: baseline; justify-content: space-between; gap: var(--site-space-4); font-weight: var(--site-font-weight-ui-strong); }
  .sauna-whatsapp-form__field label span { color: var(--site-color-required-boundary); }
  .sauna-whatsapp-form__field label small { color: var(--site-color-text-secondary); font-weight: var(--site-font-weight-ui); }
  .sauna-whatsapp-form__field > p:not(.sauna-whatsapp-form__error) { margin: var(--site-space-2) 0 var(--site-space-3); color: var(--site-color-text-secondary); }
  .sauna-whatsapp-form input[type="text"], .sauna-whatsapp-form select, .sauna-whatsapp-form textarea, .sauna-whatsapp-form__fallback textarea { width: 100%; min-height: 3.25rem; border: 1px solid var(--site-color-divider); border-radius: 0; padding: .8rem 1rem; background: var(--site-color-surface); color: var(--site-color-text-primary); font: inherit; }
  .sauna-whatsapp-form textarea { min-height: 7rem; resize: vertical; }
  .sauna-whatsapp-form output { display: block; margin-block-start: var(--site-space-2); color: var(--site-color-text-secondary); font-size: .8rem; text-align: right; }
  .sauna-whatsapp-form__consent { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--site-space-3); margin-block: var(--site-space-7) var(--site-space-6); }
  .sauna-whatsapp-form__consent input { width: 1.35rem; height: 1.35rem; margin: .15rem 0 0; }
  .sauna-whatsapp-form__consent a { color: inherit; text-decoration: dotted underline; text-decoration-color: var(--site-color-accent-on-dark); text-decoration-thickness: 1px; text-underline-offset: .2em; transition: text-decoration-color 160ms ease; }
  .sauna-whatsapp-form__consent a:hover { text-decoration-color: var(--site-color-accent-on-dark); text-decoration-style: solid; }
  .sauna-whatsapp-form__consent a:focus-visible { outline: 3px solid var(--site-color-required-boundary); outline-offset: 3px; }
  .sauna-whatsapp-form__consent .sauna-whatsapp-form__error { grid-column: 2; }
  .sauna-whatsapp-form__error { min-height: 1.25rem; margin: var(--site-space-2) 0 0; color: var(--site-color-required-boundary); font-weight: var(--site-font-weight-ui-strong); }
  .sauna-whatsapp-form__summary { margin-block-end: var(--site-space-5); border-inline-start: 3px solid var(--site-color-required-boundary); padding: var(--site-space-4); background: var(--site-color-surface-muted); }
  .sauna-whatsapp-form__privacy { max-width: 42rem; margin: var(--site-space-4) 0 0; color: var(--site-color-text-secondary); font-size: .9rem; }
  .sauna-whatsapp-form__fallback { margin-block-start: var(--site-space-7); border-block-start: 3px solid var(--site-color-accent-on-dark); padding: var(--site-space-6); background: var(--site-color-surface-muted); }
  .sauna-whatsapp-form__fallback h3 { margin-block-start: 0; }
  .sauna-whatsapp-form__fallback textarea { display: block; margin-block: var(--site-space-4); resize: vertical; }
  .sauna-whatsapp-form__fallback button { min-height: 2.75rem; border: 1px solid currentColor; padding: .7rem 1rem; background: transparent; color: var(--site-color-text-primary); font: inherit; font-weight: var(--site-font-weight-ui-strong); }
  .sauna-whatsapp-form :is(input, select, textarea, button, a):focus-visible, .sauna-whatsapp-form__fallback :is(textarea, button):focus-visible { outline: 3px solid var(--site-color-required-boundary); outline-offset: 3px; }
  .sauna-whatsapp-form [aria-invalid="true"] { border: 2px solid var(--site-color-required-boundary); }
  @media (max-width: 30rem) {
    .sauna-whatsapp-form .site-primitive-action { width: 100%; }
    .sauna-whatsapp-form__fallback { padding: var(--site-space-5); }
  }
</style>
