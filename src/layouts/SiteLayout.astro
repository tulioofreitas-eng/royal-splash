---
import ConversionOrigin from "../components/runtime/ConversionOrigin.astro";
import MainContent from "../components/runtime/MainContent.astro";
import SemanticAnalytics from "../components/runtime/SemanticAnalytics.astro";
import SkipLink from "../components/runtime/SkipLink.astro";
import { getCurrentSeoRobots } from "../seo/runtime.ts";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  robots?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  lang = "pt-BR",
  robots,
  bodyClass,
} = Astro.props;

const effectiveRobots =
  getCurrentSeoRobots(robots);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {effectiveRobots && <meta name="robots" content={effectiveRobots} />}
    <slot name="head" />
  </head>
  <body class={bodyClass} data-template-family="site">
    <slot name="body-start" />
    <SkipLink />
    <slot name="header" />
    <MainContent>
      <slot />
    </MainContent>
    <slot name="footer" />
    <ConversionOrigin />
    <SemanticAnalytics />
    <slot name="body-end" />
  </body>
</html>
