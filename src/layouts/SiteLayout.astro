---
import ConversionOrigin from "../components/runtime/ConversionOrigin.astro";
import GrowthAttribution from "../components/runtime/GrowthAttribution.astro";
import MainContent from "../components/runtime/MainContent.astro";
import SemanticAnalytics from "../components/runtime/SemanticAnalytics.astro";
import SkipLink from "../components/runtime/SkipLink.astro";
import WhatsAppClickAnalytics from "../components/runtime/WhatsAppClickAnalytics.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import PersistentWhatsApp from "../components/site/PersistentWhatsApp.astro";
import { getCurrentSeoRobots } from "../seo/runtime.ts";
import "../styles/site-system.css";

type SiteVisualMode = "functional" | "brand";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  robots?: string;
  bodyClass?: string;
  visualMode?: SiteVisualMode;
}

const {
  title,
  description,
  lang = "pt-BR",
  robots,
  bodyClass,
  visualMode = "functional",
} = Astro.props;

const effectiveRobots =
  getCurrentSeoRobots(robots);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {effectiveRobots && <meta name="robots" content={effectiveRobots} />}
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-template-family="site"
    data-site-visual={visualMode}
  >
    <slot name="body-start" />
    <SkipLink />
    <slot name="header" />
    <MainContent>
      <slot />
    </MainContent>
    <slot name="footer">
      <SiteFooter />
    </slot>
    <aside aria-label="Contato rápido por WhatsApp">
      <PersistentWhatsApp />
    </aside>
    <ConversionOrigin />
    <GrowthAttribution />
    <SemanticAnalytics />
    <WhatsAppClickAnalytics />
    <slot name="body-end" />
  </body>
</html>
