---
import GrowthAttribution from "../components/runtime/GrowthAttribution.astro";
import MainContent from "../components/runtime/MainContent.astro";
import SkipLink from "../components/runtime/SkipLink.astro";
import WhatsAppClickAnalytics from "../components/runtime/WhatsAppClickAnalytics.astro";
import { getCurrentSeoRobots } from "../seo/runtime.ts";
import { getRoyalCanonicalUrl, getRoyalRouteRobots } from "../seo/royal-policy.ts";
import "../styles/site-system.css";
import "../styles/lp-mobile-convergence.css";

type LandingVisualMode = "functional" | "brand";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  robots?: string;
  bodyClass?: string;
  visualMode?: LandingVisualMode;
}

const {
  title,
  description,
  lang = "pt-BR",
  bodyClass,
  visualMode = "functional",
} = Astro.props;

// The reviewed RC01 route policy supersedes historical per-page robots props.
const effectiveRobots = getCurrentSeoRobots(getRoyalRouteRobots(Astro.url.pathname));
const canonicalUrl = getRoyalCanonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {effectiveRobots && <meta name="robots" content={effectiveRobots} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-template-family="landing"
    data-site-visual={visualMode}
  >
    <slot name="body-start" />
    <SkipLink />
    <slot name="header" />
    <MainContent>
      <slot />
    </MainContent>
    <slot name="footer" />
    <GrowthAttribution />
    <WhatsAppClickAnalytics />
    <slot name="body-end" />
  </body>
</html>
